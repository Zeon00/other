--============================================================
-- AUTO HALLOW
--============================================================

local function hallowAlive(id)
    return Running and AutoHallow and HallowRunId == id
end

local function hallowWaitPosition1(id)
    HallowStatus = "HALLOW | Menunggu posisi 1..."

    while hallowAlive(id) do
        updateCharacter()

        if Root
            and (Root.Position - HALLOW_POS1).Magnitude <= HALLOW_POS1_TOLERANCE then
            return true
        end

        task.wait(0.2)
    end

    return false
end

local function hallowWaitMobs(id, label)
    HallowStatus = "HALLOW | Menunggu " .. label .. " muncul..."

    while hallowAlive(id) do
        if getEnemyCount() > 0 then
            return true
        end

        task.wait(0.2)
    end

    return false
end

local function hallowWaitClear(id, label)
    if not hallowWaitMobs(id, label) then
        return false
    end

    HallowStatus = "HALLOW | Melawan " .. label .. "..."

    while hallowAlive(id) do
        if getEnemyCount() == 0 then
            local start = os.clock()
            local empty = true

            while hallowAlive(id)
                and os.clock() - start < MOB_EMPTY_CONFIRM_TIME do

                if getEnemyCount() > 0 then
                    empty = false
                    break
                end

                task.wait(0.1)
            end

            if empty and getEnemyCount() == 0 then
                return true
            end
        end

        task.wait(0.1)
    end

    return false
end

local function stopHallow()
    AutoHallow = false
    HallowRunId += 1
    HallowStatus = "Hallow: OFF"
end

local function startHallow()
    if not Running or AutoHallow then return end

    if AutoDungeon or AutoEclipse or AutoTower then
        HallowStatus = "Matikan mode dungeon lain dahulu!"
        return
    end

    AutoHallow = true
    HallowRunId += 1

    local id = HallowRunId

    task.spawn(function()
        local function alive()
            return hallowAlive(id)
        end

        local function status(message)
            HallowStatus = "HALLOW | " .. message
        end

        while alive() do
            if not hallowWaitPosition1(id) then break end
            if not alive() then break end

            status("TP posisi 2...")

            if not teleportPosition(HALLOW_POS2) then
                status("TP posisi 2 gagal")
                break
            end

            status("Menunggu 3 detik...")
            task.wait(HALLOW_BEFORE_REMOTE)

            if not alive() then break end

            updateCharacter()

            if not Root
                or (Root.Position - HALLOW_POS2).Magnitude > HALLOW_POS2_TOLERANCE then
                status("Posisi 2 tidak valid")
                continue
            end

            status("EnterDungeon...")

            local ok, result = pcall(function()
                return RequestRemote:InvokeServer("EnterDungeon", "HALLOW", 3)
            end)

            if not ok then
                status("Remote error: " .. tostring(result))
                task.wait(2)
                continue
            end

            if not alive() then break end

            if not AutoSkill then startSkill() end
            if not AutoOrbit then startOrbit() end
            if not AutoCombat then startCombat() end

            if not waitForProgressComplete(alive, status) then
                break
            end

            if not alive() then break end

            status("Menunggu semua musuh habis...")

            local emptySince = nil

            while alive() do
                if getEnemyCount() == 0 then
                    emptySince = emptySince or os.clock()

                    if os.clock() - emptySince >= 2 then
                        break
                    end
                else
                    emptySince = nil
                end

                task.wait(0.1)
            end

            if not alive() then break end

            status("Semua musuh habis! TP posisi 3...")

            if not teleportPosition(HALLOW_POS3) then
                status("TP posisi 3 gagal!")
                break
            end

            status("Berhasil TP posisi 3!")

            if not alive() then break end

            status("Wave selesai, tunggu...")
            task.wait(HALLOW_BEFORE_FLOOR)

            if not alive() then break end

            local glow = getDungeonObject("HALLOW", {
                "BossDoor",
                "FloorGlow"
            })

            if not glow then
                status("FloorGlow tidak ditemukan")
                break
            end

            status("TP FloorGlow...")

            if not teleportObject(glow) then
                status("TP FloorGlow gagal")
                break
            end

            status("Menunggu boss...")
            task.wait(HALLOW_AFTER_FLOOR)

            if not alive() then break end

            if not hallowWaitClear(id, "BOSS") then
                break
            end

            if not alive() then break end

            status("Boss habis, tunggu...")
            task.wait(HALLOW_BEFORE_EXIT)

            if not alive() then break end

            if getEnemyCount() > 0 then
                status("Musuh muncul lagi...")

                if not hallowWaitClear(id, "BOSS") then
                    break
                end

                if not alive() then break end
                task.wait(HALLOW_BEFORE_EXIT)
            end

            local exit = getDungeonObject("HALLOW", {
                "Markers",
                "BossExit"
            })

            if not exit then
                status("BossExit tidak ditemukan")
                break
            end

            status("TP BossExit...")

            if not teleportObject(exit) then
                status("TP BossExit gagal")
                break
            end

            if not alive() then break end

            if AutoOrbit then stopOrbit() end
            if AutoSkill then stopSkill() end
            if AutoCombat then stopCombat() end

            status("BossExit | Orbit OFF | Skill OFF")
            task.wait(1)

            if not alive() then break end

            status("Kembali ke posisi 1...")

            if not teleportPosition(HALLOW_POS1) then
                status("Gagal kembali posisi 1")
                break
            end

            task.wait(1)
            status("Siklus selesai, mengulang...")
            task.wait(0.5)
        end

        if HallowRunId == id then
            if AutoOrbit then stopOrbit() end
            if AutoSkill then stopSkill() end
            if AutoCombat then stopCombat() end

            AutoHallow = false
            HallowStatus = "Hallow: OFF"
        end
    end)
end

--============================================================
-- AUTO TOWER / RIFT
--============================================================

local function towerAlive(id)
    return Running and AutoTower and TowerRunId == id
end

local function stopTower()
    AutoTower = false
    TowerRunId += 1
    TowerStatus = "Tower: OFF"
end

local function startTower()
    if not Running or AutoTower then return end

    if AutoDungeon or AutoHallow or AutoEclipse then
        TowerStatus = "Matikan mode dungeon lain dahulu!"
        return
    end

    AutoTower = true
    TowerRunId += 1

    local id = TowerRunId

    task.spawn(function()
        local function alive()
            return towerAlive(id)
        end

        while alive() do
            TowerStatus = "Menunggu posisi 1..."

            while alive() do
                updateCharacter()

                if Root
                    and (Root.Position - TOWER_POS1).Magnitude <= TOWER_TOLERANCE then
                    break
                end

                task.wait(0.2)
            end

            if not alive() then break end

            TowerStatus = "Posisi 1 | Mematikan Skill + Orbit"

            if AutoSkill then stopSkill() end
            if AutoOrbit then stopOrbit() end

            TowerStatus = "Posisi 1 | Tunggu 2 detik..."
            task.wait(TOWER_WAIT)

            if not alive() then break end

            TowerStatus = "Teleport posisi 2..."

            if not teleportPosition(TOWER_POS2) then
                TowerStatus = "TP posisi 2 gagal!"
                task.wait(1)
                continue
            end

            TowerStatus = "Posisi 2 | Tunggu 2 detik..."
            task.wait(TOWER_WAIT)

            if not alive() then break end

            TowerStatus = "Mengaktifkan Skill + Orbit..."

            if not AutoSkill then startSkill() end
            if not AutoOrbit then startOrbit() end

            task.wait(0.2)

            if not alive() then break end

            TowerStatus = "Mengirim EnterDungeon RIFT 71..."

            local ok, result = pcall(function()
                return RequestRemote:InvokeServer(
                    "EnterDungeon",
                    "RIFT",
                    71
                )
            end)

            if not alive() then break end

            if ok then
                TowerStatus = "RIFT 71 | Remote terkirim: " .. tostring(result)
            else
                TowerStatus = "RIFT 71 | Remote error: " .. tostring(result)
            end

            TowerStatus = "Menunggu kembali ke posisi 1..."

            while alive() do
                updateCharacter()

                if Root
                    and (Root.Position - TOWER_POS1).Magnitude <= TOWER_TOLERANCE then
                    break
                end

                task.wait(0.5)
            end

            if alive() then
                task.wait(1)
            end
        end

        if TowerRunId == id then
            AutoTower = false
            TowerStatus = "Tower: OFF"
        end
    end)
end

--============================================================
-- AUTO CLAIM ALL REWARDS
--============================================================

local function stopClaim()
    AutoClaim = false
    ClaimRunId += 1
    ClaimStatus = "Claim: OFF"
end

local function startClaim()
    if not Running or AutoClaim then return end

    AutoClaim = true
    ClaimRunId += 1

    local id = ClaimRunId

    task.spawn(function()
        while Running and AutoClaim and ClaimRunId == id do
            ClaimStatus = "Claiming all rewards..."

            local ok, result = pcall(function()
                return RequestRemote:InvokeServer("ClaimAllRewards")
            end)

            if ok then
                ClaimStatus = "All rewards claimed | Berikutnya 5 menit"
            else
                ClaimStatus = "Claim error: " .. tostring(result)
            end

            local remaining = CLAIM_INTERVAL

            while Running
                and AutoClaim
                and ClaimRunId == id
                and remaining > 0 do

                task.wait(1)
                remaining -= 1
            end
        end
    end)
end

