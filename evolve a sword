--============================================================
-- KEY MANAGEMENT
--============================================================

local function sendKey(key, pressed)
    pcall(function()
        VirtualInputManager:SendKeyEvent(pressed, key, false, game)
    end)
end

local function releaseKey(key)
    if HeldKeys[key] then
        HeldKeys[key] = nil
        sendKey(key, false)
    end
end

local function pressKey(key)
    if not Running or not AutoSkill then return end

    if not HeldKeys[key] then
        HeldKeys[key] = true
        sendKey(key, true)
    end
end

local function releaseSkills()
    for _, key in ipairs(SKILLS) do
        releaseKey(key)
    end
end

local function releaseAllKeys()
    for key in pairs(HeldKeys) do
        releaseKey(key)
    end

    for _, key in ipairs(SKILLS) do
        sendKey(key, false)
    end
end

