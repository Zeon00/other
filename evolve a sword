local function dungeonAlive(id)
    return Running and AutoDungeon and DungeonRunId == id
end

local function waitDungeonStart(id)
    DungeonStatus = "Menunggu posisi 1..."

    while dungeonAlive(id) do
        updateCharacter()

        if Root
            and (Root.Position - DUNGEON_START).Magnitude <= DUNGEON_TOLERANCE then
            return true
        end

        task.wait(DUNGEON_WAIT_DELAY)
    end

    return false
end

local function walkDungeonEntry(id)
    DungeonStatus = SelectedDungeon .. " | Jalan kaki ke posisi 2..."

    local lastOrder = 0

    while dungeonAlive(id) do
        updateCharacter()

        if not Root or not Humanoid or Humanoid.Health <= 0 then
            return false
        end

        if (Root.Position - DUNGEON_ENTRY).Magnitude <= ENTRY_TOLERANCE then
            Humanoid:MoveTo(Root.Position)
            return true
        end

        if os.clock() - lastOrder >= 3 then
            Humanoid:MoveTo(DUNGEON_ENTRY)
            lastOrder = os.clock()
        end

        task.wait(0.1)
    end

    return false
end

local function stopDungeon()
    AutoDungeon = false
    DungeonRunId += 1
    DungeonStatus = "Dungeon: OFF"
end

local function startDungeon()
    if not Running or AutoDungeon then return end

if AutoHallow or EclipsePriority or AutoTower then
    DungeonStatus = "Eclipse sedang prioritas / mode lain aktif!"
    return
end

    local name = DungeonNameInput and DungeonNameInput.Text or "S1"
    name = string.upper(string.match(name, "^%s*(.-)%s*$") or "")

    if name == "" then
        DungeonStatus = "Isi nama dungeon!"
        return
    end

    SelectedDungeon = name
    AutoDungeon = true
    DungeonRunId += 1

    local id = DungeonRunId
    local combatWasOn = AutoCombat

    task.spawn(function()
        local function alive()
            return dungeonAlive(id)
        end

        local function status(message)
            DungeonStatus = name .. " | " .. message
        end

        local function restoreAfterExit()
            if not combatWasOn and AutoCombat then
                stopCombat()
            end

            if AutoOrbit then stopOrbit() end
            if AutoSkill then stopSkill() end
        end

        while alive() do
            if not waitDungeonStart(id) then break end

            if not walkDungeonEntry(id) then
                if not alive() then break end
                continue
            end

            updateCharacter()

            if not Root
                or (Root.Position - DUNGEON_ENTRY).Magnitude > ENTRY_TOLERANCE then
                continue
            end

            status("Posisi 2 tercapai, tunggu 2 detik...")
            task.wait(DUNGEON_BEFORE_REMOTE)

            if not alive() then break end

            updateCharacter()

            if not Root
                or (Root.Position - DUNGEON_ENTRY).Magnitude > ENTRY_TOLERANCE then
                status("Posisi 2 berubah, ulangi...")
                continue
            end

            status("EnterDungeon...")

            local ok, result = pcall(function()
                local count = math.max(
                    1,
                    math.floor(tonumber(DungeonCountInput.Text) or 3)
                )

                return RequestRemote:InvokeServer("EnterDungeon", name, count)
            end)

            if not alive() then break end

            if not ok or result ~= true then
                status("EnterDungeon gagal: " .. tostring(result))
                task.wait(2)
                continue
            end

            status("Masuk dungeon! Menunggu progress selesai...")

            if not AutoOrbit then startOrbit() end
            if not AutoSkill then startSkill() end
            if not AutoCombat then startCombat() end

            if not waitForProgressComplete(alive, status, true) then
                break
            end

            if not alive() then break end

            status("Progress selesai! Mencari FloorGlow...")

            local glow = getDungeonObject(name, {
                "BossDoor",
                "FloorGlow"
            })

            if not glow then
                status("FloorGlow tidak ditemukan!")
                break
            end

            if not teleportObject(glow) then
                status("Teleport FloorGlow gagal!")
                break
            end

            status("Teleport FloorGlow berhasil!")
            task.wait(DUNGEON_AFTER_FLOOR)

            if not alive() then break end

            if not waitForEnemyClear(alive, status) then
                break
            end

            if not alive() then break end

            status("Boss habis, tunggu 2 detik...")
            task.wait(DUNGEON_BEFORE_EXIT)

            if not alive() then break end

            if getEnemyCount() > 0 then
                status("Mob muncul lagi, melawan...")

                if not waitForEnemyClear(alive, status) then
                    break
                end

                if not alive() then break end
                task.wait(DUNGEON_BEFORE_EXIT)
            end

            local exit = getDungeonObject(name, {
                "Markers",
                "BossExit"
            })

            if not exit then
                status("BossExit tidak ditemukan!")
                break
            end

            status("Teleport BossExit...")

            if not teleportObject(exit) then
                status("TP BossExit gagal!")
                break
            end

            restoreAfterExit()

            status("Dungeon selesai!")
            task.wait(1)
        end

        if DungeonRunId == id then
            if not combatWasOn and AutoCombat then
                stopCombat()
            end

            if AutoOrbit then stopOrbit() end
            if AutoSkill then stopSkill() end

            AutoDungeon = false
            DungeonStatus = "Dungeon: OFF"
        end
    end)
end

--============================================================
-- AUTO ECLIPSE | DIRECT TP UMBRA
-- TP UMBRA -> ORBIT + SKILL -> LEAVE -> REPEAT
--============================================================

local function eclipseAlive(id)
    return Running and AutoEclipse and EclipseRunId == id
end

local function getCurrentEclipse()
    local attribute = Workspace:GetAttribute("EclipseDungeon")

    if not attribute then
        return nil, nil
    end

    local success, config = pcall(function()
        return DungeonConfig.get(attribute)
    end)

    if not success or not config or not config.Id then
        return nil, attribute
    end

    return config, attribute
end

local function findUmbra()
    local enemies = Workspace:FindFirstChild("Enemies")

    if not enemies then
        return nil
    end

    for _, mob in ipairs(enemies:GetChildren()) do
        if mob:IsA("Model")
            and mob.Name == "Umbra the Sun-Eater"
            and not isDead(mob) then

            return mob
        end
    end

    return nil
end

local function teleportToUmbra(mob)
    if not mob or not mob.Parent or isDead(mob) then
        return false
    end

    updateCharacter()

    if not Root then
        return false
    end

    local mobRoot = getMobRoot(mob)

    if not mobRoot then
        return false
    end

    return pcall(function()
        local destination = mobRoot.CFrame * CFrame.new(0, 0, 5)

        Root.CFrame = CFrame.lookAt(
            destination.Position,
            mobRoot.Position
        )
    end)
end

local function leaveEclipseDungeon()
    local enemies = Workspace:FindFirstChild("Enemies")

    -- Pastikan folder Enemies tersedia
    if not enemies then
        return false
    end

    -- Pastikan Umbra benar-benar sudah hilang
    if enemies:FindFirstChild("Umbra the Sun-Eater") then
        return false
    end

    local event = ReplicatedStorage
        :WaitForChild("SwordShared")
        :WaitForChild("Remotes")
        :WaitForChild("Request")

    local success, result = pcall(function()
        return event:InvokeServer("LeaveDungeon")
    end)

    return success, result
end

local function stopEclipse()
    AutoEclipse = false
    EclipseRunId += 1

    EclipseTarget = nil

    if AutoOrbit then
        stopOrbit()
    end

    if AutoSkill then
        stopSkill()
    end

    EclipseStatus = "Eclipse: OFF"
end

local function startEclipse()
    if not Running or AutoEclipse then
        return
    end

    if AutoHallow or AutoTower then
        EclipseStatus = "Matikan Hallow / Tower dahulu!"
        return
    end

    AutoEclipse = true
    EclipseRunId += 1

    local id = EclipseRunId

    task.spawn(function()
        local function alive()
            return eclipseAlive(id)
        end

        local function status(message)
            EclipseStatus = "ECLIPSE | " .. message
        end

        local function waitDungeonEntry()
            status("Menunggu masuk dungeon...")

            while alive() do
                if Player:GetAttribute("Dungeon") then
                    return true
                end

                task.wait(0.2)
            end

            return false
        end

        local function waitDungeonExit()
            status("Menunggu keluar dungeon...")

            while alive() do
                if not Player:GetAttribute("Dungeon") then
                    return true
                end

                task.wait(0.25)
            end

            return false
        end

        local function waitUmbra()
            status("Menunggu Umbra the Sun-Eater...")

            while alive() do
                if not Player:GetAttribute("Dungeon") then
                    return nil
                end

                local mob = findUmbra()

                if mob then
                    return mob
                end

                task.wait(0.2)
            end

            return nil
        end

    while alive() do
    local config, attribute = getCurrentEclipse()

    --====================================================
    -- ECLIPSE PRIORITY: POTONG DUNGEON YANG SEDANG JALAN
    --====================================================

    if Player:GetAttribute("Dungeon") then

        if config then
            status("ECLIPSE TERSEDIA! Menghentikan dungeon...")

            -- Simpan status agar Auto Dungeon bisa dilanjutkan
            ResumeDungeonAfterEclipse = AutoDungeon
            EclipsePriority = true

            -- Hentikan worker Auto Dungeon
            if AutoDungeon then
                stopDungeon()
            end

            -- Leave dungeon menggunakan remote
            status("Memanggil LeaveDungeon untuk prioritas Eclipse...")

            local leaveOK, leaveResult = pcall(function()
                return RequestRemote:InvokeServer("LeaveDungeon")
            end)

            if not leaveOK then
                status("Leave dungeon error: " .. tostring(leaveResult))

                EclipsePriority = false

                if ResumeDungeonAfterEclipse and alive() then
                    ResumeDungeonAfterEclipse = false
                    task.wait(1)
                    startDungeon()
                end

                task.wait(3)
                continue
            end

            -- Tunggu sampai benar-benar keluar
            local leaveDeadline = os.clock() + 20

            while alive()
                and Player:GetAttribute("Dungeon")
                and os.clock() < leaveDeadline do

                task.wait(0.2)
            end

            if not alive() then break end

            if Player:GetAttribute("Dungeon") then
                status("Leave belum berhasil! Mencoba lagi...")

                EclipsePriority = false

                if ResumeDungeonAfterEclipse then
                    ResumeDungeonAfterEclipse = false
                    task.wait(1)
                    startDungeon()
                end

                task.wait(3)
                continue
            end

            status("Berhasil keluar! OTW Eclipse...")

        else
            status("Masih di dungeon, menunggu Eclipse...")
            task.wait(0.5)
            continue
        end
    end

    if not config then
        status("Menunggu EclipseDungeon...")
        task.wait(1)
        continue
    end

    --====================================================
    -- LANJUT MASUK ECLIPSE
    --====================================================

    status("Eclipse ditemukan: " .. tostring(attribute))
    task.wait(0.5)

    if not alive() then
        break
    end

    if Player:GetAttribute("Dungeon") then
        continue
    end

            local config, attribute = getCurrentEclipse()

            if not config then
                status("Menunggu EclipseDungeon...")
                task.wait(1)
                continue
            end

            status("Eclipse ditemukan: " .. tostring(attribute))
            task.wait(1)

            if not alive() then
                break
            end

            if Player:GetAttribute("Dungeon") then
                continue
            end

            status("Memanggil EclipseEnter...")

            local ok, result = pcall(function()
                return PlayerState.request("EclipseEnter", config.Id)
            end)

            if not alive() then
                break
            end

            if not ok then
                status("Enter error: " .. tostring(result))
                task.wait(3)
                continue
            end

            status("Request terkirim: " .. tostring(result))

            if not waitDungeonEntry() then
                break
            end

            if not alive() then
                break
            end

            status("Berhasil masuk! Mencari Umbra...")

            local umbra = waitUmbra()

            if not alive() then
                break
            end

            if not umbra then
                status("Umbra tidak ditemukan / dungeon berakhir.")
                waitDungeonExit()
                task.wait(1)
                continue
            end

            -- KUNCI TARGET ORBIT KE UMBRA
            EclipseTarget = umbra
            CurrentDungeonTarget = umbra

            status("Umbra ditemukan! TP langsung...")

            if not teleportToUmbra(umbra) then
                status("TP Umbra gagal, mencoba ulang...")

                for _ = 1, 10 do
                    if not alive() or isDead(umbra) then
                        break
                    end

                    if teleportToUmbra(umbra) then
                        break
                    end

                    task.wait(0.3)
                end
            end

            if not alive() then
                break
            end

            -- ORBIT AKTIF KHUSUS KE UMBRA
            status("Mengaktifkan Orbit + Skill...")

            if AutoOrbit then
                stopOrbit()
            end

            startOrbit()

            if not AutoSkill then
                startSkill()
            end

            -- TUNGGU UMBRA MATI / HILANG
            status("Orbit + Skill sampai Umbra mati...")

            while alive()
                and umbra.Parent
