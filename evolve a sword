-- AUTO CLAIM ALL REWARDS
--============================================================

local function stopClaim()
    AutoClaim = false
    ClaimRunId += 1
    ClaimStatus = "Claim: OFF"
end

local function startClaim()
    if not Running or AutoClaim then return end

    AutoClaim = true
    ClaimRunId += 1

    local id = ClaimRunId

    task.spawn(function()
        while Running and AutoClaim and ClaimRunId == id do
            ClaimStatus = "Claiming rewards..."

            local ok, result = pcall(function()
                return RequestRemote:InvokeServer("ClaimAllRewards")
            end)

            if ok then
                ClaimStatus = "Claim berhasil | Berikutnya 5 menit"
            else
                ClaimStatus = "Claim error: " .. tostring(result)
            end

            -- 300 detik, tetapi tetap bisa OFF kapan saja.
            local remaining = CLAIM_INTERVAL

            while Running
                and AutoClaim
                and ClaimRunId == id
                and remaining > 0 do

                task.wait(1)
                remaining -= 1
            end

            if AutoClaim and ClaimRunId == id then
                ClaimStatus = "Claim berikutnya..."
            end
        end
    end)
end

