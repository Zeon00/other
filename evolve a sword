--============================================================
-- AUTO TOWER / RIFT
--============================================================

local function towerAlive(id)
    return Running and AutoTower and TowerRunId == id
end

local function stopTower()
    AutoTower = false
    TowerRunId += 1
    TowerStatus = "Tower: OFF"
end

local function startTower()
    if not Running or AutoTower then return end

    if AutoDungeon or AutoHallow then
        TowerStatus = "Matikan Auto Dungeon / Hallow dahulu!"
        return
    end

    AutoTower = true
    TowerRunId += 1

    local id = TowerRunId

    task.spawn(function()
        local function alive()
            return towerAlive(id)
        end

        while alive() do
            TowerStatus = "Menunggu posisi 1..."

            -- Tunggu player mendekati posisi 1
            while alive() do
                updateCharacter()

                if Root
                    and (Root.Position - TOWER_POS1).Magnitude <= TOWER_TOLERANCE then
                    break
                end

                task.wait(0.2)
            end

            if not alive() then break end

            -- Matikan Skill dan Orbit
            TowerStatus = "Posisi 1 | Mematikan Skill + Orbit"

            if AutoSkill then
                stopSkill()
            end

            if AutoOrbit then
                stopOrbit()
            end

            -- Tunggu 2 detik
            TowerStatus = "Posisi 1 | Tunggu 2 detik..."
            task.wait(TOWER_WAIT)

            if not alive() then break end

            -- TP posisi 2
            TowerStatus = "Teleport posisi 2..."

            if not teleportPosition(TOWER_POS2) then
                TowerStatus = "TP posisi 2 gagal!"
                task.wait(1)
                continue
            end

            -- Tunggu 2 detik
            TowerStatus = "Posisi 2 | Tunggu 2 detik..."
            task.wait(TOWER_WAIT)

            if not alive() then break end

            -- Aktifkan Skill + Orbit sebelum remote
            TowerStatus = "Mengaktifkan Skill + Orbit..."

            if not AutoSkill then
                startSkill()
            end

            if not AutoOrbit then
                startOrbit()
            end

            task.wait(0.2)

            if not alive() then break end

            -- Kirim remote RIFT 71
            TowerStatus = "Mengirim EnterDungeon RIFT 71..."

            local ok, result = pcall(function()
                return RequestRemote:InvokeServer(
                    "EnterDungeon",
                    "RIFT",
                    71
                )
            end)

            if not alive() then break end

            if ok then
                TowerStatus = "RIFT 71 | Remote terkirim: " .. tostring(result)
            else
                TowerStatus = "RIFT 71 | Remote error: " .. tostring(result)
            end

            -- Tunggu sampai player kembali ke posisi 1
            TowerStatus = "Menunggu kembali ke posisi 1..."

            while alive() do
                updateCharacter()

                if Root
                    and (Root.Position - TOWER_POS1).Magnitude <= TOWER_TOLERANCE then
                    break
                end

                task.wait(0.5)
            end

            if alive() then
                task.wait(1)
            end
        end

        if TowerRunId == id then
            AutoTower = false
            TowerStatus = "Tower: OFF"
        end
    end)
end
