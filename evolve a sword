-- KEY MANAGEMENT
--============================================================

local function sendKey(key, pressed)
    pcall(function()
        VirtualInputManager:SendKeyEvent(pressed, key, false, game)
    end)
end

local function releaseKey(key)
    if HeldKeys[key] then
        HeldKeys[key] = nil
        sendKey(key, false)
    end
end

local function pressKey(key)
    if not Running or not AutoSkill then return end

    if not HeldKeys[key] then
        HeldKeys[key] = true
        sendKey(key, true)
    end
end

local function releaseSkills()
    for _, key in ipairs(SKILLS) do
        releaseKey(key)
    end
end

local function releaseAllKeys()
    for key in pairs(HeldKeys) do
        releaseKey(key)
    end

    for _, key in ipairs(SKILLS) do
        sendKey(key, false)
    end
end

--============================================================
-- MOB HELPERS
--============================================================

local function getMobRoot(mob)
    if not mob or not mob:IsA("Model") then
        return nil
    end

    return mob:FindFirstChild("HumanoidRootPart")
        or mob.PrimaryPart
        or mob:FindFirstChild("RootPart")
end

local function getHealth(mob)
    local hum = mob:FindFirstChildOfClass("Humanoid")

    if hum then
        return hum.Health
    end

    local health = mob:FindFirstChild("Health")

    if health and health:IsA("NumberValue") then
        return health.Value
    end

    local attr = mob:GetAttribute("Health")

    if typeof(attr) == "number" then
        return attr
    end

    return nil
end

local function isDead(mob)
    if not mob or not mob.Parent then return true end
    if mob:GetAttribute("Dead") == true then return true end

    local dead = mob:FindFirstChild("Dead")

    if dead and dead:IsA("BoolValue") and dead.Value then
        return true
    end

    local hp = getHealth(mob)

    return hp ~= nil and hp <= 0
end

local function validOwner(mob)
    local owner = mob:GetAttribute("Owner")

    if owner == nil then
        local obj = mob:FindFirstChild("Owner")

        if obj and obj:IsA("ValueBase") then
            owner = obj.Value
        end
    end

    if owner == nil or owner == "" or owner == 0 then
        return true
    end

    return owner == Player.UserId or owner == Player.Name
end

local function getAllMobs()
    local folder = Workspace:FindFirstChild("Enemies")
    local result = {}

    if not folder then return result end

    for _, mob in ipairs(folder:GetChildren()) do
        if mob:IsA("Model")
            and not isDead(mob)
            and validOwner(mob)
            and getMobRoot(mob) then

            table.insert(result, mob)
        end
    end

    return result
end

local function getEnemyCount()
    local folder = Workspace:FindFirstChild("Enemies")

    if not folder then return 0 end

    local count = 0

    for _, mob in ipairs(folder:GetChildren()) do
        if mob:IsA("Model") and not isDead(mob) then
            count += 1
        end
    end

    return count
end

--============================================================
-- AUTO TARGET
--============================================================

local function getTarget()
    updateCharacter()

    if not Root then return nil end

    local folder = Workspace:FindFirstChild("Enemies")

    if not folder then return nil end

    local bestMob
    local bestDistance = math.huge
    local look = Root.CFrame.LookVector

    for _, mob in ipairs(folder:GetChildren()) do
        if mob:IsA("Model") and not isDead(mob) and validOwner(mob) then
            local mobRoot = getMobRoot(mob)

            if mobRoot then
                local offset = mobRoot.Position - Root.Position
                local distance = offset.Magnitude
                local height = math.abs(offset.Y)

                if distance > 0
                    and distance <= SCAN_RANGE
                    and height <= MAX_HEIGHT then

                    local dot = look:Dot(offset.Unit)

                    if dot >= FRONT_DOT and distance < bestDistance then
                        bestDistance = distance
                        bestMob = mob
                    end
                end
            end
        end
    end

    return bestMob
end

