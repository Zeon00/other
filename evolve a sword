    task.spawn(function()
        while Running and AutoClaim and ClaimRunId == id do
            ClaimStatus = "Claiming all rewards..."

            local ok, result = pcall(function()
                return RequestRemote:InvokeServer("ClaimAllRewards")
            end)

            if ok then
                ClaimStatus = "All rewards claimed | Berikutnya 5 menit"
            else
