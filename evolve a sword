end

local function startHover()
    updateCharacter()

    if not Root or not Humanoid or HoverVelocity then
        return
    end

    HoverAttachment = Instance.new("Attachment")
    HoverAttachment.Name = "AF_HoverAttachment"
    HoverAttachment.Parent = Root

    HoverVelocity = Instance.new("LinearVelocity")
    HoverVelocity.Name = "AF_HoverVelocity"
    HoverVelocity.Attachment0 = HoverAttachment
    HoverVelocity.RelativeTo = Enum.ActuatorRelativeTo.World
    HoverVelocity.VelocityConstraintMode = Enum.VelocityConstraintMode.Vector
    HoverVelocity.ForceLimitsEnabled = true
    HoverVelocity.ForceLimitMode = Enum.ForceLimitMode.PerAxis
    HoverVelocity.MaxAxesForce = Vector3.new(0, HOVER_FORCE, 0)
    HoverVelocity.VectorVelocity = Vector3.zero
    HoverVelocity.Parent = Root

    HoverConnection = RunService.Heartbeat:Connect(function()
        if not Running or not AutoOrbit then return end

        if Root and Root.Parent and HoverVelocity and HoverVelocity.Parent then
            HoverVelocity.VectorVelocity = Vector3.zero
        end
    end)
end

local function stopHover()
