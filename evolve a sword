--============================================================
-- ORBIT
--============================================================

local function orbitMob(mob, runId)
    updateCharacter()

    if not Root or not Humanoid or not mob or isDead(mob) then
        return
    end

    local mobRoot = getMobRoot(mob)
    if not mobRoot then return end

    local angle = 0
    local lastTime = os.clock()

    while Running
        and AutoOrbit
        and OrbitRunId == runId
        and mob.Parent
        and not isDead(mob) do

        updateCharacter()

        if not Root or not Humanoid or Humanoid.Health <= 0 then
            break
        end

        mobRoot = getMobRoot(mob)
        if not mobRoot then break end

        local now = os.clock()
        local dt = math.clamp(now - lastTime, 0, 0.1)
        lastTime = now

        angle += ORBIT_SPEED * dt

        local center = mobRoot.Position

        local offset = Vector3.new(
            math.cos(angle) * ORBIT_RADIUS,
            ORBIT_HEIGHT,
            math.sin(angle) * ORBIT_RADIUS
        )

        local destination = center + offset
        local targetCF = CFrame.lookAt(destination, center)
        local alpha = 1 - math.exp(-ORBIT_SMOOTHNESS * dt)

        pcall(function()
            Root.CFrame = Root.CFrame:Lerp(targetCF, alpha)
        end)

        RunService.Heartbeat:Wait()
    end
end

local function startOrbit()
    if not Running or AutoOrbit then return end

    AutoOrbit = true
    OrbitRunId += 1

    local id = OrbitRunId

    startHover()

    task.spawn(function()
        while Running and AutoOrbit and OrbitRunId == id do
            local mobs = getAllMobs()

            if #mobs == 0 then
                task.wait(ORBIT_SCAN_DELAY)
            else
                for _, mob in ipairs(mobs) do
                    if not Running or not AutoOrbit or OrbitRunId ~= id then
                        break
                    end

                    if mob.Parent and not isDead(mob) then
                        orbitMob(mob, id)
                    end

                    task.wait(0.05)
                end
            end
        end
    end)
end

local function stopOrbit()
    AutoOrbit = false
    OrbitRunId += 1
    stopHover()
end

