local function getTPTarget()
    updateCharacter()

    if not Root then return nil end

    local folder = Workspace:FindFirstChild("Enemies")
    if not folder then return nil end

    local bestMob
    local bestDistance = math.huge

    for _, mob in ipairs(folder:GetChildren()) do
        if mob:IsA("Model") and not isDead(mob) and validOwner(mob) then
            local mobRoot = getMobRoot(mob)

            if mobRoot then
                local offset = mobRoot.Position - Root.Position
                local distance = offset.Magnitude

                if distance > 0
                    and distance <= SCAN_RANGE
                    and math.abs(offset.Y) <= MAX_HEIGHT
                    and distance < bestDistance then

                    bestDistance = distance
                    bestMob = mob
                end
            end
        end
    end

    return bestMob
end

local function stopTP()
    AutoTP = false
    TPRunId += 1
end

local function startTP()
    if not Running or AutoTP then return end

    AutoTP = true
    TPRunId += 1

    local id = TPRunId

    task.spawn(function()
        while Running and AutoTP and TPRunId == id do
            updateCharacter()

            if not Root or not Humanoid or Humanoid.Health <= 0 then
                task.wait(0.2)
                continue
            end

            local mob = getTPTarget()

            if mob and mob.Parent and not isDead(mob) then
                local mobRoot = getMobRoot(mob)

                if mobRoot then
                    local behind = mobRoot.CFrame:PointToWorldSpace(
                        Vector3.new(0, 0, TP_BEHIND_DISTANCE)
                    )

                    local targetCF = CFrame.lookAt(behind, mobRoot.Position)

                    if Running and AutoTP and TPRunId == id then
                        pcall(function()
                            Root.CFrame = targetCF
                        end)
                    end
                end
            end

            task.wait(TP_UPDATE_DELAY)
        end
    end)
end

--============================================================
-- DUNGEON OBJECT HELPERS
--============================================================

local function getObjectCFrame(object)
    if not object then return nil end

    if object:IsA("BasePart") then
        return object.CFrame
    end

    if object:IsA("Model") then
        return object:GetPivot()
    end

    local part = object:FindFirstChildWhichIsA("BasePart", true)

    return part and part.CFrame or nil
end

local function teleportObject(object)
    local cf = getObjectCFrame(object)
    if not cf then return false end

    updateCharacter()
    if not Root then return false end

    return pcall(function()
        Root.CFrame = cf + Vector3.new(0, 3, 0)
    end)
end

--============================================================
-- NORMAL DUNGEON
--============================================================

local function dungeonAlive(id)
    return Running and AutoDungeon and DungeonRunId == id
end

local function waitDungeonStart(id)
    DungeonStatus = "Menunggu posisi 1..."

    while dungeonAlive(id) do
        updateCharacter()

        if Root and (Root.Position - DUNGEON_START).Magnitude <= DUNGEON_TOLERANCE then
            return true
        end

        task.wait(DUNGEON_WAIT_DELAY)
    end

    return false
end

local function walkDungeonEntry(id)
    DungeonStatus = SelectedDungeon .. " | Jalan posisi 2..."

    local lastOrder = 0

    while dungeonAlive(id) do
        updateCharacter()

        if not Root or not Humanoid or Humanoid.Health <= 0 then
            return false
        end

        if (Root.Position - DUNGEON_ENTRY).Magnitude <= ENTRY_TOLERANCE then
            Humanoid:MoveTo(Root.Position)
            return true
        end

        if os.clock() - lastOrder >= 5 then
            Humanoid:MoveTo(DUNGEON_ENTRY)
            lastOrder = os.clock()
        end

        task.wait(0.1)
    end

    return false
end

local function waitDungeonAppear(id)
    DungeonStatus = "Menunggu mob muncul..."

    while dungeonAlive(id) do
        if getEnemyCount() > 0 then return true end
        task.wait(0.2)
    end

    return false
end

local function waitDungeonClear(id)
    if not waitDungeonAppear(id) then return false end

    DungeonStatus = "Melawan mob..."

    while dungeonAlive(id) do
        if getEnemyCount() == 0 then return true end
        task.wait(0.2)
    end

    return false
end

local function waitStableDungeonClear(id)
    DungeonStatus = SelectedDungeon .. " | Scan mob 2 detik..."

    local first = os.clock() + MOB_CLEAR_INITIAL_DELAY

    while dungeonAlive(id) and os.clock() < first do
        if getEnemyCount() > 0 then return false end
        task.wait(0.1)
    end

    while dungeonAlive(id) do
        if getEnemyCount() > 0 then return false end

        local start = os.clock()
        local empty = true

        while dungeonAlive(id)
            and os.clock() - start < MOB_EMPTY_CONFIRM_TIME do

            if getEnemyCount() > 0 then
                empty = false
                break
            end

            task.wait(0.1)
        end

        if not dungeonAlive(id) then return false end

        if empty and getEnemyCount() == 0 then
            return true
        end
    end

    return false
end

local function stopDungeon()
    AutoDungeon = false
    DungeonRunId += 1
    DungeonStatus = "Dungeon: OFF"
end

local function startDungeon()
    if not Running or AutoDungeon then return end

    if AutoHallow then
        DungeonStatus = "Matikan Auto Hallow dahulu!"
        return
    end

    local name = DungeonNameInput and DungeonNameInput.Text or "S1"

    name = string.upper(string.match(name, "^%s*(.-)%s*$") or "")

    if name == "" then
        DungeonStatus = "Isi nama dungeon!"
        return
    end

    SelectedDungeon = name
    AutoDungeon = true
    DungeonRunId += 1

    local id = DungeonRunId

    task.spawn(function()
        while dungeonAlive(id) do
            if not waitDungeonStart(id) then break end

            if AutoOrbit then stopOrbit() end
            task.wait(0.2)

            if not dungeonAlive(id) then break end

            if not walkDungeonEntry(id) then
                if not dungeonAlive(id) then break end
                task.wait(0.5)
                continue
            end

            updateCharacter()

            if not Root or (Root.Position - DUNGEON_ENTRY).Magnitude > ENTRY_TOLERANCE then
                task.wait(0.5)
                continue
            end

            DungeonStatus = name .. " | EnterDungeon..."

            local ok, err = pcall(function()
                return RequestRemote:InvokeServer("EnterDungeon", name, 2)
            end)

            if not ok then
                DungeonStatus = "Remote error: " .. tostring(err)
                task.wait(2)
                continue
            end

            if not dungeonAlive(id) then break end

            if not AutoOrbit then startOrbit() end

            if not waitDungeonClear(id) then
                if not dungeonAlive(id) then break end
                continue
            end

            if not waitStableDungeonClear(id) then
                if not dungeonAlive(id) then break end
                continue
            end

            local folder = Workspace:FindFirstChild("Dungeons")
            local selected = folder and folder:FindFirstChild(name)
            local door = selected and selected:FindFirstChild("BossDoor")
            local glow = door and door:FindFirstChild("FloorGlow", true)

            if not glow then
                DungeonStatus = name .. " | FloorGlow tidak ditemukan"
                break
            end

            DungeonStatus = name .. " | TP FloorGlow..."

            if not teleportObject(glow) then
                DungeonStatus = name .. " | TP FloorGlow gagal"
                break
            end

            DungeonStatus = name .. " | Menunggu boss..."

            local deadline = os.clock() + 15
            local found = false

            while dungeonAlive(id) and os.clock() < deadline do
                if getEnemyCount() > 0 then
                    found = true
                    break
                end
                task.wait(0.2)
            end

            if not dungeonAlive(id) then break end

            if not found then
                DungeonStatus = name .. " | Boss tidak muncul"
                break
            end

            DungeonStatus = name .. " | Melawan boss..."

            if not waitStableDungeonClear(id) then
                if not dungeonAlive(id) then break end
                continue
            end

            local markers = selected and selected:FindFirstChild("Markers")
            local exit = markers and markers:FindFirstChild("BossExit")

            if exit then
                teleportObject(exit)
                DungeonStatus = name .. " | BossExit"
            else
                DungeonStatus = name .. " | BossExit tidak ditemukan"
            end

            task.wait(0.3)

            if AutoOrbit then stopOrbit() end

            task.wait(1)
        end

        if DungeonRunId == id then
            AutoDungeon = false

            if AutoOrbit then stopOrbit() end

            DungeonStatus = "Dungeon: OFF"
        end
    end)
end

