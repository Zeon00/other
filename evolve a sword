local function waitForEnemyAppear(isAlive, statusCallback, timeout)
    if statusCallback then
        statusCallback("Menunggu mob muncul...")
    end

    local deadline = timeout and (os.clock() + timeout) or nil

    while isAlive() do
        if getEnemyCount() > 0 then
            return true
        end

        if deadline and os.clock() >= deadline then
            return false
        end

        task.wait(0.2)
    end

    return false
end

local function waitForEnemyClear(isAlive, statusCallback)
    if not waitForEnemyAppear(isAlive, statusCallback) then
        return false
    end

    if statusCallback then
        statusCallback("Menunggu mob habis...")
    end

    while isAlive() do
        if getEnemyCount() == 0 then
            local start = os.clock()
            local empty = true

            while isAlive() and os.clock() - start < MOB_EMPTY_CONFIRM_TIME do
                if getEnemyCount() > 0 then
                    empty = false
                    break
                end

                task.wait(0.1)
            end

            if empty and getEnemyCount() == 0 then
                return true
            end
        end

        task.wait(0.1)
    end

    return false
end

--============================================================
-- DUNGEON PROGRESS
--============================================================

local function getDungeonProgress()
    local playerGui = Player:FindFirstChild("PlayerGui")
    local gameUI = playerGui and playerGui:FindFirstChild("GameUI")
    local dungeonBar = gameUI and gameUI:FindFirstChild("DungeonBar")
    local progress = dungeonBar and dungeonBar:FindFirstChild("Progress")
    local textFolder = progress and progress:FindFirstChild("Text")

    if not textFolder then
        return nil, nil, nil
    end

    local valueObject = textFolder:FindFirstChild("Value")
    local captionObject = textFolder:FindFirstChild("Caption")

    local rawText = valueObject and valueObject.Text or ""
    local caption = captionObject and captionObject.Text or ""

    local current, total = rawText:match("(%d+)%s*/%s*(%d+)")

    return tonumber(current), tonumber(total), caption
end

local function waitForProgressComplete(isAlive, statusCallback, useBeacon)
    local emptyStart = nil
    local lastTPTime = 0
    local lastBeaconPosition = nil

    while isAlive() do
        local playerGui = Player:FindFirstChild("PlayerGui")
        local gameUI = playerGui and playerGui:FindFirstChild("GameUI")

        local dungeonBar = gameUI and gameUI:FindFirstChild("DungeonBar")
        local progress = dungeonBar and dungeonBar:FindFirstChild("Progress")
        local textFolder = progress and progress:FindFirstChild("Text")
        local caption = textFolder and textFolder:FindFirstChild("Caption")

        if caption and caption:IsA("TextLabel") then
            local captionText = string.lower(
                (caption.Text or ""):match("^%s*(.-)%s*$")
            )

            if captionText == "open!" or captionText == "open" then
                if statusCallback then
                    statusCallback("BOSS OPEN! Teleport FloorGlow...")
                end

                return true
            end
        end

        if useBeacon then
            local enemyCount = getEnemyCount()

            if enemyCount > 0 then
                emptyStart = nil
                lastTPTime = 0
                lastBeaconPosition = nil
            else
                if not emptyStart then
                    emptyStart = os.clock()
                end

                if os.clock() - emptyStart >= MOB_EMPTY_CONFIRM_TIME then
                    local beacon

                    for _, fx in ipairs(Workspace:GetChildren()) do
                        if fx.Name == "ClientFX" then
                            local candidate = fx:FindFirstChild("MonsterBeacon")

                            if candidate and candidate:IsA("BasePart") then
                                local billboard = candidate:FindFirstChild("BillboardGui")
                                local hasDistanceText = false

                                if billboard then
                                    for _, label in ipairs(billboard:GetDescendants()) do
                                        if (label:IsA("TextLabel") or label:IsA("TextButton"))
                                            and label.Text:match("%d+%s*m") then

                                            hasDistanceText = true
                                            break
                                        end
                                    end
                                end

                                if hasDistanceText then
                                    beacon = candidate
                                    break
                                end
                            end
                        end
                    end

                    if beacon then
                        updateCharacter()

                        if Root then
                            local beaconPos = beacon.Position
                            local distance = (Root.Position - beaconPos).Magnitude

                            local beaconMoved = not lastBeaconPosition
                                or (beaconPos - lastBeaconPosition).Magnitude > 5

                            local cooldownReady = os.clock() - lastTPTime >= 3

                            if distance > 12
                                and cooldownReady
                                and (beaconMoved or lastTPTime > 0) then

                                if statusCallback then
                                    statusCallback("Enemies kosong! TP MonsterBeacon...")
                                end

                                if isAlive() then
                                    teleportObject(beacon)
                                    lastTPTime = os.clock()
                                    lastBeaconPosition = beaconPos
                                end

                            elseif distance <= 12 then
                                if statusCallback then
                                    statusCallback("Sudah di MonsterBeacon! Menunggu enemies...")
                                end
                            end
                        end
                    else
                        if statusCallback then
                            statusCallback("Enemies kosong! MonsterBeacon tidak ditemukan...")
                        end
                    end
                end
            end
        end

        task.wait(0.15)
    end

    return false
end

