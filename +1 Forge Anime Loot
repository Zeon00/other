local function GetMobRoot(Mob)

    if not Mob then

        return nil

    end



    return Mob:FindFirstChild("HumanoidRootPart")

        or Mob:FindFirstChild("Head")

        or Mob.PrimaryPart

end



local function IsAlive(Mob)

    if not Mob or not Mob.Parent then

        return false

    end



    local Humanoid = Mob:FindFirstChildOfClass("Humanoid")

    local Root = GetMobRoot(Mob)



    return Humanoid ~= nil

        and Humanoid.Health > 0

        and Root ~= nil

        and Root:IsA("BasePart")

end



local function GetNextMob()

    local _, PlayerRoot = GetCharacter()



    if not PlayerRoot then

        return nil

    end



    local Mobs = {}



    for _, Mob in ipairs(CollectionService:GetTagged(Config.BotTag)) do

        if Mob:IsA("Model") and IsAlive(Mob) then

            table.insert(Mobs, Mob)

        end

    end



    table.sort(Mobs, function(A, B)

        local RootA = GetMobRoot(A)

        local RootB = GetMobRoot(B)



        if not RootA or not RootB then

            return false

        end



        return (RootA.Position - PlayerRoot.Position).Magnitude

            < (RootB.Position - PlayerRoot.Position).Magnitude

    end)



    return Mobs[1]

end



--============================================================

-- CREATE PHYSICS ORBIT

--============================================================



local function CreateOrbitRig(Character, Root, Humanoid, MobRoot)

    DestroyOrbitRig()



    if not Settings.Orbit then

        return false

    end



    if not Root or not MobRoot then

        return false

    end



    local Success = pcall(function()



        -- PLAYER ATTACHMENT

        OrbitAttachment = Instance.new("Attachment")

        OrbitAttachment.Name = "DeltaOrbitAttachment"

        OrbitAttachment.Parent = Root



        -- TARGET ATTACHMENT

        TargetAttachment = Instance.new("Attachment")

        TargetAttachment.Name = "DeltaTargetAttachment"

        TargetAttachment.Parent = MobRoot



        -- ALIGN POSITION

        AlignPosition = Instance.new("AlignPosition")

        AlignPosition.Name = "DeltaSmoothPosition"

        AlignPosition.Mode = Enum.PositionAlignmentMode.TwoAttachment



        AlignPosition.Attachment0 = OrbitAttachment

        AlignPosition.Attachment1 = TargetAttachment



        AlignPosition.ApplyAtCenterOfMass = true

        AlignPosition.RigidityEnabled = false

        AlignPosition.ReactionForceEnabled = false



        AlignPosition.Responsiveness = Responsiveness

        AlignPosition.MaxVelocity = MaxVelocity

        AlignPosition.MaxForce = MaxForce



        AlignPosition.Parent = Root



        -- ALIGN ORIENTATION

        AlignOrientation = Instance.new("AlignOrientation")

        AlignOrientation.Name = "DeltaSmoothOrientation"

        AlignOrientation.Mode = Enum.OrientationAlignmentMode.OneAttachment



        AlignOrientation.Attachment0 = OrbitAttachment

        AlignOrientation.RigidityEnabled = false

        AlignOrientation.ReactionTorqueEnabled = false



        AlignOrientation.Responsiveness = Responsiveness

        AlignOrientation.MaxAngularVelocity = 10

        AlignOrientation.MaxTorque = MaxTorque



        AlignOrientation.Parent = Root



        PreviousAutoRotate = Humanoid.AutoRotate

        Humanoid.AutoRotate = false



        OrbitRigTarget = MobRoot

    end)



    if not Success then

        DestroyOrbitRig()

        return false

    end



    return true

end



