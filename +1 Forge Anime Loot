            local Waited = 0

            while Waited < PLAYTIME_CHECK_DELAY
                and not Destroyed
                and Settings.Playtime do

                local Step = math.min(1, PLAYTIME_CHECK_DELAY - Waited)
                task.wait(Step)
                Waited += Step
            end
        else
            task.wait(0.2)
        end
    end
end)

