        if not dungeonEnabled() then
            task.wait(0.25)
            continue
        end

        if DungeonReturning then
            task.wait(0.5)
            continue
        end

        DungeonBackpackFull = false
        dungeonStatus("Memasuki dungeon...")

        local ok, result = pcall(function()
            return DungeonTeleportRemote:InvokeServer(DUNGEON_ID)
        end)

        if not ok then
            dungeonStatus("Teleport gagal - retry 3 detik")
            task.wait(3)
            continue
        end

        dungeonStatus("Dungeon aktif")
        task.wait(3)

        while dungeonEnabled() and not DungeonBackpackFull do
            if dungeonIsBackpackFull() then
                DungeonBackpackFull = true
                break
            end

            local stageOK, stageError = pcall(function()
                dungeonRunStages()
            end)

            if not stageOK then
                dungeonStatus("Stage error: " .. tostring(stageError))
                task.wait(2)
            end

            if not dungeonEnabled() or DungeonBackpackFull then
                break
            end

            if dungeonIsBackpackFull() then
                DungeonBackpackFull = true
                break
            end

            task.wait(0.5)
        end

        if dungeonEnabled() and DungeonBackpackFull then
            dungeonReturnAndReset()
        end

        task.wait(1)
    end
end)

