--============================================================
-- SMOOTH PHYSICS ORBIT LOOP
--============================================================

local MaxMobDistance = 80
local MaxVerticalDifference = 25

local function UpdateOrbit(Delta)
    if Destroyed or not Settings.Orbit then
        return
    end

    local Character, Root, Humanoid = GetCharacter()

    if not Character or not Root or not Humanoid then
        DestroyOrbitRig()
        OrbitStatus.Text = "Orbit: Waiting character"
        return
    end

    -- KEEP SAME TARGET UNTIL DEAD / REMOVED
    if not Target or not IsAlive(Target) then
        DestroyOrbitRig()

        Target = GetNextMob()
        Angle = 0

        if not Target then
            OrbitStatus.Text = "Orbit: No mob found"
            return
        end
    end

    if not Settings.Orbit then
        return
    end

    local MobRoot = GetMobRoot(Target)

    if not MobRoot then
        return
    end

    local MobPosition = MobRoot.Position
    local CurrentPosition = Root.Position

    -- SAFE DISTANCE
    if (MobPosition - CurrentPosition).Magnitude > MaxMobDistance
        or math.abs(MobPosition.Y - CurrentPosition.Y) > MaxVerticalDifference then

        OrbitStatus.Text = "Orbit: Target outside safe range"
        return
    end

    -- CREATE PHYSICS IF NEEDED
    if not AlignPosition
        or not AlignOrientation
        or not OrbitAttachment
        or not TargetAttachment
        or OrbitRigTarget ~= MobRoot then

        local Success = CreateOrbitRig(
            Character,
            Root,
            Humanoid,
            MobRoot
        )

        if not Success then
            OrbitStatus.Text = "Orbit: Physics setup failed"
            return
        end
    end

    if not AlignPosition or not TargetAttachment then
        return
    end

    -- SMOOTH ANGLE
    Angle = (Angle + Delta * OrbitSpeed) % (math.pi * 2)

    -- WORLD ORBIT POSITION
    local OrbitY = MobPosition.Y + Height

    local Desired = Vector3.new(
        MobPosition.X + math.cos(Angle) * Radius,
        OrbitY,
        MobPosition.Z + math.sin(Angle) * Radius
    )

    -- CONVERT WORLD POSITION TO TARGET LOCAL POSITION
    TargetAttachment.Position =
        MobRoot.CFrame:PointToObjectSpace(Desired)

    -- FACE TARGET
    local LookAt = Vector3.new(
        MobPosition.X,
        Root.Position.Y,
        MobPosition.Z
    )

    local LookCFrame = CFrame.lookAt(
        Root.Position,
        LookAt
    )

    -- CONVERT DESIRED WORLD ROTATION TO ROOT LOCAL ROTATION
    if AlignOrientation then
        AlignOrientation.CFrame =
            Root.CFrame:ToObjectSpace(LookCFrame)
    end

    -- STATUS
    local TargetHumanoid = Target:FindFirstChildOfClass("Humanoid")

    if TargetHumanoid then
        OrbitStatus.Text = string.format(
            "Orbit: %s | HP: %d | R: %.1f",
            Target.Name,
            math.max(0, math.ceil(TargetHumanoid.Health)),
            Radius
        )
    end
end

HeartbeatConnection = RunService.Heartbeat:Connect(function(Delta)
    local Success, Error = pcall(function()
        UpdateOrbit(Delta)
    end)

    if not Success then
        if OrbitStatus then
            OrbitStatus.Text = "Orbit error: " .. tostring(Error)
        end
    end
end)

