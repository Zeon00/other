local function dungeonGetRoot()
    local character = Player.Character
    return character and character:FindFirstChild("HumanoidRootPart")
end

local function dungeonGetBackpackTitle()
    local ok, result = pcall(function()
        return DungeonPlayerGui
            :WaitForChild("ScreenGui")
            :WaitForChild("MainUIs")
            :WaitForChild("PlayerHUD")
            :WaitForChild("Stats")
            :WaitForChild("Backpack")
            :WaitForChild("Title")
    end)
    if ok then return result end
    return nil
end

local function dungeonIsBackpackFull()
    local title = dungeonGetBackpackTitle()
    if not title then return DungeonBackpackFull end

    local current, maximum = tostring(title.Text or ""):match("(%d+)%s*/%s*(%d+)")
    current, maximum = tonumber(current), tonumber(maximum)

    if current and maximum and maximum > 0 then
        return current >= maximum
    end
    return DungeonBackpackFull
end

local function dungeonGetLootFolder()
    return workspace:FindFirstChild("LootDrops")
end

local function dungeonGetLootAnchor(model)
    if not model or not model.Parent then return nil end

    local anchor = model:FindFirstChild("LootAnchor", true)
    if anchor and anchor:IsA("BasePart") then return anchor end

    if model:IsA("BasePart") then return model end
    if model:IsA("Model") then
        return model.PrimaryPart or model:FindFirstChildWhichIsA("BasePart", true)
    end
    return nil
end

local function dungeonAttributeMatches(model, dropId)
    for _, key in ipairs({"DropId", "LootId", "PickupId", "Id", "id"}) do
        local value = model:GetAttribute(key)
        if value ~= nil and tostring(value) == tostring(dropId) then
            return true
        end
    end
    return false
end

local function dungeonFindDropModel(dropData)
    local folder = workspace:FindFirstChild("LootDrops")
    if not folder then return nil end

    local dropId = dropData.id
    local itemId = dropData.itemId or dropData.item or dropData.IngredientId

    for _, model in ipairs(folder:GetDescendants()) do
        if (model:IsA("Model") or model:IsA("BasePart"))
            and not DungeonReservedModels[model] then
            local modelName = tostring(model.Name)
            local wantedId = tostring(dropId)
            local normalizedName = modelName:gsub("^[dD]", "")
            local normalizedId = wantedId:gsub("^[dD]", "")
            if modelName == wantedId
                or normalizedName == normalizedId
                or dungeonAttributeMatches(model, dropId) then
                return model
            end
        end
    end

    if itemId ~= nil then
        for _, model in ipairs(folder:GetDescendants()) do
            if (model:IsA("Model") or model:IsA("BasePart"))
                and not DungeonReservedModels[model]
                and tostring(model.Name) == tostring(itemId) then
                return model
            end
        end
    end

    local targetPosition = dropData.position or dropData.Position
    if typeof(targetPosition) == "CFrame" then
        targetPosition = targetPosition.Position
    end

    if typeof(targetPosition) == "Vector3" then
        local bestModel, bestDistance = nil, math.huge
        for _, model in ipairs(folder:GetDescendants()) do
            if (model:IsA("Model") or model:IsA("BasePart"))
                and not DungeonReservedModels[model] then
                local anchor = dungeonGetLootAnchor(model)
                if anchor then
                    local distance = (anchor.Position - targetPosition).Magnitude
                    if distance < bestDistance then
                        bestDistance, bestModel = distance, model
                    end
                end
            end
        end
        if bestDistance <= 30 then return bestModel end
    end

    return nil
end

local function dungeonTeleportToDrop(model)
    if not dungeonEnabled() or not model or not model.Parent then return false end

    local anchor = dungeonGetLootAnchor(model)
    local root = dungeonGetRoot()
    if not anchor or not root then return false end

    DungeonLootBusy = true
    dungeonStatus("TP langsung ke drop " .. model.Name)

    local ok = pcall(function()
        root.CFrame = CFrame.new(anchor.Position + Vector3.new(0, 3, 0))
    end)

    task.wait(0.2)
    root = dungeonGetRoot()
    local reached = ok and root and (root.Position - anchor.Position).Magnitude <= 12
    DungeonLootBusy = false
    return reached == true
end

local function dungeonPickupDrop(dropData)
    if not dungeonEnabled() or DungeonBackpackFull or DungeonReturning then return end
    if type(dropData) ~= "table" or dropData.id == nil then return end

    local dropId = dropData.id
    if DungeonPickedDrops[dropId] or DungeonPendingDrops[dropId] then return end
    DungeonPendingDrops[dropId] = true

    task.spawn(function()
        -- Skip the old long loot-flight delay; scan for the client drop quickly.
        task.wait(DUNGEON_LAND_EXTRA)

        local model
        for attempt = 1, 12 do
            if not dungeonEnabled() or DungeonBackpackFull or DungeonReturning then break end
            model = dungeonFindDropModel(dropData)
            if model then break end
            task.wait(0.08)
        end

        if model and dungeonEnabled() and not DungeonBackpackFull then
            DungeonReservedModels[model] = true
            dungeonTeleportToDrop(model)
        else
            -- If the event already contains a world position, use it directly
            -- rather than waiting for a matching client model to appear.
            local targetPosition = dropData.position or dropData.Position
            if typeof(targetPosition) == "CFrame" then
                targetPosition = targetPosition.Position
            end
            local root = dungeonGetRoot()
            if typeof(targetPosition) == "Vector3" and root and dungeonEnabled() then
                DungeonLootBusy = true
                pcall(function()
                    root.CFrame = CFrame.new(targetPosition + Vector3.new(0, 3, 0))
                end)
                task.wait(0.08)
                DungeonLootBusy = false
            end
        end

        while dungeonEnabled() and not DungeonBackpackFull and not DungeonReturning do
            if DungeonPickedDrops[dropId] then break end

            pcall(function()
                DungeonLootRemote:FireServer("pickup", dropId)
            end)

            task.wait(DUNGEON_PICKUP_RETRY)

            if not DungeonDeniedDrops[dropId] then break end
            DungeonDeniedDrops[dropId] = nil
        end

        if model then DungeonReservedModels[model] = nil end
        DungeonPendingDrops[dropId] = nil
        DungeonLootBusy = false
    end)
end

DungeonLootConnection = DungeonLootRemote.OnClientEvent:Connect(function(action, ...)
    if Destroyed then return end
    local args = {...}

    if action == "drop" then
        local dropList = args[1]
        if type(dropList) == "table" then
            for _, dropData in pairs(dropList) do
                dungeonPickupDrop(dropData)
            end
        end
    elseif action == "picked" then
        local dropId = args[1]
        if dropId ~= nil then
            DungeonPickedDrops[dropId] = true
            DungeonPendingDrops[dropId] = nil
            DungeonDeniedDrops[dropId] = nil
        end
    elseif action == "denied" then
        local dropId = args[1]
        if dropId ~= nil then DungeonDeniedDrops[dropId] = true end
    elseif action == "full" then
        DungeonBackpackFull = true
        dungeonStatus("Backpack penuh")
    end
end)

task.spawn(function()
