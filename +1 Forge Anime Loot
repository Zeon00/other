)

root.CFrame = CFrame.new(safePosition) * root.CFrame.Rotation

task.wait(0.05)
        end

        if os.clock() - started > maxTime then
            break
        end
    end

    root = dungeonGetRoot()

    local reached = root
        and (root.Position - position).Magnitude <= (distance or 7)

    DungeonStageMoving = false

    return reached == true
end

local function dungeonRunStages()
    local stages = dungeonGetStages()
    if #stages == 0 then
        dungeonStatus("Area/Stage belum ditemukan")
        task.wait(2)
        return
    end

    -- Area suffix awal mengikuti area terdekat dari posisi saat ini, bukan Area1.
    local startArea = dungeonGetStartingArea(stages) or stages[1].AreaNumber

    while dungeonEnabled() and not DungeonBackpackFull do
        local cleared = dungeonGetClearedStages()
        local nextEntry = nil

        for _, entry in ipairs(stages) do
            if entry.AreaNumber >= startArea
                and not dungeonStageCleared(entry.Object, entry.Area, cleared) then
                nextEntry = entry
                break
            end
        end

        if not nextEntry then
            dungeonStatus("Stage terakhir selesai - standby menunggu backpack penuh")
            while dungeonEnabled() and not DungeonBackpackFull do
                if dungeonIsBackpackFull() then
                    DungeonBackpackFull = true
                    break
                end
                task.wait(0.5)
            end
            break
        end

        local zone = dungeonGetZone(nextEntry.Object)
        if zone then
            while DungeonLootBusy and dungeonEnabled() do task.wait(0.15) end
            if not dungeonEnabled() then break end

            dungeonStatus(nextEntry.Area.Name .. " / " .. nextEntry.Object.Name)
            dungeonMoveToPosition(zone.Position, 7, DUNGEON_STAGE_TIMEOUT)
            task.wait(DUNGEON_STAGE_WAIT)
        else
            dungeonStatus("Zone tidak ditemukan: " .. nextEntry.Area.Name .. "/" .. nextEntry.Object.Name)
            task.wait(1.5)
        end
    end
end

local function dungeonReturnAndReset()
    if DungeonReturning then return end
    DungeonReturning = true
    DungeonBackpackFull = true
    dungeonStatus("Backpack penuh - Return")

    pcall(function()
        DungeonReturnRemote:FireServer()
    end)

    task.wait(DUNGEON_RETURN_WAIT)

    table.clear(DungeonPendingDrops)
    table.clear(DungeonPickedDrops)
    table.clear(DungeonDeniedDrops)
    table.clear(DungeonReservedModels)

    DungeonLootBusy = false
    DungeonStageMoving = false
    DungeonBackpackFull = false
    DungeonReturning = false
end

