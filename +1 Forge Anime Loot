local DUNGEON_STAGE_TIMEOUT = 20
local DUNGEON_STAGE_WAIT = 1

local DungeonBackpackFull = false
local DungeonReturning = false
local DungeonPendingDrops = {}
local DungeonPickedDrops = {}
local DungeonDeniedDrops = {}
local DungeonReservedModels = {}
local DungeonLootBusy = false
local DungeonStageMoving = false

local function dungeonEnabled()
    return not Destroyed and Settings.Dungeon == true
end

local function dungeonStatus(message)
    if DungeonStatus and DungeonStatus.Parent then
        DungeonStatus.Text = "Dungeon: " .. tostring(message)
    end
end

local function dungeonGetRoot()
    local character = Player.Character
    return character and character:FindFirstChild("HumanoidRootPart")
end

local function dungeonGetBackpackTitle()
    local ok, result = pcall(function()
        return DungeonPlayerGui
            :WaitForChild("ScreenGui")
            :WaitForChild("MainUIs")
            :WaitForChild("PlayerHUD")
            :WaitForChild("Stats")
            :WaitForChild("Backpack")
            :WaitForChild("Title")
    end)

    if ok then
        return result
    end

    return nil
end

local function dungeonIsBackpackFull()
    local title = dungeonGetBackpackTitle()

    if not title then
        return DungeonBackpackFull
    end

    local current, maximum = tostring(title.Text or ""):match("(%d+)%s*/%s*(%d+)")
    current, maximum = tonumber(current), tonumber(maximum)

    if current and maximum and maximum > 0 then
        return current >= maximum
    end

    return DungeonBackpackFull
end

local function dungeonGetLootFolder()
    return workspace:FindFirstChild("LootDrops")
end

local function dungeonGetLootAnchor(model)
    if not model or not model.Parent then
        return nil
    end

    local anchor = model:FindFirstChild("LootAnchor", true)

    if anchor and anchor:IsA("BasePart") then
        return anchor
    end

    if model:IsA("BasePart") then
        return model
    end

    if model:IsA("Model") then
        return model.PrimaryPart
            or model:FindFirstChildWhichIsA("BasePart", true)
    end

    return nil
end

--============================================================
-- RAINBOW SECRET ONLY PICKUP
-- LootDrops INTERNAL TABLE | RARITY 9
--============================================================

local LootDropsAPI = nil
local LootEntries = nil

local function dungeonLoadLootModule()
    if LootDropsAPI then
        return true
    end

    if type(getloadedmodules) ~= "function"
        or type(getupvalues) ~= "function" then

        dungeonStatus("Executor tidak mendukung internal scan")
        return false
    end

    local found

    for _, module in ipairs(getloadedmodules()) do
        if module:IsA("ModuleScript") and module.Name == "LootDrops" then
            found = module
            break
        end
    end

    if not found then
        dungeonStatus("LootDrops belum dimuat")
        return false
    end

    local ok, api = pcall(require, found)

    if not ok or type(api) ~= "table"
        or type(api.nearest) ~= "function" then

        dungeonStatus("LootDrops API gagal")
        return false
    end

    LootDropsAPI = api
    return true
end

local function dungeonFindLootEntries()
    if not dungeonLoadLootModule() then
        return nil
    end

    local ok, upvalues = pcall(getupvalues, LootDropsAPI.nearest)

    if not ok or type(upvalues) ~= "table" then
        return nil
    end

    -- Upvalue pertama merupakan tabel aktif LootDrops.
    if type(upvalues[1]) == "table" then
        return upvalues[1]
    end

    -- Fallback jika indeks upvalue berbeda.
    for _, value in pairs(upvalues) do
        if type(value) == "table" then
            for _, entry in pairs(value) do
                if type(entry) == "table"
                    and entry.id ~= nil
                    and entry.ore ~= nil then

                    return value
                end
            end
        end
    end

    return nil
end

local function dungeonGetRainbowEntries()
    local entries = dungeonFindLootEntries()

    if not entries then
        return {}
    end

    LootEntries = entries

    local result = {}

    for _, entry in pairs(entries) do
        if type(entry) == "table"
            and entry.id ~= nil
            and entry.state == "landed"
            and type(entry.ore) == "table"
            and tonumber(entry.ore.rarity) == 9
            and entry.model
            and entry.model.Parent then

            table.insert(result, entry)
        end
    end

    return result
end

local function dungeonGetCurrentEntry(id)
    if not LootEntries then
        return nil
    end

    local entry = LootEntries[id]

    if type(entry) == "table" and entry.id == id then
        return entry
    end

    for _, candidate in pairs(LootEntries) do
        if type(candidate) == "table" and candidate.id == id then
            return candidate
        end
    end

    return nil
end

local function dungeonPickupRainbow(entry)
    if not dungeonEnabled()
        or DungeonBackpackFull
        or DungeonReturning
        or not entry
        or entry.id == nil then

        return
    end

    local id = entry.id

    if DungeonPickedDrops[id] or DungeonPendingDrops[id] then
        return
    end

    DungeonPendingDrops[id] = true

    task.spawn(function()
        local model = entry.model
        local anchor = entry.anchor

        if not anchor or not anchor:IsA("BasePart") then
            anchor = dungeonGetLootAnchor(model)
        end

        if not model or not model.Parent or not anchor then
            DungeonPendingDrops[id] = nil
            return
        end

        DungeonLootBusy = true

        dungeonStatus(
            "Rainbow Secret ditemukan: " ..
            tostring(entry.ore.name)
        )

        -- Pertahankan mekanisme TP pickup sebelumnya.
        local root = dungeonGetRoot()

        if root then
            pcall(function()
                root.CFrame = CFrame.new(
                    anchor.Position + Vector3.new(0, 3, 0)
                )
            end)
        end

        task.wait(0.2)

        for attempt = 1, 10 do
            if not dungeonEnabled()
                or DungeonBackpackFull
                or DungeonReturning
                or DungeonPickedDrops[id] then

                break
            end

            local current = dungeonGetCurrentEntry(id)

            if not current
                or current.state ~= "landed"
                or not current.model
                or not current.model.Parent
                or type(current.ore) ~= "table"
                or tonumber(current.ore.rarity) ~= 9 then

                break
            end

            DungeonDeniedDrops[id] = nil

            pcall(function()
                DungeonLootRemote:FireServer("pickup", id)
            end)

            local started = os.clock()

            while os.clock() - started < 0.25 do
                if DungeonPickedDrops[id]
                    or DungeonDeniedDrops[id]
                    or not dungeonEnabled() then

                    break
                end

                task.wait(0.025)
            end

            if DungeonPickedDrops[id] then
                break
            end

            if DungeonDeniedDrops[id] then
                DungeonDeniedDrops[id] = nil
                task.wait(0.1)
            end
        end

        if DungeonPickedDrops[id] then
            dungeonStatus("Rainbow Secret berhasil diambil!")
        else
            dungeonStatus("Pickup belum dikonfirmasi: " .. tostring(id))
        end

        DungeonLootBusy = false
        DungeonPendingDrops[id] = nil
    end)
end

--============================================================
-- SCAN RAINBOW SECRET
--============================================================

task.spawn(function()
    while not Destroyed do
        if dungeonEnabled()
            and not DungeonBackpackFull
            and not DungeonReturning then

            local entries = dungeonGetRainbowEntries()

            for _, entry in ipairs(entries) do
                dungeonPickupRainbow(entry)
            end
        end

        task.wait(0.2)
    end
end)

--============================================================
-- SERVER CONFIRMATION
--============================================================

DungeonLootConnection = DungeonLootRemote.OnClientEvent:Connect(
    function(action, ...)
        if Destroyed then
            return
        end

        local args = {...}
        local id = args[1]

        if action == "picked" and id ~= nil then
            DungeonPickedDrops[id] = true
            DungeonPendingDrops[id] = nil
            DungeonDeniedDrops[id] = nil

        elseif action == "denied" and id ~= nil then
            DungeonDeniedDrops[id] = true

        elseif action == "full" then
            DungeonBackpackFull = true
            dungeonStatus("Backpack penuh")
        end
    end
)

--============================================================
-- BACKPACK MONITOR
--============================================================

task.spawn(function()
    while not Destroyed do
        if dungeonEnabled() and dungeonIsBackpackFull() then
            DungeonBackpackFull = true
            dungeonStatus("Backpack penuh")
        end

        task.wait(DUNGEON_BACKPACK_CHECK)
    end
end)

--============================================================
-- AREA / STAGE HELPERS
--============================================================

local function dungeonAreaNumber(name)
    return tonumber(tostring(name):match("[Aa]rea(%d+)$"))
end

local function dungeonStageNumber(name)
    return tonumber(tostring(name):match("[Ss]tage(%d+)$"))
end

local function dungeonGetStages()
    local stages = {}
    local areaPrefix = tostring(Config.AreaPrefix or "Area")
    local stagePrefix = tostring(Config.StagePrefix or "Stage")

    for _, area in ipairs(workspace:GetChildren()) do
        local areaNumber = dungeonAreaNumber(area.Name)

        if area:IsA("Folder") and areaNumber
            and area.Name:sub(1, #areaPrefix):lower() == areaPrefix:lower() then

            for _, stage in ipairs(area:GetChildren()) do
                local stageNumber = dungeonStageNumber(stage.Name)

                if stage:IsA("Folder") and stageNumber
                    and stage.Name:sub(1, #stagePrefix):lower() == stagePrefix:lower() then

                    table.insert(stages, {
                        Object = stage,
                        Area = area,
                        AreaNumber = areaNumber,
                        StageNumber = stageNumber
                    })
                end
            end
        end
    end

    table.sort(stages, function(a, b)
        if a.AreaNumber == b.AreaNumber then
            return a.StageNumber < b.StageNumber
        end

        return a.AreaNumber < b.AreaNumber
    end)

    return stages
end

local function dungeonGetZone(stage)
    local zoneName = tostring(Config.ZonePartName or "Zone")

    for _, child in ipairs(stage:GetChildren()) do
        if child:IsA("BasePart")
            and child.Name:lower() == zoneName:lower() then

            return child
        end
    end

    return nil
end

local function dungeonGetClearedStages()
    local attributeName = tostring(
        Config.StagesClearedAttribute or "StagesCleared"
    )

    local raw = Player:GetAttribute(attributeName)
    local cleared = {}

    if type(raw) == "string" then
        for name in raw:gmatch("[^|]+") do
            cleared[name] = true
        end
    end

    return cleared
end

local function dungeonGetStartingArea(stages)
    local root = dungeonGetRoot()

    if not root then
        return nil
    end

    local bestArea, bestDistance = nil, math.huge

    for _, entry in ipairs(stages) do
        local zone = dungeonGetZone(entry.Object)

        if zone then
            local distance = (root.Position - zone.Position).Magnitude

            if distance < bestDistance then
                bestDistance, bestArea = distance, entry.AreaNumber
            end
        end
    end

    return bestArea
end

local function dungeonStageCleared(stage, area, cleared)
    return cleared[stage:GetFullName()]
        or cleared[area.Name .. "." .. stage.Name]
        or cleared[area.Name .. "_" .. stage.Name]
        or cleared[stage.Name]
end

--============================================================
-- PATHFINDING + TP BERTAHAP
--============================================================

local function dungeonMoveToPosition(position, distance, timeout)
    local character = Player.Character
    local root = dungeonGetRoot()

    if not character or not root then
        return false
    end

    DungeonStageMoving = true

    local path = DungeonPathfindingService:CreatePath({
        AgentRadius = 2,
        AgentHeight = 5,
        AgentCanJump = true,
        WaypointSpacing = 5
    })

    local ok = pcall(function()
        path:ComputeAsync(root.Position, position)
    end)

    if not ok or path.Status ~= Enum.PathStatus.Success then
        DungeonStageMoving = false
        return false
    end

    local started = os.clock()
    local maxTime = timeout or DUNGEON_STAGE_TIMEOUT

    for _, waypoint in ipairs(path:GetWaypoints()) do
        if not dungeonEnabled() or DungeonBackpackFull then
            break
        end

        while DungeonLootBusy and dungeonEnabled() do
            task.wait(0.15)
        end

        root = dungeonGetRoot()

        if not root then
            break
        end

        -- TP bertahap maksimal 10 stud mengikuti waypoint Pathfinding.
        local startPosition = root.Position
        local targetPosition = waypoint.Position
        local direction = targetPosition - startPosition
        local totalDistance = direction.Magnitude
        local steps = math.max(1, math.ceil(totalDistance / 10))

        for step = 1, steps do
            if not dungeonEnabled() or DungeonBackpackFull then
                break
            end

            if os.clock() - started > maxTime then
                break
            end

            root = dungeonGetRoot()

            if not root then
                break
            end

            local nextPosition = startPosition:Lerp(
                targetPosition,
                step / steps
            )

            -- Cek lantai sebelum teleport.
            local rayParams = RaycastParams.new()
            rayParams.FilterType = Enum.RaycastFilterType.Exclude
            rayParams.FilterDescendantsInstances = {character}

            local rayOrigin = nextPosition + Vector3.new(0, 12, 0)
            local rayDirection = Vector3.new(0, -60, 0)

            local ground = workspace:Raycast(
                rayOrigin,
                rayDirection,
                rayParams
            )

            -- Kalau tidak ada lantai, batalkan pergerakan.
            if not ground then
                break
            end

            local humanoid = character:FindFirstChildOfClass("Humanoid")
            local heightOffset = humanoid
                and (humanoid.HipHeight + root.Size.Y / 2)
                or 3

            local safePosition = Vector3.new(
                nextPosition.X,
                ground.Position.Y + heightOffset,
                nextPosition.Z
            )

            root.CFrame = CFrame.new(safePosition) * root.CFrame.Rotation

            task.wait(0.05)
        end

        if os.clock() - started > maxTime then
            break
        end
    end

    root = dungeonGetRoot()

    local reached = root
        and (root.Position - position).Magnitude <= (distance or 7)

    DungeonStageMoving = false

    return reached == true
end

--============================================================
-- RUN AREA / STAGE
--============================================================

local function dungeonRunStages()
    local stages = dungeonGetStages()

    if #stages == 0 then
        dungeonStatus("Area/Stage belum ditemukan")
        task.wait(2)
        return
    end

    -- Area suffix awal mengikuti area terdekat dari posisi saat ini.
    local startArea = dungeonGetStartingArea(stages)
        or stages[1].AreaNumber

    while dungeonEnabled() and not DungeonBackpackFull do
        local cleared = dungeonGetClearedStages()
        local nextEntry = nil

        for _, entry in ipairs(stages) do
            if entry.AreaNumber >= startArea
                and not dungeonStageCleared(
                    entry.Object,
                    entry.Area,
                    cleared
                ) then

                nextEntry = entry
                break
            end
        end

        if not nextEntry then
            dungeonStatus(
                "Stage terakhir selesai - standby menunggu backpack penuh"
            )

            while dungeonEnabled() and not DungeonBackpackFull do
                if dungeonIsBackpackFull() then
                    DungeonBackpackFull = true
                    break
                end

                task.wait(0.5)
            end

            break
        end

        local zone = dungeonGetZone(nextEntry.Object)

        if zone then
            while DungeonLootBusy and dungeonEnabled() do
                task.wait(0.15)
            end

            if not dungeonEnabled() then
                break
            end

            dungeonStatus(
                nextEntry.Area.Name .. " / " .. nextEntry.Object.Name
            )

            dungeonMoveToPosition(
                zone.Position,
                7,
                DUNGEON_STAGE_TIMEOUT
            )

            task.wait(DUNGEON_STAGE_WAIT)
        else
            dungeonStatus(
                "Zone tidak ditemukan: " ..
                nextEntry.Area.Name .. "/" .. nextEntry.Object.Name
            )

            task.wait(1.5)
        end
    end
end

--============================================================
-- RETURN + RESET
--============================================================

local function dungeonReturnAndReset()
    if DungeonReturning then
        return
    end

    DungeonReturning = true
    DungeonBackpackFull = true
    dungeonStatus("Backpack penuh - Return")

    local ok, err = pcall(function()
        DungeonReturnRemote:FireServer()
    end)

    if not ok then
        dungeonStatus("Return error: " .. tostring(err))
    end

    -- Tunggu karakter kembali.
    local Returned = false

    for i = 1, 30 do
        task.wait(1)

        local root = dungeonGetRoot()

        if root then
            if i >= 5 then
                Returned = true
                break
            end
        end
    end

    table.clear(DungeonPendingDrops)
    table.clear(DungeonPickedDrops)
    table.clear(DungeonDeniedDrops)
    table.clear(DungeonReservedModels)

    DungeonLootBusy = false
    DungeonStageMoving = false
    DungeonBackpackFull = false
    DungeonReturning = false

    if Returned then
        dungeonStatus("Kembali ke kota - Siap dungeon berikutnya")
    else
        dungeonStatus("Menunggu karakter kembali")
    end

    task.wait(2)
end

