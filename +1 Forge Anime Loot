    while not Destroyed do
        if Settings.Playtime then
            for ClaimId = 1, 12 do
                if Destroyed or not Settings.Playtime then
                    break
                end

                pcall(function()
                    PlaytimeRemote:InvokeServer("claim", ClaimId)
                end)

                task.wait(0.2)
