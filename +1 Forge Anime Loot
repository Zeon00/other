local function MakeToggle(Name, SettingName, Color)
    local Button = MakeButton(
        Name,
        Color3.fromRGB(125, 45, 48),
        33
    )

    local function Refresh()
        local State = Settings[SettingName]

        Button.Text = Name .. (State and " : ON" or " : OFF")

        Button.BackgroundColor3 = State
            and (Color or Color3.fromRGB(35, 135, 75))
            or Color3.fromRGB(125, 45, 48)
    end

    Button.MouseButton1Click:Connect(function()
        if Destroyed then
            return
        end

        if SettingName == "Orbit" then
            if Settings.Orbit then
                StopOrbit()
            else
                DestroyOrbitRig()

                Settings.Orbit = true
                Angle = 0
                Target = nil

                if OrbitStatus then
                    OrbitStatus.Text = "Orbit: Searching..."
                end
            end
        else
            Settings[SettingName] = not Settings[SettingName]
        end

        Refresh()
    end)

    Refresh()

    return Button
end

