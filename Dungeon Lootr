GUI:CreateToggle({
    parent = main,
    text = "Orbit All Conquest Enemies",
    default = true,

    callback = function(state)
        _G.OrbitConquestAll = state

        if not state then
            _G.OrbitConquestRunId = nil
            print("Orbit Conquest: OFF")
            return
        end

        local runId = os.clock()
        _G.OrbitConquestRunId = runId

        task.spawn(function()
            local Players = game:GetService("Players")
            local player = Players.LocalPlayer

            local radius = 15
            local height = 7
            local speed = 2
            local angle = 0

            local function isRunning()
                return _G.OrbitConquestAll
                    and _G.OrbitConquestRunId == runId
            end

            -- Cari folder Conquest terbaru
            local function getCurrentFolder()
                for _, folder in ipairs(workspace:GetChildren()) do
                    if folder.Name:match("^Conquest_")
                        and folder:FindFirstChild("Enemies") then
                        return folder
                    end
                end
                return nil
            end

            local function getTargetPart(npc)
                local part = npc:FindFirstChild(
                    "HumanoidRootPart", true
                )

                if part and part:IsA("BasePart") then
                    return part
                end

                if npc:IsA("Model") and npc.PrimaryPart then
                    return npc.PrimaryPart
                end

                return npc:FindFirstChildWhichIsA(
                    "BasePart", true
                )
            end

            local function getTargets(folder)
                local result = {}
                local enemies = folder:FindFirstChild("Enemies")

                if not enemies then
                    return result
                end

                for _, npc in ipairs(enemies:GetChildren()) do
                    local humanoid =
                        npc:FindFirstChildOfClass("Humanoid")

                    local part = getTargetPart(npc)

                    if part and part.Parent
                        and (not humanoid or humanoid.Health > 0) then
                        table.insert(result, {
                            model = npc,
                            part = part
                        })
                    end
                end

                return result
            end

            print("Orbit Conquest: ON")

            while isRunning() do
                local folder = getCurrentFolder()

                if not folder then
                    task.wait(0.5)
                    continue
                end

                local targets = getTargets(folder)

                if #targets == 0 then
                    task.wait(0.3)
                    continue
                end

                for _, target in ipairs(targets) do
                    if not isRunning()
                        or getCurrentFolder() ~= folder then
                        break
                    end

                    local npc = target.model
                    local startTime = os.clock()

                    while isRunning()
                        and getCurrentFolder() == folder
                        and npc.Parent
                        and os.clock() - startTime < 15 do

                        local character = player.Character
                        local hrp = character
                            and character:FindFirstChild(
                                "HumanoidRootPart"
                            )

                        if not hrp then
                            task.wait(0.2)
                            continue
                        end

                        local humanoid =
                            npc:FindFirstChildOfClass("Humanoid")

                        if humanoid and humanoid.Health <= 0 then
                            break
                        end

                        local part = getTargetPart(npc)

                        if not part or not part.Parent then
                            break
                        end

                        angle = angle + speed * 0.03

                        local offset = Vector3.new(
                            math.cos(angle) * radius,
                            height,
                            math.sin(angle) * radius
                        )

                        local position = part.Position + offset

                        hrp.CFrame = CFrame.lookAt(
                            position,
                            part.Position
                        )

                        task.wait(0.03)
                    end
                end

                task.wait(0.2)
            end

