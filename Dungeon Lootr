local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local player = Players.LocalPlayer
local Knit = require(
    ReplicatedStorage:WaitForChild("Packages"):WaitForChild("Knit")
)
local ConquestService = Knit.GetService("ConquestRunService")

local targets = {}
local visited = {}

ConquestService.Changed:Connect(function(data)
    if data and data.Targets then
        targets = data.Targets
    end
end)

local function targetKey(pos)
    return string.format("%d,%d,%d",
        math.round(pos.X),
        math.round(pos.Y),
        math.round(pos.Z)
    )
end

GUI:CreateToggle({
    parent = main,
    text = "Auto Conquest TP",
    default = false,

    callback = function(state)
        _G.AutoConquestTP = state

        if not state then
            return
        end

        task.spawn(function()
            while _G.AutoConquestTP do
                local character = player.Character
                local root = character
                    and character:FindFirstChild("HumanoidRootPart")

                if root and player:GetAttribute("InConquest") == true then
                    local nearest, nearestDistance

                    for _, pos in pairs(targets) do
                        if typeof(pos) == "Vector3" then
                            local key = targetKey(pos)
                            local distance = (root.Position - pos).Magnitude

                            if not visited[key]
                                and (not nearestDistance
                                or distance < nearestDistance) then
                                nearest = pos
                                nearestDistance = distance
                            end
                        end
                    end

                    if nearest then
                        local key = targetKey(nearest)

                        -- TP sedikit di atas target
                        root.CFrame = CFrame.new(nearest + Vector3.new(0, 3, 0))
                        task.wait(0.4)

                        visited[key] = true
                    else
                        -- Semua target sudah dikunjungi
                        visited = {}
                        task.wait(1)
                    end
                end

                task.wait(0.15)
            end
        end)
    end
})




