GUI:CreateToggle({
    parent = main,
    text = "Fly + Auto Attack Payload",
    default = false,

    callback = function(state)
        _G.FlyAutoAttack = state

        if state then
            task.spawn(function()
                local player = game.Players.LocalPlayer
                local target = nil
                local alignPos = nil
                local alignOri = nil
                local attachment = nil

                local AttackRemote = game:GetService("ReplicatedStorage")
                    :WaitForChild("Player")
                    :WaitForChild("Remotes")
                    :WaitForChild("Inputs")
                    :WaitForChild("Attack")

                while _G.FlyAutoAttack do
                    local character = player.Character
                    local hrp = character and character:FindFirstChild("HumanoidRootPart")

                    if not hrp then
                        task.wait(0.2)
                        continue
                    end

                    -- Target tetap dikunci sampai mati / hilang
                    if target then
                        local mob = target.Parent
                        local humanoid = mob and mob:FindFirstChildOfClass("Humanoid")

                        if not mob
                            or not target:IsDescendantOf(workspace)
                            or (humanoid and humanoid.Health <= 0) then
                            target = nil
                        end
                    end

                    -- Cari target baru
                    if not target then
                        for _, obj in ipairs(workspace:GetDescendants()) do
                            if obj:IsA("Folder")
                                and obj.Name:match("^PayloadEnemies_") then

                                for _, mob in ipairs(obj:GetChildren()) do
                                    local mobHRP = mob:FindFirstChild("HumanoidRootPart")
                                    local humanoid = mob:FindFirstChildOfClass("Humanoid")

                                    if mobHRP
                                        and (not humanoid or humanoid.Health > 0) then
                                        target = mobHRP
                                        break
                                    end
                                end

                                if target then
                                    break
                                end
                            end
                        end
                    end

                    if target then
                        -- Buat attachment + constraints sekali
                        if not attachment or not attachment.Parent then
                            attachment = Instance.new("Attachment")
                            attachment.Parent = hrp

                            alignPos = Instance.new("AlignPosition")
                            alignPos.Mode = Enum.PositionAlignmentMode.OneAttachment
                            alignPos.Attachment0 = attachment
                            alignPos.MaxForce = math.huge
                            alignPos.MaxVelocity = math.huge
                            alignPos.Responsiveness = 80
                            alignPos.RigidityEnabled = true
                            alignPos.Parent = hrp

                            alignOri = Instance.new("AlignOrientation")
                            alignOri.Mode = Enum.OrientationAlignmentMode.OneAttachment
                            alignOri.Attachment0 = attachment
                            alignOri.MaxTorque = math.huge
                            alignOri.Responsiveness = 80
                            alignOri.RigidityEnabled = true
                            alignOri.Parent = hrp
                        end

                        -- 12 stud di atas mob
                        alignPos.Position =
                            target.Position + Vector3.new(0, 12, 0)

                        -- Hadap ke mob
                        local direction =
                            (target.Position - hrp.Position).Unit

                        alignOri.CFrame =
                            CFrame.lookAt(Vector3.zero, direction)

                        -- Attack
                        AttackRemote:FireServer(Vector3.zero)
                    end

                    task.wait(0.1)
                end

                -- Cleanup
                if alignPos then
                    alignPos:Destroy()
                end

                if alignOri then
                    alignOri:Destroy()
                end

                if attachment then
                    attachment:Destroy()
                end
            end)
        end
    end
})

