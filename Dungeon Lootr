GUI:CreateToggle({
    parent = main,
    text = "Orbit All Demon NPCs",
    default = true,

    callback = function(state)
        _G.OrbitDemonAll = state

        if not state then
            _G.OrbitDemonRunId = nil
            print("Orbit Demon: OFF")
            return
        end

        local runId = os.clock()
        _G.OrbitDemonRunId = runId

        task.spawn(function()
            local Players = game:GetService("Players")
            local player = Players.LocalPlayer

            local radius = 20
            local height = 12
            local speed = 1.8
            local angle = 0

            local function isRunning()
                return _G.OrbitDemonAll
                    and _G.OrbitDemonRunId == runId
            end

            -- Cari dungeon Demon dengan suffix random
            local function getCurrentFolder()
                for _, folder in ipairs(workspace:GetChildren()) do
                    if folder.Name:match("^Generated_Demon_")
                        and folder:FindFirstChild("Room_1") then
                        return folder
                    end
                end
                return nil
            end

            local function getTargetPart(npc)
                local part = npc:FindFirstChild(
                    "HumanoidRootPart", true
                )

                if part and part:IsA("BasePart") then
                    return part
                end

                if npc:IsA("Model") and npc.PrimaryPart then
                    return npc.PrimaryPart
                end

                return npc:FindFirstChildWhichIsA(
                    "BasePart", true
                )
            end

            -- Scan NPCs dan semua Room 1-24
            local function getTargets(folder)
                local result = {}
                local seen = {}

                local function scan(container)
                    if not container then return end

                    for _, npc in ipairs(container:GetChildren()) do
                        if npc:IsA("Model") and not seen[npc] then
                            local humanoid =
                                npc:FindFirstChildOfClass("Humanoid")
                            local part = getTargetPart(npc)

                            if part and part.Parent
                                and (not humanoid or humanoid.Health > 0) then
                                seen[npc] = true
                                table.insert(result, {
                                    model = npc,
                                    part = part
                                })
                            end
                        end
                    end
                end

                scan(folder:FindFirstChild("NPCs"))

                for i = 1, 24 do
                    local room = folder:FindFirstChild("Room_" .. i)
                    if room then
                        scan(room)
                        scan(room:FindFirstChild("NPCs", true))
                    end
                end

                return result
            end

            -- Cari titik teleport di dalam room
            local function findRoomDestination(room)
                if not room then return nil end

                local preferred = {
                    "SpawnLocation",
                    "RoomSpawn",
                    "Spawn",
                    "Entry",
                    "Entrance"
                }

                for _, name in ipairs(preferred) do
                    local obj = room:FindFirstChild(name, true)
                    if obj and obj:IsA("BasePart") then
                        return obj
                    end
                end

                return room:FindFirstChildWhichIsA(
                    "BasePart", true
                )
            end

            local function moveToRoom(folder, roomNumber)
                local room = folder:FindFirstChild(
                    "Room_" .. roomNumber
                )

                if not room then return false end

                local destination = findRoomDestination(room)
                if not destination then return false end

                local character = player.Character
                local hrp = character and character:FindFirstChild(
                    "HumanoidRootPart"
                )

                if not hrp then return false end

                hrp.CFrame = CFrame.new(
                    destination.Position + Vector3.new(0, 5, 0)
                )

                -- Tunggu NPC muncul atau room selesai dimuat
                for attempt = 1, 10 do
                    if not isRunning()
                        or getCurrentFolder() ~= folder then
                        return false
                    end

                    task.wait(0.3)

                    local targets = getTargets(folder)
                    if #targets > 0 then
                        return true
                    end
                end

                return false
            end

            print("Orbit Demon: ON")

            local roomIndex = 1

            while isRunning() do
                local folder = getCurrentFolder()

                if not folder then
                    task.wait(0.5)
                    continue
                end

                local targets = getTargets(folder)

                if #targets == 0 then
                    -- NPCs kosong: cari room berikutnya
                    moveToRoom(folder, roomIndex)

                    roomIndex = roomIndex + 1
                    if roomIndex > 24 then
                        roomIndex = 1
                    end

                    task.wait(0.2)
                    continue
                end

                -- Orbit setiap NPC yang ditemukan
                for _, target in ipairs(targets) do
                    if not isRunning()
                        or getCurrentFolder() ~= folder then
                        break
                    end

                    local npc = target.model
                    local startTime = os.clock()

                    while isRunning()
                        and getCurrentFolder() == folder
                        and npc.Parent
                        and os.clock() - startTime < 15 do

                        local character = player.Character
                        local hrp = character
                            and character:FindFirstChild(
                                "HumanoidRootPart"
                            )

                        if not hrp then
                            task.wait(0.2)
                            continue
                        end

                        local humanoid =
                            npc:FindFirstChildOfClass("Humanoid")

                        if humanoid and humanoid.Health <= 0 then
                            break
                        end

                        local currentPart = getTargetPart(npc)

                        if not currentPart or not currentPart.Parent then
                            break
                        end

                        angle = angle + speed * 0.03

                        local offset = Vector3.new(
                            math.cos(angle) * radius,
                            height,
                            math.sin(angle) * radius
                        )

                        local position = currentPart.Position + offset

                        hrp.CFrame = CFrame.lookAt(
                            position,
                            currentPart.Position
                        )

                        task.wait(0.03)
                    end
                end

                task.wait(0.2)
            end

            print("Orbit Demon: stopped")
        end)
    end
})

