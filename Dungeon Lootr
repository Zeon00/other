-- Cari folder Challenge
local function getChallengeFolder()
    return workspace:FindFirstChild("Challenge_NPCs")
end

-- Cari bagian fisik mob
local function getMobPart(mob)
    if mob:IsA("BasePart") then
        return mob
    end

    local root = mob:FindFirstChild("HumanoidRootPart", true)

    if root and root:IsA("BasePart") then
        return root
    end

    if mob:IsA("Model") and mob.PrimaryPart then
        return mob.PrimaryPart
    end

    return mob:FindFirstChildWhichIsA("BasePart", true)
end

-- Ambil semua mob yang belum mati
local function getMobs(folder)
    local mobs = {}

    for _, mob in ipairs(folder:GetChildren()) do
        if mob ~= player.Character then
            local part = getMobPart(mob)
            local humanoid = mob:FindFirstChildOfClass("Humanoid")

            if part and part.Parent
                and (not humanoid or humanoid.Health > 0) then

                table.insert(mobs, {
                    model = mob,
                    part = part,
                    humanoid = humanoid
                })
            end
        end
    end

    return mobs
end

-- Cari chest Mage dengan UUID yang berubah
local function getDungeonChest()
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj.Name:match("^DungeonChest_")
            and (obj:IsA("Model") or obj:IsA("BasePart")) then

            local part

            if obj:IsA("BasePart") then
                part = obj
            else
                part = obj.PrimaryPart
                    or obj:FindFirstChildWhichIsA("BasePart", true)
            end

            if part then
                return obj, part
            end
        end
    end

    return nil, nil
end

-- TP ke permukaan chest
local function touchChest(hrp)
    local chest, part = getDungeonChest()

    if not chest or not part or not part:IsDescendantOf(workspace) then
        return false
    end

    local character = player.Character
    if not character or not hrp.Parent then
        return false
    end

    local yOffset = part.Size.Y / 2
        + (hrp.Size.Y / 2)
        + 0.15

    hrp.CFrame = CFrame.new(
        part.Position + Vector3.new(0, yOffset, 0)
    )

    print("Challenge: TP ke chest", chest.Name)

    return true
end

