                            end
                        end

                        if _G.AutoSelectChest
                            and controller._active
                            and controller._selectedCount >= 2
                            and controller._finish
                            and controller._finish.Visible then

                            pcall(function()
                                controller:_OnFinish()
                            end)
                        end
                    end

                    task.wait(0.2)
                end
            end)
