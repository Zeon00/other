                                and targetPart:IsA("BasePart")
                                and (not humanoid or humanoid.Health > 0) then

                                local distance =
                                    (targetPart.Position - root.Position).Magnitude

                                if distance < nearestDistance
                                    and distance > 0.1 then
                                    nearestDistance = distance
                                    nearestPart = targetPart
                                end
                            end
                        end
                    end
                end
            end

            if nearestPart then
                local targetPosition = Vector3.new(
                    nearestPart.Position.X,
                    root.Position.Y,
                    nearestPart.Position.Z
                )

                root.CFrame = CFrame.lookAt(
                    root.Position,
                    targetPosition
                )
            end
        end)
    end
})

