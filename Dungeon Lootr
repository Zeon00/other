                    local folder = workspace:FindFirstChild("Raid_NPCs")
                    local boss = folder and folder:FindFirstChild("Dark Professor")
                    local target = boss and (
                        boss:FindFirstChild("HumanoidRootPart")
                        or boss:FindFirstChild("UpperTorso")
                        or boss:FindFirstChild("Torso")
                    )

                    local humanoid = boss and boss:FindFirstChildOfClass("Humanoid")

                    if hrp and target and (not humanoid or humanoid.Health > 0) then
                        if not attachment or attachment.Parent ~= hrp then
                            if alignPos then alignPos:Destroy() end
                            if alignOri then alignOri:Destroy() end
                            if attachment then attachment:Destroy() end

                            attachment = Instance.new("Attachment")
                            attachment.Parent = hrp

                            alignPos = Instance.new("AlignPosition")
                            alignPos.Mode = Enum.PositionAlignmentMode.OneAttachment
                            alignPos.Attachment0 = attachment
                            alignPos.MaxForce = math.huge
                            alignPos.MaxVelocity = 100
                            alignPos.Responsiveness = 40
                            alignPos.Parent = hrp

                            alignOri = Instance.new("AlignOrientation")
                            alignOri.Mode = Enum.OrientationAlignmentMode.OneAttachment
                            alignOri.Attachment0 = attachment
                            alignOri.MaxTorque = math.huge
                            alignOri.Responsiveness = 40
                            alignOri.Parent = hrp
                        end

                        local angle = os.clock() * 2
                        local radius = 20
                        local height = 20

                        alignPos.Position = target.Position + Vector3.new(
                            math.cos(angle) * radius,
                            height,
                            math.sin(angle) * radius
                        )

                        local direction = target.Position - hrp.Position
                        if direction.Magnitude > 0.01 then
                            alignOri.CFrame = CFrame.lookAt(
                                Vector3.zero,
                                direction.Unit
                            )
                        end
                    end

                    task.wait(0.05)
                end

                if alignPos then alignPos:Destroy() end
                if alignOri then alignOri:Destroy() end
                if attachment then attachment:Destroy() end
            end)
        end
    end
})

