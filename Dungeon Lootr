local AutoNextDepth = false
local NextDepthBusy = false

GUI:CreateToggle({
    parent = main,
    text = "Auto Next Depth",
    default = true,

    callback = function(state)
        AutoNextDepth = state

        if not state then
            return
        end

        task.spawn(function()
            while AutoNextDepth do
                local inTower =
                    player:GetAttribute("InBossRush")
                    and player:GetAttribute("BossRushRoute")

                local depth =
                    player:GetAttribute("TowerNextDepth")

                local spectating =
                    player:GetAttribute("IsSpectating")

                if inTower and depth and not spectating
                    and not NextDepthBusy then

                    NextDepthBusy = true

                    local ok, err = pcall(function()
                        local service =
                            Knit.GetService("InfiniteTowerService")

                        service:NextDepth(depth):catch(function(e)
                            warn("Auto Next Depth:", e)
                        end)
                    end)

                    if not ok then
                        warn("Auto Next Depth:", err)
                    end

                    task.wait(3)
                    NextDepthBusy = false
                end

                task.wait(0.5)
            end

            NextDepthBusy = false
        end)
    end
})

