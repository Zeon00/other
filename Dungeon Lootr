-- Cari folder Mage yang suffix-nya berubah
local function getMageFolder()
    for _, folder in ipairs(workspace:GetChildren()) do
        if folder.Name:match("^Generated_Mage_") then
            return folder
        end
    end
    return nil
end

-- Cari NPC hidup di semua Room_1 sampai Room_25
local function getMobs(mageFolder)
    local mobs = {}

    for roomNumber = 1, 25 do
        local room = mageFolder:FindFirstChild("Room_" .. roomNumber)

        if room then
            for _, obj in ipairs(room:GetDescendants()) do
                if obj:IsA("Model") then
                    local humanoid = obj:FindFirstChildOfClass("Humanoid")
                    local root = obj:FindFirstChild("HumanoidRootPart")

                    if humanoid
                        and humanoid.Health > 0
                        and root
                        and root:IsA("BasePart")
                        and obj ~= player.Character
                    then
                        table.insert(mobs, {
                            model = obj,
                            humanoid = humanoid,
                            root = root,
                            room = room
                        })
                    end
                end
            end
        end
    end

    return mobs
end

GUI:CreateToggle({
    parent = main,
    text = "TP Orbit All Mage Mobs",
    default = true,

    callback = function(state)
        _G.OrbitMageNPCs = state

        if orbitConnection then
            orbitConnection:Disconnect()
            orbitConnection = nil
        end

        currentTarget = nil
        lastSwitch = 0
        angle = 0

        if not state then
            return
        end

        orbitConnection = RunService.Heartbeat:Connect(function(dt)
            if not _G.OrbitMageNPCs then
                return
            end

            local character = player.Character
            local hrp = character
                and character:FindFirstChild("HumanoidRootPart")

            if not hrp then
                return
            end

            local mageFolder = getMageFolder()

            if not mageFolder then
                currentTarget = nil
                return
            end

            -- Scan ulang semua room agar NPC baru ikut ditemukan
            local mobs = getMobs(mageFolder)

            if #mobs == 0 then
                currentTarget = nil
                return
            end

            local now = os.clock()

            local function isTargetValid(target)
                if not target or not target.model
                    or not target.model.Parent
                    or not target.model:IsDescendantOf(mageFolder)
                    or not target.humanoid.Parent
                    or target.humanoid.Health <= 0
                    or not target.root.Parent
                then
                    return false
                end

                return true
            end

            local targetValid = isTargetValid(currentTarget)
            local targetIndex

            if targetValid then
                for i, mob in ipairs(mobs) do
                    if mob.model == currentTarget.model then
                        targetIndex = i
                        break
                    end
                end

                targetValid = targetIndex ~= nil
            end

            -- Target mati/hilang: segera pilih NPC hidup berikutnya
            if not targetValid then
                currentTarget = mobs[1]
                lastSwitch = now

            -- Target masih hidup: ganti setelah 5 detik
            elseif now - lastSwitch >= TARGET_SWITCH_DELAY then
                local nextIndex = (targetIndex % #mobs) + 1
                currentTarget = mobs[nextIndex]
                lastSwitch = now
            end

            if not isTargetValid(currentTarget) then
                currentTarget = nil
                return
            end

            angle = angle + dt * SPEED

            local center = currentTarget.root.Position

            local targetPosition = center + Vector3.new(
                math.cos(angle) * RADIUS,
                HEIGHT,
                math.sin(angle) * RADIUS
            )

            hrp.CFrame = CFrame.lookAt(
                targetPosition,
                center
            )
        end)
    end
})
