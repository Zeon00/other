GUI:CreateToggle({
    parent = main,
    text = "Auto Select 2 Chests",
    default = true,

    callback = function(state)
        _G.AutoSelectChest = state

        if state then
            task.spawn(function()
                local Players = game:GetService("Players")
                local ReplicatedStorage = game:GetService("ReplicatedStorage")
                local player = Players.LocalPlayer

                local chestUI = player:WaitForChild("PlayerGui")
                    :WaitForChild("Main")
                    :WaitForChild("HUD")
                    :WaitForChild("Chest_Selection")

