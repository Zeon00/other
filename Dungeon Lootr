                                    Vector3.zero,
                                    direction.Unit
                                )
                        end
                    end

                    task.wait(0.05)
                end

                -- Cleanup
                if alignPos then
                    alignPos:Destroy()
                end

                if alignOri then
                    alignOri:Destroy()
                end

                if attachment then
                    attachment:Destroy()
                end
            end)
        end
    end
})
