        end

        FaceMobConnection = RunService.Heartbeat:Connect(function()
            if not FaceMobEnabled then
                return
            end

            local player = Players.LocalPlayer
            local character = player.Character
            local root = character
                and character:FindFirstChild("HumanoidRootPart")

            if not root then
                return
            end

            local folders = {
                workspace:FindFirstChild("Raid_NPCs"),
                workspace:FindFirstChild("BossRush_NPCs"),
                workspace:FindFirstChild("HollowRealmRun")
                    and workspace.HollowRealmRun:FindFirstChild("NPCs")
            }

            -- Cari Generated_Mage yang aktif
            for _, folder in ipairs(workspace:GetChildren()) do
                if folder.Name:match("^Generated_Mage_") then
                    table.insert(folders, folder:FindFirstChild("NPCs"))

                    for i = 1, 25 do
                        local room = folder:FindFirstChild("Room_" .. i)
                        if room then
                            table.insert(folders, room)
                        end
                    end
                end
            end

            local nearestPart
            local nearestDistance = math.huge

            for _, folder in ipairs(folders) do
                if folder then
                    for _, mob in ipairs(folder:GetChildren()) do
                        if mob ~= character then
                            local humanoid =
                                mob:FindFirstChildOfClass("Humanoid")

                            local targetPart =
                                mob:FindFirstChild("HumanoidRootPart", true)
                                or mob.PrimaryPart

