local ORBIT_RADIUS = 37
local ORBIT_HEIGHT = 12
local ORBIT_SPEED = 2
local ATTACK_INTERVAL = 0.1
local SKILL_INTERVAL = 0.05
local TARGET_REFRESH = 0.8

local function running(id)
