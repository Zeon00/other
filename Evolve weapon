local function towerAlive(id)
    return Running and AutoTower and TowerRunId == id
end

local function stopTower()
    RiftRunActive = false
    AutoTower = false
    TowerRunId += 1
    TowerStatus = "Tower: OFF"
end

local function startTower()
    if not Running or AutoTower then return end

    if AutoDungeon or AutoHallow or AutoEclipse then
        TowerStatus = "Matikan mode dungeon lain dahulu!"
        return
    end

    AutoTower = true
    TowerRunId += 1

    local id = TowerRunId

    task.spawn(function()
        local function alive()
            return towerAlive(id)
        end

        while alive() do
            TowerStatus = "Teleport ke POS 1 Rift..."
            updateCharacter()
            if Root and (Root.Position - TOWER_POS1).Magnitude > TOWER_TOLERANCE then
                teleportPosition(TOWER_POS1)
                task.wait(0.35)
            end

            TowerStatus = "Menunggu posisi 1..."
            while alive() do
                updateCharacter()
                if Root and (Root.Position - TOWER_POS1).Magnitude <= TOWER_TOLERANCE then
                    break
                end
                task.wait(0.2)
            end

            if not alive() then break end

            TowerStatus = "Posisi 1 | Mematikan Skill + Orbit"

            if AutoSkill then stopSkill() end
            if AutoOrbit then stopOrbit() end

            TowerStatus = "Posisi 1 | Tunggu 2 detik..."
            task.wait(TOWER_WAIT)

            if not alive() then break end

            TowerStatus = "Teleport posisi 2..."

            if not teleportPosition(TOWER_POS2) then
                TowerStatus = "TP posisi 2 gagal!"
                task.wait(1)
                continue
            end

            TowerStatus = "Posisi 2 | Tunggu 2 detik..."
            task.wait(TOWER_WAIT)

            if not alive() then break end

            TowerStatus = "Mengaktifkan Skill + Orbit..."

            if not AutoSkill then startSkill() end
            if not AutoOrbit then startOrbit() end

            task.wait(0.2)

            if not alive() then break end

            TowerStatus = "Mengirim EnterDungeon RIFT 71..."

            local ok, result = pcall(function()
                return RequestRemote:InvokeServer(
                    "EnterDungeon",
                    "RIFT",
                    99
                )
            end)

            if not alive() then break end

            if not ok or result ~= true then
                TowerStatus = "RIFT gagal masuk: " .. tostring(result)
                RiftRunActive = false
                task.wait(2)
                continue
            end

            RiftRunActive = true
            TowerStatus = "RIFT aktif | Menunggu boss selesai..."

            -- Jangan anggap respawn ke POS 1 sebagai Rift selesai.
            -- Tunggu atribut Dungeon benar-benar false, lalu baru izinkan siklus berikutnya.
            while alive() do
                updateCharacter()
                if not Player:GetAttribute("Dungeon") then
                    break
                end
                task.wait(0.5)
            end

            RiftRunActive = false
            if not alive() then break end

            TowerStatus = "RIFT selesai | Kembali ke POS 1..."
            if Root and (Root.Position - TOWER_POS1).Magnitude > TOWER_TOLERANCE then
                teleportPosition(TOWER_POS1)
            end
            task.wait(1)
        end

        if TowerRunId == id then
            RiftRunActive = false
            AutoTower = false
            TowerStatus = "Tower: OFF"
        end
    end)
end

