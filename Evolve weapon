local function getDungeonProgress()
    local playerGui = Player:FindFirstChild("PlayerGui")
    local gameUI = playerGui and playerGui:FindFirstChild("GameUI")
    local dungeonBar = gameUI and gameUI:FindFirstChild("DungeonBar")
    local progress = dungeonBar and dungeonBar:FindFirstChild("Progress")
    local textFolder = progress and progress:FindFirstChild("Text")

    if not textFolder then
        return nil, nil, nil
    end

    local valueObject = textFolder:FindFirstChild("Value")
    local captionObject = textFolder:FindFirstChild("Caption")

    local rawText = valueObject and valueObject.Text or ""
    local caption = captionObject and captionObject.Text or ""

    local current, total = rawText:match("(%d+)%s*/%s*(%d+)")

    return tonumber(current), tonumber(total), caption
end


local function waitForProgressComplete(isAlive, statusCallback, useBeacon, dungeonName)
    dungeonName = dungeonName or SelectedDungeon
    local emptyStart = nil
    local lastTPTime = 0
    local encounterIndex = 1

    local encounterTarget = nil
    local waitingEncounterSpawn = false

    local function status(msg)
        if statusCallback then
            statusCallback(msg)
        end
    end

    local function findMonsterBeacon()
        -- Hallow: cek marker yang diminta user terlebih dahulu.
        -- Gunakan child index 12 jika masih tersedia, lalu fallback ke pencarian nama.
        local indexedContainer = Workspace:GetChildren()[12]
        if indexedContainer then
            local indexedBeacon = indexedContainer:FindFirstChild("MonsterBeacon")
            if indexedBeacon then
                if indexedBeacon:IsA("BasePart") or indexedBeacon:IsA("Model") then
                    return indexedBeacon
                end
                local nestedPart = indexedBeacon:FindFirstChildWhichIsA("BasePart", true)
                if nestedPart then
                    return nestedPart
                end
            end
        end

        for _, fx in ipairs(Workspace:GetChildren()) do
            if fx.Name == "ClientFX" then
                local candidate = fx:FindFirstChild("MonsterBeacon")

                if candidate and candidate:IsA("BasePart") then
                    local billboard = candidate:FindFirstChild("BillboardGui")
                    local hasDistanceText = false

                    if billboard then
                        for _, label in ipairs(billboard:GetDescendants()) do
                            if (label:IsA("TextLabel") or label:IsA("TextButton"))
                                and label.Text:match("%d+%s*m") then
                                hasDistanceText = true
                                break
                            end
                        end
                    end

                    if hasDistanceText then
                        return candidate
                    end
                end
            end
        end

        return nil
    end

    while isAlive() do
        -- CEK BOSS OPEN
        local playerGui = Player:FindFirstChild("PlayerGui")
        local gameUI = playerGui and playerGui:FindFirstChild("GameUI")
        local dungeonBar = gameUI and gameUI:FindFirstChild("DungeonBar")
        local progress = dungeonBar and dungeonBar:FindFirstChild("Progress")
        local textFolder = progress and progress:FindFirstChild("Text")
        local caption = textFolder and textFolder:FindFirstChild("Caption")

        if caption and caption:IsA("TextLabel") then
            local captionText = string.lower(
                (caption.Text or ""):match("^%s*(.-)%s*$")
            )

            local currentProgress, totalProgress = getDungeonProgress()
            local progressFinished = currentProgress ~= nil
                and totalProgress ~= nil
                and totalProgress > 0
                and currentProgress >= totalProgress

            if captionText == "open!" or captionText == "open" or progressFinished then
                status("Progress selesai / BOSS OPEN! Teleport FloorGlow...")
                return true
            end
        end

        if useBeacon then
            local enemyCount = getEnemyCount()

            if enemyCount > 0 then
                emptyStart = nil
                status("Enemies ditemukan! Melawan...")
            else
                emptyStart = emptyStart or os.clock()

                if os.clock() - emptyStart >= MOB_EMPTY_CONFIRM_TIME then
                    -- PRIORITAS 1: MONSTER BEACON
                    local beacon = findMonsterBeacon()

                    if beacon then
                        encounterTarget = nil
                        waitingEncounterSpawn = false

                        updateCharacter()

                        if Root then
                            local beaconPart = beacon:IsA("BasePart") and beacon
                                or (beacon:IsA("Model") and (beacon.PrimaryPart or beacon:FindFirstChildWhichIsA("BasePart", true)))
                            local distance = beaconPart and (Root.Position - beaconPart.Position).Magnitude or math.huge

                            if distance > 12 and os.clock() - lastTPTime >= 3 then
                                status("MonsterBeacon ditemukan! TP marker...")
                                teleportObject(beacon)
                                lastTPTime = os.clock()
                            else
                                status("MonsterBeacon aktif! Menunggu mob...")
                            end
                        end

                        emptyStart = nil

                    else
                        -- PRIORITAS 2: ENCOUNTER
                        local encounterName = "Encounter" .. encounterIndex

                        local encounter = getDungeonObject(
                            dungeonName,
                            {"Markers", encounterName}
                        )

                        if encounter then
                            if encounterTarget ~= encounter then
                                status("MonsterBeacon tidak ada! TP " .. encounterName .. "...")

                                if teleportObject(encounter) then
                                    encounterTarget = encounter
                                    waitingEncounterSpawn = true
                                    lastTPTime = os.clock()
                                    emptyStart = nil
                                else
                                    status("TP " .. encounterName .. " gagal!")
                                end
                            elseif waitingEncounterSpawn then
                                status("Menunggu mob muncul di " .. encounterName .. "...")

                                -- Jangan naik Encounter sebelum mob muncul.
                                emptyStart = nil
                            else
                                status("Menunggu Encounter berikutnya...")
                            end
                        else
                            status(encounterName .. " tidak ditemukan!")
                        end
                    end
                end
            end
        end

        -- Mob muncul di Encounter: mulai hitung sampai habis.
        if useBeacon and getEnemyCount() > 0 and waitingEncounterSpawn then
            waitingEncounterSpawn = false
            encounterIndex += 1
            emptyStart = nil
        end

        task.wait(0.15)
    end

    return false
end


--============================================================
-- DUNGEON VOID RECOVERY (NORMAL MOB PHASE ONLY)
-- Catat posisi aman setelah EnterDungeon berhasil.
-- Jika player jatuh jauh di bawah level lantai mob, kembalikan ke posisi aman.
-- Sengaja dimatikan sebelum TP FloorGlow dan tidak aktif saat boss.
--============================================================

local function stopDungeonVoidRecovery()
    DungeonVoidRecovery = false
    DungeonVoidRecoveryRunId += 1
    DungeonVoidSafeCFrame = nil
    DungeonVoidFloorY = nil
end

local function startDungeonVoidRecovery()
    stopDungeonVoidRecovery()
    DungeonVoidRecovery = true
    DungeonVoidRecoveryRunId += 1

    local runId = DungeonVoidRecoveryRunId
    updateCharacter()

    if Root then
        DungeonVoidSafeCFrame = Root.CFrame
        DungeonVoidFloorY = Root.Position.Y
    end

    task.spawn(function()
        local lastRecovery = 0

        while Running
            and DungeonVoidRecovery
            and DungeonVoidRecoveryRunId == runId
            and AutoDungeon
            and not DungeonBossPhase do

            updateCharacter()

            if Root and Root.Parent and Humanoid and Humanoid.Health > 0 then
                local position = Root.Position
                local velocity = Root.AssemblyLinearVelocity

                if DungeonVoidFloorY == nil then
                    DungeonVoidFloorY = position.Y
                    DungeonVoidSafeCFrame = Root.CFrame
                end

                -- Posisi yang masih berada di sekitar level lantai mob dianggap aman.
                -- Jangan simpan posisi saat sedang jatuh cepat.
                if position.Y >= DungeonVoidFloorY - 18 and velocity.Y > -24 then
                    DungeonVoidSafeCFrame = Root.CFrame
                end

                -- Ambang jatuh dihitung dari lantai dungeon mob saat recovery dimulai,
                -- bukan dari tinggi arena boss yang memang jauh lebih rendah.
                if position.Y < DungeonVoidFloorY - 38
                    and DungeonVoidSafeCFrame
                    and os.clock() - lastRecovery >= 2 then

                    lastRecovery = os.clock()
                    local safe = DungeonVoidSafeCFrame

                    pcall(function()
                        Root.AssemblyLinearVelocity = Vector3.zero
                        Root.AssemblyAngularVelocity = Vector3.zero
                        Root.CFrame = safe + Vector3.new(0, 4, 0)
                    end)

                    task.wait(0.25)
                end
            end

            task.wait(0.12)
        end
    end)
end

--============================================================
-- NORMAL DUNGEON
--============================================================

local function dungeonAlive(id)
    return Running and AutoDungeon and DungeonRunId == id
end

local function waitDungeonStart(id)
    DungeonStatus = "Teleport ke POS 1 Dungeon..."
    updateCharacter()
    if Root and (Root.Position - DUNGEON_START).Magnitude > DUNGEON_TOLERANCE then
        teleportPosition(DUNGEON_START)
        task.wait(0.35)
    end

    DungeonStatus = "Menunggu posisi 1..."
    while dungeonAlive(id) do
        updateCharacter()
        if Root and (Root.Position - DUNGEON_START).Magnitude <= DUNGEON_TOLERANCE then
            return true
        end
        task.wait(DUNGEON_WAIT_DELAY)
    end
    return false
end

local function walkDungeonEntry(id)
    DungeonStatus = SelectedDungeon .. " | Jalan kaki ke posisi 2..."

    local lastOrder = 0

    while dungeonAlive(id) do
        updateCharacter()

        if not Root or not Humanoid or Humanoid.Health <= 0 then
            return false
        end

        if (Root.Position - DUNGEON_ENTRY).Magnitude <= ENTRY_TOLERANCE then
            Humanoid:MoveTo(Root.Position)
            return true
        end

        if os.clock() - lastOrder >= 3 then
            Humanoid:MoveTo(DUNGEON_ENTRY)
            lastOrder = os.clock()
        end

        task.wait(0.1)
    end

    return false
end

local function stopDungeon()
    stopDungeonVoidRecovery()
    DungeonBossPhase = false
    AutoDungeon = false
    DungeonRunId += 1
    DungeonStatus = "Dungeon: OFF"
end

local function startDungeon()
    if not Running or AutoDungeon then return end

if AutoHallow or EclipsePriority or AutoTower then
    DungeonStatus = "Eclipse sedang prioritas / mode lain aktif!"
    return
end

    local name = DungeonNameInput and DungeonNameInput.Text or "Z3"
    name = string.upper(string.match(name, "^%s*(.-)%s*$") or "")

    if name == "" then
        DungeonStatus = "Isi nama dungeon!"
        return
    end

    SelectedDungeon = name
    AutoDungeon = true
    DungeonRunId += 1

    local id = DungeonRunId
    local combatWasOn = AutoCombat

    task.spawn(function()
        local function alive()
            return dungeonAlive(id)
        end

        local function status(message)
            DungeonStatus = name .. " | " .. message
        end

        local function restoreAfterExit()
            if not combatWasOn and AutoCombat then
                stopCombat()
            end

            if AutoOrbit then stopOrbit() end
            if AutoSkill then stopSkill() end
        end

        while alive() do
            if not waitDungeonStart(id) then break end

            if not walkDungeonEntry(id) then
                if not alive() then break end
                continue
            end

            updateCharacter()

            if not Root
                or (Root.Position - DUNGEON_ENTRY).Magnitude > ENTRY_TOLERANCE then
                continue
            end

            status("Posisi 2 tercapai, tunggu 2 detik...")
            task.wait(DUNGEON_BEFORE_REMOTE)

            if not alive() then break end

            updateCharacter()

            if not Root
                or (Root.Position - DUNGEON_ENTRY).Magnitude > ENTRY_TOLERANCE then
                status("Posisi 2 berubah, ulangi...")
                continue
            end

            status("EnterDungeon...")

            local ok, result = pcall(function()
                local count = math.max(
                    1,
                    math.floor(tonumber(DungeonCountInput.Text) or 3)
                )

                return RequestRemote:InvokeServer("EnterDungeon", name, count)
            end)

            if not alive() then break end

            if not ok or result ~= true then
                status("EnterDungeon gagal: " .. tostring(result))
                task.wait(2)
                continue
            end

            -- Remote EnterDungeon sukses: recovery ON khusus map mob biasa.
            DungeonBossPhase = false
            startDungeonVoidRecovery()
            status("Masuk dungeon! Void Recovery ON | Menunggu progress selesai...")

            if not AutoOrbit then startOrbit() end
            if not AutoSkill then startSkill() end
            if not AutoCombat then startCombat() end

            if not waitForProgressComplete(alive, status, true) then
                break
            end

            if not alive() then break end

            -- Progress mob selesai: matikan recovery SEBELUM menuju FloorGlow.
            -- Tetap OFF sepanjang fase boss; hanya dinyalakan lagi setelah EnterDungeon
            -- sukses pada putaran dungeon berikutnya.
            stopDungeonVoidRecovery()
            status("Progress selesai | Void Recovery OFF. Mencari FloorGlow...")

            local glow = getDungeonObject(name, {
                "BossDoor",
                "FloorGlow"
            })

            if not glow then
                status("FloorGlow tidak ditemukan!")
                break
            end

            DungeonBossPhase = true
            if not teleportObject(glow) then
                DungeonBossPhase = false
                status("Teleport FloorGlow gagal!")
                break
            end

            status("Teleport FloorGlow berhasil!")
            task.wait(DUNGEON_AFTER_FLOOR)

            if not alive() then break end

            if not waitForDungeonBossClear(alive, status, 10) then
                break
            end

            DungeonBossPhase = false
            if not alive() then break end

            status("Boss clear | konfirmasi area sebelum BossExit...")
            task.wait(DUNGEON_BEFORE_EXIT)

            if not alive() then break end

            if getEnemyCount() > 0 then
                status("Mob muncul lagi, menunggu sampai clear...")
                if not waitForDungeonBossClear(alive, status, 0) then
                    break
                end
                if not alive() then break end
            end

            local exit = getDungeonObject(name, {
                "Markers",
                "BossExit"
            })

            if not exit then
                status("BossExit tidak ditemukan!")
                break
            end

            status("Teleport BossExit...")

            if not teleportObject(exit) then
                status("TP BossExit gagal!")
                break
            end

            restoreAfterExit()

            status("Dungeon selesai!")
            task.wait(1)
        end

        if DungeonRunId == id then
            stopDungeonVoidRecovery()
            DungeonBossPhase = false
            if not combatWasOn and AutoCombat then
                stopCombat()
            end

            if AutoOrbit then stopOrbit() end
            if AutoSkill then stopSkill() end

            AutoDungeon = false
            DungeonStatus = "Dungeon: OFF"
        end
    end)
end

