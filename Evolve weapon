local function startCombat()
    if not Running or AutoCombat then return end

    AutoCombat = true

    task.spawn(function()
        while Running and AutoCombat do
            local mob = getTarget()

            if not Running or not AutoCombat then break end

            if mob and mob.Parent then
                SwingIndex = (SwingIndex % 3) + 1

                pcall(function()
                    SwingRemote:FireServer(SwingIndex)
