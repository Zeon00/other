                if mob.Parent and not isDead(mob) then
                    pcall(function()
                        HitRemote:FireServer(SwingIndex, 1, {mob})
                    end)
                end

                task.wait(HIT_DELAY)
            else
                task.wait(0.1)
            end
        end
    end)
end

