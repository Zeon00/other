local function waitForEnemyAppear(isAlive, statusCallback, timeout)
    if statusCallback then
        statusCallback("Menunggu mob muncul...")
    end

    local deadline = timeout and (os.clock() + timeout) or nil

    while isAlive() do
        if getEnemyCount() > 0 then
            return true
        end

        if deadline and os.clock() >= deadline then
            return false
        end

        task.wait(0.2)
    end

    return false
end

local function waitForEnemyClear(isAlive, statusCallback)
    if statusCallback then
        statusCallback("Menunggu Enemies kosong selama 2 detik...")
    end

    while isAlive() do
        if getEnemyCount() == 0 then
            local emptyStart = os.clock()
            local stayedEmpty = true

            while isAlive() and os.clock() - emptyStart < 2 do
                if getEnemyCount() > 0 then
                    stayedEmpty = false
                    break
                end

                task.wait(0.1)
            end

            if not isAlive() then
                return false
            end

            if stayedEmpty and getEnemyCount() == 0 then
                return true
            end
        else
            if statusCallback then
                statusCallback("Boss / mob masih ada, menunggu...")
            end

            task.wait(0.1)
        end
    end

    return false
end

