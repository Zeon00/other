--============================================================
-- ANTI VOID | NORMAL AUTO DUNGEON ONLY
-- Update titik aman saat berada di lantai.
-- Rescue jika karakter jatuh ke jurang.
--============================================================

local function stopAntiVoid()
    AntiVoidRunId += 1

    if AntiVoidConnection then
        pcall(function()
            AntiVoidConnection:Disconnect()
        end)
        AntiVoidConnection = nil
    end

    AntiVoidSafeCFrame = nil
    AntiVoidLastRescue = 0
end

local function startAntiVoid(isAlive)
    stopAntiVoid()

    local runId = AntiVoidRunId

    task.spawn(function()
        local deadline = os.clock() + 10
        local rayParams = RaycastParams.new()

        rayParams.FilterType = Enum.RaycastFilterType.Exclude

        -- Tunggu karakter mendapatkan posisi lantai yang valid.
        repeat
            if not isAlive() or AntiVoidRunId ~= runId then
                return
            end

            updateCharacter()

            if Root and Root.Parent then
                rayParams.FilterDescendantsInstances = {Character}

                local ground = Workspace:Raycast(
                    Root.Position,
                    Vector3.new(0, -12, 0),
                    rayParams
                )

                if ground then
                    AntiVoidSafeCFrame = Root.CFrame
                    break
                end
            end

            task.wait(0.2)
        until os.clock() >= deadline

        if not isAlive() or AntiVoidRunId ~= runId then
            return
        end

        if not AntiVoidSafeCFrame then
            warn("[ANTI VOID] Posisi lantai aman belum ditemukan!")
            return
        end

        AntiVoidLastRescue = 0
        local lastSafeUpdate = 0

        AntiVoidConnection = RunService.Heartbeat:Connect(function()
            if not isAlive() or AntiVoidRunId ~= runId then
                stopAntiVoid()
                return
            end

            updateCharacter()

            if not Root or not Root.Parent or not AntiVoidSafeCFrame then
                return
            end

            rayParams.FilterDescendantsInstances = {Character}

            local ground = Workspace:Raycast(
                Root.Position,
                Vector3.new(0, -10, 0),
                rayParams
            )

            -- Simpan posisi terbaru hanya jika lantai terdeteksi dekat.
            if ground and os.clock() - lastSafeUpdate >= 0.25 then
                AntiVoidSafeCFrame = Root.CFrame
                lastSafeUpdate = os.clock()
            end

            -- Rescue jika jatuh terlalu jauh dari titik aman.
            local safeY = AntiVoidSafeCFrame.Position.Y

            if Root.Position.Y < safeY - ANTI_VOID_FALL_DISTANCE
                and os.clock() - AntiVoidLastRescue >= ANTI_VOID_RESCUE_COOLDOWN then

                AntiVoidLastRescue = os.clock()

                pcall(function()
                    Root.CFrame = AntiVoidSafeCFrame + Vector3.new(0, 5, 0)
                    Root.AssemblyLinearVelocity = Vector3.zero
                    Root.AssemblyAngularVelocity = Vector3.zero
                end)
            end
        end)
    end)
end

