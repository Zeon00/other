    AutoTP = true
    TPRunId += 1

    local id = TPRunId

    task.spawn(function()
        while Running and AutoTP and TPRunId == id do
            updateCharacter()

            if not Root or not Humanoid or Humanoid.Health <= 0 then
                task.wait(0.2)
                continue
            end

            local mob = getTPTarget()

            if mob and mob.Parent and not isDead(mob) then
                local mobRoot = getMobRoot(mob)

                if mobRoot then
                    local behind = mobRoot.CFrame:PointToWorldSpace(
                        Vector3.new(0, 0, TP_BEHIND_DISTANCE)
                    )

                    local targetCF = CFrame.lookAt(behind, mobRoot.Position)

                    if Running and AutoTP and TPRunId == id then
                        pcall(function()
                            Root.CFrame = targetCF
                        end)
                    end
                end
            end

            task.wait(TP_UPDATE_DELAY)
        end
    end)
end

