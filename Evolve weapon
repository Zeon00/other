            end

            if not alive() then break end

            TowerStatus = "Posisi 1 | Mematikan Skill + Orbit"

            if AutoSkill then stopSkill() end
            if AutoOrbit then stopOrbit() end

            TowerStatus = "Posisi 1 | Tunggu 2 detik..."
            task.wait(TOWER_WAIT)

            if not alive() then break end

            TowerStatus = "Teleport posisi 2..."

            if not teleportPosition(TOWER_POS2) then
                TowerStatus = "TP posisi 2 gagal!"
                task.wait(1)
                continue
            end

            TowerStatus = "Posisi 2 | Tunggu 2 detik..."
            task.wait(TOWER_WAIT)

            if not alive() then break end

            TowerStatus = "Mengaktifkan Skill + Orbit..."

            if not AutoSkill then startSkill() end
            if not AutoOrbit then startOrbit() end

            task.wait(0.2)

            if not alive() then break end

            TowerStatus = "Mengirim EnterDungeon RIFT 71..."

            local ok, result = pcall(function()
                return RequestRemote:InvokeServer(
                    "EnterDungeon",
                    "RIFT",
                    71
                )
