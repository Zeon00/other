--============================================================
-- UNIVERSAL TOGGLE SYSTEM
-- Tambah fitur baru cukup: addToggle("NAMA", false, function(state) ... end)
--============================================================

local ToggleRegistry = {}

local function setToggleVisual(toggle)
    toggle.button.Text = toggle.name .. " : " .. (toggle.state and "ON" or "OFF")
    toggle.button.BackgroundColor3 = toggle.state
        and Color3.fromRGB(45, 125, 75)
        or Color3.fromRGB(48, 48, 62)
end

local function addToggle(name, defaultState, callback)
    local button = Instance.new("TextButton")
    button.Size = UDim2.new(1, -4, 0, 39)
    button.BackgroundColor3 = Color3.fromRGB(48, 48, 62)
    button.TextColor3 = Color3.new(1, 1, 1)
    button.Font = Enum.Font.GothamBold
    button.TextSize = 11
    button.AutoButtonColor = true
    button.Parent = Scroll

    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 7)
    corner.Parent = button

    local toggle = {name = name, state = defaultState == true, button = button}
    table.insert(ToggleRegistry, toggle)
    setToggleVisual(toggle)

    button.Activated:Connect(function()
        if not Running then return end
        toggle.state = not toggle.state
        setToggleVisual(toggle)
        local ok, err = pcall(callback, toggle.state)
        if not ok then warn("[Toggle " .. name .. "] " .. tostring(err)) end
    end)

    if toggle.state then
        task.spawn(function()
            local ok, err = pcall(callback, true)
            if not ok then warn("[Toggle " .. name .. "] " .. tostring(err)) end
        end)
    end

    return toggle
end

-- Read the REAL automation flags every refresh.
-- This mirrors the old working setButton(..., AutoFeature) approach.
local function getActualToggleState(name)
    if name == "AUTO SWING + HIT" then return AutoCombat end
    if name == "AUTO SKILL" then return AutoSkill end
    if name == "ORBIT + HOVER" then return AutoOrbit end
    if name == "TP BEHIND MOB" then return AutoTP end
    if name == "AUTO DUNGEON" then return AutoDungeon end
    if name == "AUTO ECLIPSE" then return AutoEclipse end
    if name == "AUTO HALLOW" then return AutoHallow end
    if name == "AUTO CLAIM ALL REWARDS" then return AutoClaim end
    if name == "AUTO TOWER" then return AutoTower end
    if name == "AUTO ENCHANT" then return AutoEnchant end
    if name == "AUTO CANDY SHOP" then return AutoCandyShop end
    if name == "AUTO REBIRTH" then return AutoRebirth end
    return false
end

local function refreshToggles()
    for _, toggle in ipairs(ToggleRegistry) do
        toggle.state = getActualToggleState(toggle.name) == true
        setToggleVisual(toggle)
    end
end

