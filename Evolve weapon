local function getObjectCFrame(object)
    if not object then return nil end

    if object:IsA("BasePart") then
        return object.CFrame
    end

    if object:IsA("Model") then
        return object:GetPivot()
    end

    local part = object:FindFirstChildWhichIsA("BasePart", true)

    return part and part.CFrame or nil
end

local function teleportObject(object)
    local cf = getObjectCFrame(object)

    if not cf then return false end

    updateCharacter()

    if not Root then return false end

    return pcall(function()
        Root.CFrame = cf + Vector3.new(0, 3, 0)
    end)
end

local function teleportPosition(position)
    updateCharacter()

    if not Root then return false end

    return pcall(function()
        Root.CFrame = CFrame.new(position + Vector3.new(0, 3, 0))
    end)
end

local function getDungeonObject(name, path)
    local current = Workspace:FindFirstChild("Dungeons")

    if not current then return nil end

    current = current:FindFirstChild(name)

    if not current then return nil end

    for _, childName in ipairs(path) do
        current = current:FindFirstChild(childName)

        if not current then return nil end
    end

    return current
end

--============================================================
-- ECLIPSE DUNGEON OBJECT FINDER
--============================================================

local function getEclipseDungeonObject(config, attribute, path)
    local names = {}

    local function addName(value)
        if value == nil then return end

        local name = tostring(value)

        if name ~= "" then
            for _, existing in ipairs(names) do
                if existing == name then
                    return
                end
            end

            table.insert(names, name)
        end
    end

    addName(config and config.Name)
    addName(config and config.Dungeon)
    addName(config and config.Id)
    addName(attribute)

    for _, name in ipairs(names) do
        local object = getDungeonObject(name, path)

        if object then
            return object
        end
    end

    -- Fallback: cari dungeon yang punya struktur BossDoor / Markers
    local folders = Workspace:FindFirstChild("Dungeons")

    if folders then
        for _, dungeon in ipairs(folders:GetChildren()) do
            local current = dungeon

            for _, childName in ipairs(path) do
                current = current and current:FindFirstChild(childName)
            end

            if current then
                return current
            end
        end
    end

    return nil
end

--============================================================
-- SHARED ENEMY WAIT HELPERS
--============================================================

local function waitForEnemyAppear(isAlive, statusCallback, timeout)
    if statusCallback then
        statusCallback("Menunggu mob muncul...")
    end

    local deadline = timeout and (os.clock() + timeout) or nil

    while isAlive() do
        if getEnemyCount() > 0 then
            return true
        end

        if deadline and os.clock() >= deadline then
            return false
        end

        task.wait(0.2)
    end

    return false
end

local function waitForEnemyClear(isAlive, statusCallback)
    if not waitForEnemyAppear(isAlive, statusCallback) then
        return false
    end

    if statusCallback then
        statusCallback("Menunggu mob habis...")
    end

    while isAlive() do
        if getEnemyCount() == 0 then
            local start = os.clock()
            local empty = true

            while isAlive() and os.clock() - start < MOB_EMPTY_CONFIRM_TIME do
                if getEnemyCount() > 0 then
                    empty = false
                    break
                end

                task.wait(0.1)
            end

            if empty and getEnemyCount() == 0 then
                return true
            end
        end

        task.wait(0.1)
    end

    return false
end

-- Boss can die in one hit between polling ticks. Do not require observing
-- a living boss first; allow its spawn window, then confirm Enemies is empty.
local function waitForDungeonBossClear(isAlive, statusCallback, spawnGrace)
    local startedAt = os.clock()
    local emptySince = nil
    local seenEnemy = false
    spawnGrace = tonumber(spawnGrace) or 10

    while isAlive() do
        local now = os.clock()
        local count = getEnemyCount()

        if count > 0 then
            seenEnemy = true
            emptySince = nil
            if statusCallback then
                statusCallback("Boss / mob terdeteksi | menunggu clear...")
            end
        else
            emptySince = emptySince or now
            if now - emptySince >= MOB_EMPTY_CONFIRM_TIME
                and (seenEnemy or now - startedAt >= spawnGrace) then
                return true
            end
        end

        task.wait(0.1)
    end

    return false
end

