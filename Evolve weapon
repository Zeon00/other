local function hallowStartRiftToastWatcher(id)
    local found = false
    local closed = false
    local connections = {}
    local phrase = "step into the rift to go home"

    local function isActuallyVisible(instance)
        local current = instance
        while current do
            if current:IsA("GuiObject") and not current.Visible then
                return false
            end
            if current:IsA("ScreenGui") and not current.Enabled then
                return false
            end
            current = current.Parent
        end
        return true
    end

    local function inspect(instance, isNew)
        if found or closed or not instance then return end
        if not (instance:IsA("TextLabel") or instance:IsA("TextButton")) then return end

        local function checkText()
            if found or closed or not hallowAlive(id) then return end
            if not isActuallyVisible(instance) then return end
            local textValue = string.lower((instance.Text or ""):match("^%s*(.-)%s*$"))
            if textValue:find(phrase, 1, true) then
                found = true
            end
        end

        -- Toast baru bisa berupa GUI baru atau perubahan Text/Visible pada GUI yang sudah ada.
        -- Teks lama yang sudah tampil sebelum watcher dimulai tidak dianggap sebagai toast boss.
        if isNew then checkText() end
        table.insert(connections, instance:GetPropertyChangedSignal("Text"):Connect(checkText))
        table.insert(connections, instance:GetPropertyChangedSignal("Visible"):Connect(checkText))
        local screenGui = instance:FindFirstAncestorOfClass("ScreenGui")
        if screenGui then
            table.insert(connections, screenGui:GetPropertyChangedSignal("Enabled"):Connect(checkText))
        end
    end

    local function watch(container)
        if not container then return end
        for _, descendant in ipairs(container:GetDescendants()) do
            inspect(descendant, false)
        end
        table.insert(connections, container.DescendantAdded:Connect(function(descendant)
            inspect(descendant, true)
        end))
    end

    local playerGui = Player:FindFirstChild("PlayerGui")
    watch(playerGui)
    pcall(function() watch(CoreGui) end)

    HallowStatus = "HALLOW | Listener toast rift aktif, menunggu boss..."

    local function disconnect()
        if closed then return end
        closed = true
        for _, connection in ipairs(connections) do
            pcall(function() connection:Disconnect() end)
        end
        table.clear(connections)
    end

    local function waitForToast()
        -- task.wait hanya menjaga loop hidup; deteksi teks dilakukan langsung oleh event listener,
        -- jadi toast yang muncul sangat singkat tetap tertangkap.
        while hallowAlive(id) and not found do
            task.wait(0.1)
        end
        local result = found and hallowAlive(id)
        disconnect()
        return result
    end

    return waitForToast, disconnect
end

