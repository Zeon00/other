-- CENTRAL CLEANUP
--============================================================

function Controller.Cleanup()
    if not Running then return end

    Running = false

    AutoCombat = false
    AutoSkill = false
    AutoOrbit = false
    AutoTP = false
    AutoDungeon = false
    AutoEclipse = false
    AutoHallow = false
    AutoClaim = false
    AutoTower = false
    AutoEnchant = false
    AutoCandyShop = false

    OrbitRunId += 1
    TPRunId += 1
    DungeonRunId += 1
    stopAntiVoid()
    EclipseRunId += 1
    HallowRunId += 1
    ClaimRunId += 1
    TowerRunId += 1
    EnchantRunId += 1
    CandyShopRunId += 1

    releaseAllKeys()
    cleanupHover()

    for _, connection in ipairs(Connections) do
        pcall(function()
            connection:Disconnect()
        end)
    end

    table.clear(Connections)

    if Gui then
        pcall(function()
            Gui:Destroy()
        end)

        Gui = nil
    end

    if _G.AF_SwingSkillOrbitController == Controller then
        _G.AF_SwingSkillOrbitController = nil
    end
end

Close.Activated:Connect(function()
    Controller.Cleanup()
end)

