local stopHallow
local pauseHallowForEclipse

--============================================================
-- AUTO ECLIPSE | DIRECT TP UMBRA
-- TP UMBRA -> ORBIT + SKILL -> LEAVE -> REPEAT
--============================================================

local function eclipseAlive(id)
    return Running and AutoEclipse and EclipseRunId == id
end

local function getCurrentEclipse()
    local attribute = Workspace:GetAttribute("EclipseDungeon")

    if not attribute then
        return nil, nil
    end

    local success, config = pcall(function()
        return DungeonConfig.get(attribute)
    end)

    if not success or not config or not config.Id then
        return nil, attribute
    end

    return config, attribute
end

local function findUmbra()
    local enemies = Workspace:FindFirstChild("Enemies")

    if not enemies then
        return nil
    end

    for _, mob in ipairs(enemies:GetChildren()) do
        if mob:IsA("Model")
            and mob.Name == "Umbra the Sun-Eater"
            and not isDead(mob) then

            return mob
        end
    end

    return nil
end

local function teleportToUmbra(mob)
    if not mob or not mob.Parent or isDead(mob) then
        return false
    end

    updateCharacter()

    if not Root then
        return false
    end

    local mobRoot = getMobRoot(mob)

    if not mobRoot then
        return false
    end

    return pcall(function()
        local destination = mobRoot.CFrame * CFrame.new(0, 0, 5)

        Root.CFrame = CFrame.lookAt(
            destination.Position,
            mobRoot.Position
        )
    end)
end

local function leaveEclipseDungeon()
    local enemies = Workspace:FindFirstChild("Enemies")

    -- Pastikan folder Enemies tersedia
    if not enemies then
        return false
    end

    -- Pastikan Umbra benar-benar sudah hilang
    if enemies:FindFirstChild("Umbra the Sun-Eater") then
        return false
    end

    local event = ReplicatedStorage
        :WaitForChild("SwordShared")
        :WaitForChild("Remotes")
        :WaitForChild("Request")

    local success, result = pcall(function()
        return event:InvokeServer("LeaveDungeon")
    end)

    return success, result
end

local function stopEclipse()
    AutoEclipse = false
    EclipseRunId += 1
    EclipseDungeonEntered = false

    EclipseTarget = nil

    if AutoOrbit then
        stopOrbit()
    end

    if AutoSkill then
        stopSkill()
    end

    EclipseStatus = "Eclipse: OFF"
end

local function startEclipse()
    if not Running or AutoEclipse then
        return
    end

    if AutoTower then
        EclipseStatus = "Matikan Tower dahulu!"
        return
    end

    AutoEclipse = true
    EclipseRunId += 1

    local id = EclipseRunId

    task.spawn(function()
        local function alive()
            return eclipseAlive(id)
        end

        local function status(message)
            EclipseStatus = "ECLIPSE | " .. message
        end

        local function waitDungeonEntry()
            status("Menunggu masuk dungeon...")

            while alive() do
                if Player:GetAttribute("Dungeon") then
                    return true
                end

                task.wait(0.2)
            end

            return false
        end

        local function waitDungeonExit()
            status("Menunggu keluar dungeon...")

            while alive() do
                if not Player:GetAttribute("Dungeon") then
                    return true
                end

                task.wait(0.25)
            end

            return false
        end

        local function waitUmbra()
            status("Menunggu Umbra the Sun-Eater...")

            while alive() do
                if not Player:GetAttribute("Dungeon") then
                    return nil
                end

                local mob = findUmbra()

                if mob then
                    return mob
                end

                task.wait(0.2)
            end

            return nil
        end

    while alive() do
    local config, attribute = getCurrentEclipse()

    -- Jika Eclipse sudah selesai / tidak tersedia lagi, lanjutkan Hallow.
    -- AutoEclipse boleh tetap ON untuk memantau Eclipse berikutnya; itu tidak
    -- boleh menghalangi worker Hallow berjalan di sela-sela event Eclipse.
    if not config
        and not EclipseDungeonEntered
        and not Player:GetAttribute("Dungeon")
        and AutoHallow
        and ResumeHallowAfterEclipse
        and not HallowWorkerActive then

        ResumeHallowAfterEclipse = false
        status("Eclipse selesai! Melanjutkan Auto Hallow dari POS 1...")
        task.wait(1)
        if alive() and AutoHallow and not HallowWorkerActive then
            startHallow(true)
        end
    end

    --====================================================
    -- ECLIPSE PRIORITY: POTONG DUNGEON YANG SEDANG JALAN
    --====================================================

    -- Selama konfigurasi Eclipse tersedia, blokir mode dungeon lain.
    if config then
        EclipsePriority = true
    end

    -- Eclipse mengambil prioritas atas Hallow yang sedang aktif.
    -- Simpan statusnya, lalu hentikan worker Hallow agar tidak bentrok.
    if config and AutoHallow then
        ResumeHallowAfterEclipse = true
        -- Pause hanya sekali saat worker memang sedang berjalan.
        -- Jangan menaikkan HallowRunId berulang kali setiap polling Eclipse.
        if HallowWorkerActive then
            status("ECLIPSE TERSEDIA! Pause worker Hallow (toggle tetap ON)...")
            pauseHallowForEclipse()
            task.wait(0.25)
        end
    end

    -- Auto Dungeon juga dihentikan sementara jika Eclipse tersedia.
    if config and AutoDungeon then
        ResumeDungeonAfterEclipse = true
        EclipsePriority = true
        status("ECLIPSE TERSEDIA! Menghentikan Auto Dungeon...")
        stopDungeon()
    end

    if Player:GetAttribute("Dungeon") then

        -- Jangan pernah mengeluarkan player dari Eclipse yang sedang berjalan.
        -- LeaveDungeon hanya untuk dungeon LAIN sebelum masuk Eclipse.
        if config and not EclipseDungeonEntered then
            status("ECLIPSE TERSEDIA! Keluar dari dungeon aktif...")

            ResumeDungeonAfterEclipse = ResumeDungeonAfterEclipse or AutoDungeon
            EclipsePriority = true

            if AutoDungeon then
                stopDungeon()
            end

            -- Leave dungeon menggunakan remote
            status("Memanggil LeaveDungeon untuk prioritas Eclipse...")

            local leaveOK, leaveResult = pcall(function()
                return RequestRemote:InvokeServer("LeaveDungeon")
            end)

            if not leaveOK then
                status("Leave dungeon error: " .. tostring(leaveResult))

                EclipsePriority = false

                if ResumeDungeonAfterEclipse and alive() then
                    ResumeDungeonAfterEclipse = false
                    task.wait(1)
                    startDungeon()
                end

                task.wait(3)
                continue
            end

            -- Tunggu sampai benar-benar keluar
            local leaveDeadline = os.clock() + 20

            while alive()
                and Player:GetAttribute("Dungeon")
                and os.clock() < leaveDeadline do

                task.wait(0.2)
            end

            if not alive() then break end

            if Player:GetAttribute("Dungeon") then
                status("Leave belum berhasil! Mencoba lagi...")

                EclipsePriority = false

                if ResumeDungeonAfterEclipse then
                    ResumeDungeonAfterEclipse = false
                    task.wait(1)
                    startDungeon()
                end

                task.wait(3)
                continue
            end

            status("Berhasil keluar! OTW Eclipse...")

        else
            status("Masih di dungeon, menunggu Eclipse...")
            task.wait(0.5)
            continue
        end
    end

    if not config then
        status("Menunggu EclipseDungeon...")
        task.wait(1)
        continue
    end

    --====================================================
    -- LANJUT MASUK ECLIPSE
    --====================================================

    status("Eclipse ditemukan: " .. tostring(attribute))
    task.wait(0.5)

    if not alive() then
        break
    end

    if Player:GetAttribute("Dungeon") then
        continue
    end

            local config, attribute = getCurrentEclipse()

            if not config then
                status("Menunggu EclipseDungeon...")
                task.wait(1)
                continue
            end

            status("Eclipse ditemukan: " .. tostring(attribute))
            task.wait(1)

            if not alive() then
                break
            end

            if Player:GetAttribute("Dungeon") then
                continue
            end

            status("Memanggil EclipseEnter...")

            local ok, result = pcall(function()
                return PlayerState.request("EclipseEnter", config.Id)
            end)

            if not alive() then
                break
            end

            if not ok then
                status("Enter error: " .. tostring(result))
                task.wait(3)
                continue
            end

            status("Request terkirim: " .. tostring(result))

            if not waitDungeonEntry() then
                break
            end

            if not alive() then
                break
            end

            -- Tandai bahwa dungeon aktif sekarang adalah Eclipse.
            -- Loop berikutnya tidak boleh memanggil LeaveDungeon lagi.
            EclipseDungeonEntered = true
            status("Berhasil masuk Eclipse! Mencari Umbra...")

            local umbra = waitUmbra()

            if not alive() then
                break
            end

            if not umbra then
                status("Umbra tidak ditemukan / dungeon berakhir.")
                waitDungeonExit()
                task.wait(1)
                continue
            end

            -- KUNCI TARGET ORBIT KE UMBRA
            EclipseTarget = umbra
            CurrentDungeonTarget = umbra

            status("Umbra ditemukan! TP langsung...")

            if not teleportToUmbra(umbra) then
                status("TP Umbra gagal, mencoba ulang...")

                for _ = 1, 10 do
                    if not alive() or isDead(umbra) then
                        break
                    end

                    if teleportToUmbra(umbra) then
                        break
                    end

                    task.wait(0.3)
                end
            end

            if not alive() then
                break
            end

            -- ORBIT AKTIF KHUSUS KE UMBRA
            status("Mengaktifkan Orbit + Skill...")

            if AutoOrbit then
                stopOrbit()
            end

            startOrbit()

            if not AutoSkill then
                startSkill()
            end

            -- TUNGGU UMBRA MATI / HILANG
            status("Orbit + Skill sampai Umbra mati...")

            while alive()
                and umbra.Parent
                and not isDead(umbra) do

                task.wait(0.2)
            end

            if not alive() then
                break
            end

            -- UMBRA MATI
            status("Umbra hilang! Mematikan Orbit + Skill...")

EclipseTarget = nil
CurrentDungeonTarget = nil

if AutoOrbit then stopOrbit() end
