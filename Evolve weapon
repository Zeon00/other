        -- Update status jika label tersedia
        if Status then
            pcall(function()
                local mob = getTarget()
                local count = #getAllMobs()

                if AutoEclipse then
                    Status.Text = EclipseStatus .. " | Mobs: " .. count
                elseif AutoHallow then
                    Status.Text = HallowStatus .. " | Mobs: " .. count
                elseif AutoDungeon then
                    Status.Text = DungeonStatus .. " | Mobs: " .. count
                elseif AutoTower then
                    Status.Text = TowerStatus .. " | Mobs: " .. count
                elseif AutoClaim then
                    Status.Text = ClaimStatus
                elseif AutoRebirth then
                    Status.Text = RebirthStatus
                elseif mob then
                    Status.Text = "Target: " .. mob.Name .. " | Mobs: " .. count
                elseif AutoOrbit then
                    Status.Text = "Orbit aktif | Mobs: " .. count
                elseif AutoTP then
                    Status.Text = "TP aktif | Mobs: " .. count
                else
                    Status.Text = "Mobs in folder: " .. count
                end
            end)
        end

        task.wait(0.3)
    end
end)

