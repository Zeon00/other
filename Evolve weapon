local function hallowAlive(id)
    return Running and AutoHallow and HallowRunId == id
end

local function teleportHallowPosition(position)
    updateCharacter()
    if not Root or not Root.Parent then return false end

    return pcall(function()
        Root.CFrame = CFrame.new(position)
        Root.AssemblyLinearVelocity = Vector3.zero
        Root.AssemblyAngularVelocity = Vector3.zero
    end)
end

local function getHallowProgress()
    local playerGui = Player:FindFirstChild("PlayerGui")
    local gameUI = playerGui and playerGui:FindFirstChild("GameUI")
    local dungeonBar = gameUI and gameUI:FindFirstChild("DungeonBar")
    local progress = dungeonBar and dungeonBar:FindFirstChild("Progress")

    if not progress then
        return "", ""
    end

    local textFolder = progress:FindFirstChild("Text") or progress
    local captionObject = textFolder:FindFirstChild("Caption", true)
    local valueObject = textFolder:FindFirstChild("Value", true)

    local caption = ""
    local value = ""

    if captionObject and (captionObject:IsA("TextLabel") or captionObject:IsA("TextButton")) then
        caption = string.upper((captionObject.Text or ""):match("^%s*(.-)%s*$"))
    end

    if valueObject and (valueObject:IsA("TextLabel") or valueObject:IsA("TextButton")) then
        value = string.upper((valueObject.Text or ""):match("^%s*(.-)%s*$"))
    end

    return caption, value
end

local function hallowProgressIsOpen()
    local caption, value = getHallowProgress()
    return caption == "OPEN!" and value == "BOSS"
end
local function hallowWaitForBeaconAndBoss(id, statusCallback)
    local function alive()
        return hallowAlive(id)
    end

    local encounterIndex = 1
    local encounterTarget = nil
    local waitingEncounterSpawn = false
    local sawEncounterMobs = false

    local lastBeacon = nil
    local lastBeaconPosition = nil

    local emptyStart = nil
    local lastMoveTime = 0

    local function status(msg)
        if statusCallback then
            statusCallback(msg)
        end
    end

    local function findMonsterBeacon()
        for _, fx in ipairs(Workspace:GetChildren()) do
            if fx.Name == "ClientFX" then
                local beacon = fx:FindFirstChild("MonsterBeacon")

                if beacon and beacon:IsA("BasePart") then
                    local billboard = beacon:FindFirstChild("BillboardGui")
                    local hasDistanceText = false

                    if billboard then
                        for _, label in ipairs(billboard:GetDescendants()) do
                            if (label:IsA("TextLabel") or label:IsA("TextButton"))
                                and label.Text:match("%d+%s*m") then
                                hasDistanceText = true
                                break
                            end
                        end
                    end

                    if hasDistanceText then
                        return beacon
                    end
                end
            end
        end

        return nil
    end

    while alive() do
        local enemyCount = getEnemyCount()

        -- MOB MASIH ADA
        if enemyCount > 0 then
            emptyStart = nil

            if waitingEncounterSpawn then
                waitingEncounterSpawn = false
                sawEncounterMobs = true
            end

            status("Mob ditemukan! Menunggu mob selesai...")

        else
            -- MOB KOSONG
            emptyStart = emptyStart or os.clock()

            if sawEncounterMobs then
                encounterIndex += 1
                encounterTarget = nil
                sawEncounterMobs = false
            end

            if os.clock() - emptyStart >= MOB_EMPTY_CONFIRM_TIME then

                -- PRIORITAS 1: MONSTER BEACON
                local beacon = findMonsterBeacon()

                if beacon then
                    local movedBeacon =
                        beacon ~= lastBeacon
                        or not lastBeaconPosition
                        or (beacon.Position - lastBeaconPosition).Magnitude > 5

                    updateCharacter()

                    if Root and movedBeacon then
                        local distance =
                            (Root.Position - beacon.Position).Magnitude

                        if distance > 12 then
                            if os.clock() - lastMoveTime >= 1 then
                                status("MonsterBeacon ditemukan! Pathfinding...")

                                lastMoveTime = os.clock()

                                if moveDungeonPointer(beacon, alive, status) then
                                    lastBeacon = beacon
                                    lastBeaconPosition = beacon.Position
                                end
                            end

                            task.wait(0.15)
                            continue
                        else
                            lastBeacon = beacon
                            lastBeaconPosition = beacon.Position
                        end
                    end
                end

                -- PRIORITAS 2: BOSS OPEN
                if hallowProgressIsOpen() then
                    status("BOSS OPEN! Lanjut FloorGlow...")
                    return true
                end

