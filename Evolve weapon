local function getObjectCFrame(object)
    if not object then return nil end

    if object:IsA("BasePart") then
        return object.CFrame
    end

    if object:IsA("Model") then
        return object:GetPivot()
    end

    local part = object:FindFirstChildWhichIsA("BasePart", true)

    return part and part.CFrame or nil
end

local function teleportObject(object)
    local cf = getObjectCFrame(object)

    if not cf then return false end

    updateCharacter()

    if not Root then return false end

    return pcall(function()
        Root.CFrame = cf + Vector3.new(0, 3, 0)
    end)
end

local function teleportPosition(position)
    updateCharacter()

    if not Root then return false end

    return pcall(function()
        Root.CFrame = CFrame.new(position + Vector3.new(0, 3, 0))
    end)
end

local function getDungeonObject(name, path)
    local current = Workspace:FindFirstChild("Dungeons")

    if not current then return nil end

    current = current:FindFirstChild(name)

    if not current then return nil end

    for _, childName in ipairs(path) do
        current = current:FindFirstChild(childName)

        if not current then return nil end
    end

    return current
end
--============================================================
-- DUNGEON POINTER MOVEMENT | PATHFINDING + TP MAX 15 STUD
--============================================================

local DUNGEON_TP_STEP = 25
local DUNGEON_TP_DELAY = 0.12

local function moveDungeonPointer(object, isAlive, statusCallback)
    if not object or not isAlive() then
        return false
    end

    updateCharacter()

    if not Root or not Humanoid then
        return false
    end

    local targetCF = getObjectCFrame(object)
    if not targetCF then
        return false
    end

    local path = PathfindingService:CreatePath({
        AgentRadius = 2,
        AgentHeight = 5,
        AgentCanJump = true,
        AgentCanClimb = true,
        WaypointSpacing = 6
    })

    local success = pcall(function()
        path:ComputeAsync(
            Root.Position,
            targetCF.Position
        )
    end)

    if not success or path.Status ~= Enum.PathStatus.Success then
        if statusCallback then
            statusCallback("Pathfinding gagal, mencoba jalur lagi...")
        end
        return false
    end

    local waypoints = path:GetWaypoints()

    for _, waypoint in ipairs(waypoints) do
        if not isAlive() then
            return false
        end

        updateCharacter()

        if not Root or not Root.Parent then
            return false
        end

        if waypoint.Action == Enum.PathWaypointAction.Jump then
            Humanoid.Jump = true
        end

        local destination = waypoint.Position + Vector3.new(0, 3, 0)
        local distance = (destination - Root.Position).Magnitude
        local steps = math.max(1, math.ceil(distance / DUNGEON_TP_STEP))

        for step = 1, steps do
            if not isAlive() then
                return false
            end

            updateCharacter()

            if not Root or not Root.Parent then
                return false
            end

            local currentPosition = Root.Position
            local nextPosition = currentPosition:Lerp(
                destination,
                1 / (steps - step + 1)
            )

            local moved = pcall(function()
                Root.CFrame = CFrame.new(nextPosition)
                Root.AssemblyLinearVelocity = Vector3.zero
                Root.AssemblyAngularVelocity = Vector3.zero
            end)

            if not moved then
                return false
            end

            task.wait(DUNGEON_TP_DELAY)
        end
    end

    return isAlive()
end
