                if running(id) and isAlive(mob) then
                    orbitMob(mob, id)
                end

                if _G.AutoRaidTarget == mob then
                    _G.AutoRaidTarget = nil
                end
            end
        end

        task.wait(0.2)
    end

    if _G.AutoRaidOrbitRunId == id then
        _G.AutoRaidTarget = nil
    end
end

