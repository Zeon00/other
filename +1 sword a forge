local function AddToggle(name, default, callback)
	local enabled = default == true

	local button = Instance.new("TextButton")
	button.Name = name
	button.Size = UDim2.new(1, -4, 0, 46)
	button.BackgroundColor3 = Color3.fromRGB(42, 36, 52)
	button.BorderSizePixel = 0
	button.Text = ""
	button.AutoButtonColor = false
	button.Parent = Content

	Instance.new("UICorner", button).CornerRadius = UDim.new(0, 8)

	local label = Instance.new("TextLabel")
	label.Size = UDim2.new(1, -85, 1, 0)
	label.Position = UDim2.fromOffset(12, 0)
	label.BackgroundTransparency = 1
	label.Text = name
	label.TextColor3 = Color3.fromRGB(240, 235, 245)
	label.Font = Enum.Font.GothamSemibold
	label.TextSize = 12
	label.TextXAlignment = Enum.TextXAlignment.Left
	label.TextWrapped = true
	label.Parent = button

	local status = Instance.new("Frame")
	status.Size = UDim2.fromOffset(48, 25)
	status.Position = UDim2.new(1, -57, 0.5, -12)
	status.BackgroundColor3 = Color3.fromRGB(75, 75, 85)
	status.BorderSizePixel = 0
	status.Parent = button

	Instance.new("UICorner", status).CornerRadius = UDim.new(0, 6)

	local statusText = Instance.new("TextLabel")
	statusText.Size = UDim2.fromScale(1, 1)
	statusText.BackgroundTransparency = 1
	statusText.TextColor3 = Color3.new(1, 1, 1)
	statusText.Font = Enum.Font.GothamBold
	statusText.TextSize = 11
	statusText.Parent = status

	local function update()
		statusText.Text = enabled and "ON" or "OFF"

		status.BackgroundColor3 = enabled
			and Color3.fromRGB(145, 75, 220)
			or Color3.fromRGB(75, 75, 85)

		button.BackgroundColor3 = enabled
			and Color3.fromRGB(57, 39, 75)
			or Color3.fromRGB(42, 36, 52)
	end

	local function setState(newState)
		if not Running() or enabled == newState then
			return
		end

		enabled = newState
		ToggleStates[name] = newState
		update()

		local ok, err = pcall(callback, newState)

		if not ok then
			warn("[Automation Error] " .. name, err)
			SetStatus(name .. " error: " .. tostring(err), false)
		end
	end

	button.Activated:Connect(function()
		setState(not enabled)
	end)

	ToggleStates[name] = enabled
	update()

	local reference = {
		Set = setState,
		Get = function()
			return enabled
		end
	}

	ToggleRefs[name] = reference

	return reference
end


