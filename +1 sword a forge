local HollowShared = RS:WaitForChild("Shared")
local HollowNetFolder = HollowShared:WaitForChild("Net")
local HollowNet = require(HollowNetFolder:WaitForChild("Net"))
local HollowProtocol = require(HollowNetFolder:WaitForChild("Protocol"))

local function GetPortalPad()
	local map = workspace:FindFirstChild("Map")
	local lobby = map and map:FindFirstChild("Lobby")
	local halloween = lobby and lobby:FindFirstChild("Halloween")
	local portal = halloween and halloween:FindFirstChild("Portal")

	if not portal then
		return nil
	end

	local pad = portal:FindFirstChild("Pad", true)

	if pad and pad:IsA("BasePart") then
		return pad
	end

	if portal:IsA("BasePart") then
		return portal
	end

	return portal:FindFirstChildWhichIsA("BasePart", true)
end

local function TeleportToPortal()
	local character = GetCharacter()
	local humanoid = GetHumanoid()
	local root = GetRoot()

	if not character or not humanoid or humanoid.Health <= 0 or not root then
		return false, "Character belum siap"
	end

	local pad = GetPortalPad()

	if not pad then
		return false, "Portal Pad tidak ditemukan"
	end

	character:PivotTo(pad.CFrame * CFrame.new(0, 4, 0))

	return true, "Berhasil TP ke portal"
end

local function JoinHollow()
	local success, result = pcall(function()
		return HollowNet.InvokeServer(
			HollowProtocol.Msg.HollowAction,
			"Join",
			{from = "portal"}
		)
	end)

	if not success then
		return false, tostring(result)
	end

	if type(result) ~= "table" then
		return false, "Response server tidak valid"
	end

	if result.ok then
		return true, "Join request berhasil"
	end

	local errors = {
		Closed = "Hollow sedang ditutup",
		Busy = "Selesaikan aktivitas lain dahulu",
		Full = "Hollow penuh",
		TooFar = "Masih terlalu jauh dari portal",
		NoCharacter = "Character belum siap",
		Locked = "Stage belum memenuhi syarat"
	}

	return false, errors[result.err] or tostring(result.err or "Join gagal")
end

