local CurrentPath
local WaypointIndex = 0
local MoveClock = 0
local PathClock = 0

local function SetHollowSprint(state)
	if not HollowTestAPI then return end

	pcall(function()
		if type(HollowTestAPI.SetSprintHeld) == "function" then
			HollowTestAPI.SetSprintHeld(state)
		elseif type(HollowTestAPI.Movement) == "table"
			and type(HollowTestAPI.Movement.SetSprintHeld) == "function" then

			HollowTestAPI.Movement.SetSprintHeld(state)
		end
	end)
end

local function StopHollowMovement()
	local humanoid = GetHumanoid()
	local root = GetRoot()

	if humanoid then
		humanoid:Move(Vector3.zero, false)

		if root then
			humanoid:MoveTo(root.Position)
		end
	end

	SetHollowSprint(false)

	CurrentPath = nil
	WaypointIndex = 0
	MoveClock = 0
	PathClock = 0
end

local function MoveDirect(position)
	local humanoid = GetHumanoid()

	if not humanoid then return end

	SetHollowSprint(true)
	humanoid:MoveTo(position)
end

local function MoveToHollowMob(target, dt)
	local root = GetRoot()
	local humanoid = GetHumanoid()

	if not ValidHollowTarget(target) or not root or not humanoid then
		return
	end

	local distance = (root.Position - target.pos).Magnitude

	if distance <= ATTACK_DISTANCE then
		humanoid:Move(Vector3.zero, false)
		SetHollowSprint(false)
		CurrentPath = nil
		return
	end

	MoveClock += dt
	PathClock += dt

	if MoveClock < MOVE_REFRESH then
		return
	end

	MoveClock = 0

	if PathClock >= PATH_REFRESH or not CurrentPath then
		PathClock = 0

		local path = PathfindingService:CreatePath({
			AgentRadius = 2,
			AgentHeight = 5,
			AgentCanJump = true,
			WaypointSpacing = 6
		})

		local ok = pcall(function()
			path:ComputeAsync(root.Position, target.pos)
		end)

		if ok and path.Status == Enum.PathStatus.Success then
			CurrentPath = path:GetWaypoints()
			WaypointIndex = 2
		else
			CurrentPath = nil
		end
	end

	if CurrentPath and CurrentPath[WaypointIndex] then
		local waypoint = CurrentPath[WaypointIndex]

		if waypoint.Action == Enum.PathWaypointAction.Jump then
			humanoid.Jump = true
		end

		if (root.Position - waypoint.Position).Magnitude < 5 then
			WaypointIndex += 1
			waypoint = CurrentPath[WaypointIndex]
		end

		if waypoint then
			MoveDirect(waypoint.Position)
			return
		end
	end

	MoveDirect(target.pos)
end

