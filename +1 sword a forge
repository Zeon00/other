    Root.AssemblyLinearVelocity = Vector3.zero
    Root.AssemblyAngularVelocity = Vector3.zero
    Root.CFrame = CFrame.new(Position)

    task.wait(0.4)

    if not alive() then
        return false, "Stopped"
    end

    local _, _, NewRoot = getCharacter()
    if not NewRoot then
        return false, "Root hilang"
    end

    return (NewRoot.Position - Position).Magnitude <= 15,
        "Teleport gagal"
end

--============================================================
-- MAIN STAGE LOOP | LOGIKA PENCARIAN LAMA
--============================================================

startWalk = function()
    if WalkLoopRunning or not alive() then return end

    WalkLoopRunning = true

    task.spawn(function()
        while alive() do
            local Cleared = getRunMaxClear()

            if Cleared >= MAX_STAGE then
                SetStatus("Stage 1-34 selesai! Menunggu run berikutnya...", true)
                task.wait(2)

                if not alive() then break end

                if getRunMaxClear() >= MAX_STAGE then
                    task.wait(2)
                end

                continue
            end

            local NextStage = Cleared + 1
            SetStatus("Mencari Stage " .. NextStage, true)

            local Success, Message = moveToStage(NextStage)

            if not alive() then break end

            if not Success then
                SetStatus(tostring(Message) .. " | Retry...", false)
                task.wait(RETRY_DELAY)
                continue
            end

            SetStatus("Stage " .. NextStage .. " | Menunggu clear", true)

            while alive() and getRunMaxClear() < NextStage do
                task.wait(0.5)

                if getRunMaxClear() < NextStage then
                    local _, _, Root = getCharacter()
                    local Target = getStageArea(NextStage)

                    if not Target then
                        SetStatus("Stage " .. NextStage .. " belum tersedia", true)
                    elseif Root and (Root.Position - Target.Position).Magnitude > 18 then
                        SetStatus("Stage " .. NextStage .. " | TP ulang...", true)
                        moveToStage(NextStage)
                    end
                end
            end

            if not alive() then break end

            if getRunMaxClear() >= NextStage then
                SetStatus("Stage " .. NextStage .. " clear! Ambil drop...", true)

                local StartTime = os.clock()

                while alive()
                    and os.clock() - StartTime < DROP_PICKUP_DELAY do
                    task.wait(0.1)
                end
            end
        end

        WalkLoopRunning = false
    end)
end

--============================================================
-- START / RESTART CYCLE
--============================================================

beginCycle = function()
    if not Enabled or Destroyed
        or _G.AutoWalkReturnRunId ~= RunId then
        return
    end

    task.spawn(function()
        SetStatus("TP ke posisi 1...", true)

        local teleported = teleportPosition1()

        if not teleported then
            if Enabled and not Destroyed then
                SetStatus("TP posisi 1 gagal, retry...", false)
                task.wait(RETRY_DELAY)
                beginCycle()
            end
            return
        end

        SetStatus("TP posisi 1 berhasil", true)

        local sent = sendStartRemote()

        if not sent then
            if Enabled and not Destroyed then
                task.wait(RETRY_DELAY)
                beginCycle()
            end
            return
        end

        if not alive() then return end

        -- Stage search tetap membaca RunMaxClear.
        -- Tidak di-reset ke stage 33.
        startWalk()
    end)
end

--============================================================
-- LOOT MONITOR
--============================================================

task.spawn(function()
    while not Destroyed and _G.AutoWalkReturnRunId == RunId do
        local Current, Maximum = parseCapacity(getLootText())

        if Current and Maximum then
            if alive() and Current >= Maximum then
                returnTown()
            end
        end

        task.wait(0.4)
    end
end)

--============================================================
-- TOGGLE
--============================================================

AddToggle("Auto TP Stage 1-34 + Return", false, function(state)
    Enabled = state

    if state then
        Returning = false
        Busy = false
        WalkLoopRunning = false
        CycleToken += 1

        SetStatus("Auto TP: Memulai siklus...", true)
        beginCycle()
    else
        CycleToken += 1
        Returning = true
        SetStatus("Auto TP: Dihentikan", false)
    end
end)

table.insert(Session.Cleanups, function()
    Destroyed = true
    Enabled = false
    Returning = true
    CycleToken += 1
    _G.AutoWalkReturnRunId += 1
end)


end
