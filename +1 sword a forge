local HollowAPI
local HollowTestAPI

local function FindHollowAPI()
	if type(getgc) ~= "function" then
		return nil
	end

	local ok, objects = pcall(getgc, true)

	if not ok or type(objects) ~= "table" then
		return nil
	end

	for _, object in ipairs(objects) do
		if type(object) == "table" then
			local test = rawget(object, "Test")

			if type(test) == "table"
				and type(test.AimAt) == "function"
				and type(test.Trigger) == "function"
				and type(test.Targets) == "function" then

				return object
			end
		end
	end

	return nil
end

local function ConnectHollowAPI()
	HollowAPI = FindHollowAPI()

	if not HollowAPI then
		return false
	end

	HollowTestAPI = HollowAPI.Test
	return true
end

local function GetHollowTargets()
	if not HollowTestAPI then
		return {}
	end

	local ok, result = pcall(function()
		return HollowTestAPI.Targets()
	end)

	if ok and type(result) == "table" then
		return result
	end

	return {}
end

local function ValidHollowTarget(target)
	return target
		and target.id ~= nil
		and typeof(target.pos) == "Vector3"
		and (target.hp == nil or target.hp > 0)
end

local function GetTargetById(targets, id)
	for _, target in ipairs(targets) do
		if target.id == id and ValidHollowTarget(target) then
			return target
		end
	end
end

local function GetNearestHollowTarget(targets)
	local root = GetRoot()
	if not root then return nil end

	local nearest
	local nearestDistance = math.huge

	for _, target in ipairs(targets) do
		if ValidHollowTarget(target) then
			local distance = (root.Position - target.pos).Magnitude

			if distance < nearestDistance then
				nearestDistance = distance
				nearest = target
			end
		end
	end

	return nearest
end

local LockedTargetId

local function UpdateHollowTarget(targets)
	if LockedTargetId ~= nil then
		local current = GetTargetById(targets, LockedTargetId)

		if current then
			return current
		end
	end

	local target = GetNearestHollowTarget(targets)
	LockedTargetId = target and target.id or nil

	return target
end

