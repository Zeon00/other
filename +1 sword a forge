--============================================================
-- PUMPKIN KING DETECTION
--============================================================

local Pumpkin

local function GetModelPosition(object)
	if not object then return nil end

	if object:IsA("BasePart") then
		return object.Position
	end

	if object:IsA("Model") then
		local part = object.PrimaryPart
			or object:FindFirstChild("HumanoidRootPart", true)
			or object:FindFirstChild("Head", true)

		if part and part:IsA("BasePart") then
			return part.Position
		end

		local ok, pivot = pcall(function()
			return object:GetPivot()
		end)

		if ok then
			return pivot.Position
		end
	end

	return nil
end

local function FindPumpkin()
	local folder = workspace:FindFirstChild("HollowKing")
	if not folder then return nil end

	local root = GetRoot()
	local nearest
	local nearestDistance = math.huge

	for _, runFolder in ipairs(folder:GetChildren()) do
		if runFolder.Name:match("^Run_") then
			local candidate = runFolder:FindFirstChild("PumpkinKing")

			if candidate then
				local position = GetModelPosition(candidate)

				if position then
					local distance = root
						and (root.Position - position).Magnitude
						or 0

					if distance < nearestDistance then
						nearestDistance = distance
						nearest = candidate
					end
				end
			end
		end
	end

	return nearest
end

local function PumpkinAlive()
	if not Pumpkin or not Pumpkin.Parent then
		return false
	end

	local humanoid = Pumpkin:FindFirstChildOfClass("Humanoid")

	if humanoid and humanoid.Health <= 0 then
		return false
	end

	local health = Pumpkin:GetAttribute("Health")

	if typeof(health) == "number" and health <= 0 then
		return false
	end

	return GetModelPosition(Pumpkin) ~= nil
end

