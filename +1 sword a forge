local Session = {
	Alive = true,
	Connections = {},
	Tasks = {},
	Cleaning = false,
    Cleanups = {}
}

_G.UltimateAutomationSession = Session

local function Running()
	return Session.Alive
		and _G.UltimateAutomationSession == Session
end

local function TrackConnection(connection)
	table.insert(Session.Connections, connection)
	return connection
end

local function TrackTask(name, token)
	Session.Tasks[name] = token
end

local function TaskAlive(name, token)
	return Running() and Session.Tasks[name] == token
end

