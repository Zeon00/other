-- HALLOWEEN TARGET HELPERS
local function getMobPart(mob)
    if not mob or not mob.Parent then
        return nil
    end

    if mob:IsA("BasePart") then
        return mob
    end

    if not mob:IsA("Model") then
        return nil
    end

    return mob.PrimaryPart
        or mob:FindFirstChild("HumanoidRootPart")
        or mob:FindFirstChild("Head")
        or mob:FindFirstChildWhichIsA("BasePart", true)
end

local function isAliveMob(mob)
    if not mob or not mob.Parent then
        return false
    end

    local part = getMobPart(mob)
    if not part or not part.Parent then
        return false
    end

    if mob:IsA("Model") then
        local hum = mob:FindFirstChildWhichIsA("Humanoid", true)
        if hum and hum.Health <= 0 then
            return false
        end
    end

    return true
end

local function getTarget()
    local folder = workspace:FindFirstChild("HwMobs")
    if not folder then
        return nil
    end

    for i = 1, 10 do
        local arena = folder:FindFirstChild("A" .. i)

        if arena then
            for _, mob in ipairs(arena:GetChildren()) do
                if (mob:IsA("Model") or mob:IsA("BasePart"))
                    and isAliveMob(mob) then
                    return mob
                end
            end
        end
    end

    return nil
end
-- HP AUTO ORBIT BOOST
task.spawn(function()
    local lastBoostState = false

    while screenGui.Parent
        and _G.StandaloneAutomationRunId == runId do

        task.wait(0.2)

        local topbar = playerGui:FindFirstChild("HalloweenTopbar")
        local hpBar = topbar and topbar:FindFirstChild("HpBar")
        local hpText = hpBar and hpBar:FindFirstChild("Text")

        if hpText and hpText:IsA("TextLabel") then
            local currentHP, maxHP =
                hpText.Text:match("(%d+)%s*/%s*(%d+)")

            currentHP = tonumber(currentHP)
            maxHP = tonumber(maxHP)

            if currentHP and maxHP and maxHP > 0 then
                local ratio = currentHP / maxHP

                if ratio < 0.5 then
                    hpBoostActive = true
                elseif ratio >= 1 then
                    hpBoostActive = false
                end

                if hpBoostActive ~= lastBoostState then
                    lastBoostState = hpBoostActive

                    if hpBoostActive then
                        status.Text = "HP rendah: Orbit Boost 50/50"
                    else
                        status.Text = "HP penuh: Orbit normal"
                    end
                end
            end
        end
    end

    hpBoostActive = false
end)
-- JUMP HINT: TEMPORARY ORBIT BOOST
task.spawn(function()
    local function activateBoost()
        if not _G.HalloweenOrbitEnabled then
            return
        end

        jumpBoostId += 1
        local thisBoost = jumpBoostId

        jumpBoostActive = true
        RADIUS = BOOST_RADIUS
        HEIGHT = BOOST_HEIGHT
        status.Text = "BOOST: Radius 50 / Height 50"

        task.delay(BOOST_DURATION, function()
            if thisBoost ~= jumpBoostId then
                return
            end

            jumpBoostActive = false
            RADIUS = NORMAL_RADIUS
            HEIGHT = NORMAL_HEIGHT

            if screenGui.Parent then
                status.Text = "Orbit restored: Radius 16 / Height 7"
            end
        end)
    end

    local hint = playerGui:WaitForChild("HalloweenBossHint")
    local jump = hint:WaitForChild("Jump")

    if jump:IsA("GuiButton") then
        jump.Activated:Connect(activateBoost)
    end

    if jump:IsA("GuiObject") then
        local wasVisible = jump.Visible

        if wasVisible then
            activateBoost()
        end

        jump:GetPropertyChangedSignal("Visible"):Connect(function()
            local nowVisible = jump.Visible

            if nowVisible and not wasVisible then
                activateBoost()
            end

            wasVisible = nowVisible
        end)
    end
end)

-- FREEZE ENEMY: LOCAL TEST
task.spawn(function()
    local frozen = {}

    local function restore()
        for part, oldAnchored in pairs(frozen) do
            if part and part.Parent then
                pcall(function()
                    part.Anchored = oldAnchored
                end)
            end
        end
        table.clear(frozen)
    end

    while screenGui.Parent
        and _G.StandaloneAutomationRunId == runId do

        if _G.HwFreezeEnemy then
            local folder = workspace:FindFirstChild("HwMobs")

            if folder then
                for i = 1, 10 do
                    local arena = folder:FindFirstChild("A" .. i)

                    if arena then
                        for _, mob in ipairs(arena:GetChildren()) do
                            if mob:IsA("Model") then
                                for _, obj in ipairs(mob:GetDescendants()) do
                                    if obj:IsA("BasePart")
                                        and frozen[obj] == nil then
                                        frozen[obj] = obj.Anchored
                                        pcall(function()
                                            obj.Anchored = true
                                        end)
                                    end
                                end
                            end
                        end
                    end
                end
            end
        else
            restore()
        end

        task.wait(0.25)
    end

    restore()
end)

-- HALLOWEEN ORBIT: DELTA TIME
task.spawn(function()
    local currentTarget = nil
    local angle = 0

    while screenGui.Parent
        and _G.StandaloneAutomationRunId == runId do

        if not _G.HalloweenOrbitEnabled then
            currentTarget = nil
            task.wait(0.1)
            continue
        end

        local character = player.Character
        local root = character
            and character:FindFirstChild("HumanoidRootPart")
        local humanoid = character
            and character:FindFirstChildWhichIsA("Humanoid")

        if not root or not humanoid or humanoid.Health <= 0 then
            currentTarget = nil
            status.Text = "Waiting for character"
            task.wait(0.2)
            continue
        end

        if not isAliveMob(currentTarget) then
            currentTarget = getTarget()

            if not currentTarget then
                status.Text = "Waiting for mobs in HwMobs"
                task.wait(0.2)
                continue
            end

            local part = getMobPart(currentTarget)
            if part then
                local offset = root.Position - part.Position
                angle = math.atan2(offset.Z, offset.X)
            end
        end

        local mob = currentTarget
        local part = getMobPart(mob)

        if not part or not isAliveMob(mob) then
            currentTarget = nil
            task.wait(0.05)
            continue
        end

        local dt = RunService.Heartbeat:Wait()

        if not _G.HalloweenOrbitEnabled
            or not root.Parent
            or not part.Parent then
            continue
        end

angle += ROTATION_SPEED * dt

local orbitRadius = hpBoostActive and BOOST_RADIUS or RADIUS
local orbitHeight = hpBoostActive and BOOST_HEIGHT or HEIGHT

local pos = part.Position
local destination = Vector3.new(
    pos.X + math.cos(angle) * orbitRadius,
    pos.Y + orbitHeight,
    pos.Z + math.sin(angle) * orbitRadius
)

        root.CFrame = CFrame.lookAt(destination, pos)
        status.Text = "Orbit target: " .. mob.Name
    end
end)

-- HALLOWEEN AUTO PICK
task.spawn(function()
    while screenGui.Parent
        and _G.StandaloneAutomationRunId == runId do

        task.wait(0.2)

        if not autoPick or pickBusy then
            continue
        end

        local cardsGui = playerGui:FindFirstChild("HalloweenCards")
        local cards = cardsGui and cardsGui:FindFirstChild("Cards")
        local row = cards and cards:FindFirstChild("Row")

        if not cardsGui or not cardsGui.Enabled or not row then
            lastPicked = nil
            continue
        end

        local chosenKey = nil
local lmCards = {}

-- Cari semua card berawalan L atau M terlebih dahulu
for _, card in ipairs(row:GetChildren()) do
    local key = card.Name:match("^Card_(.+)$")
    local click = card:FindFirstChild("Click")

    if key and click and click:IsA("GuiButton")
        and card.Visible and click.Visible and click.Active then

        key = string.lower(key)

        if key:match("^l") or key:match("^m") then
            table.insert(lmCards, key)
        end
    end
end

table.sort(lmCards)

if #lmCards > 0 then
    chosenKey = lmCards[1]
else
    -- Kalau tidak ada L/M, pakai urutan PRIORITY lama
    for _, key in ipairs(PRIORITY) do
        local card = row:FindFirstChild("Card_" .. key)

        if card and card.Visible then
            local click = card:FindFirstChild("Click")

            if click and click:IsA("GuiButton")
                and click.Visible and click.Active then
                chosenKey = key
                break
            end
        end
    end
end

        if not chosenKey then
            status.Text = "Auto Pick: no priority card"
            lastPicked = nil
            continue
        end

        if lastPicked == chosenKey then
            continue
        end

        pickBusy = true
        status.Text = "Memilih kartu: " .. chosenKey

        local success = pcall(function()
            HwEvent:FireServer("pick", chosenKey)
        end)

        if success and autoPick then
            lastPicked = chosenKey
            status.Text = "Pilihan dikirim: " .. chosenKey
        else
            status.Text = "Gagal mengirim pilihan"
        end

        task.wait(0.8)
        pickBusy = false
    end
end)

