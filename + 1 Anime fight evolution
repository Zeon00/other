local function setTPEnabled(value)
    autoTP = value
    tpRunId += 1

    if autoTP then
        setToggle(tpToggle, true, "AUTO TP + PAD SIZE")
        status.Text = "Mencari POS1 (30 studs)"
    else
        setToggle(tpToggle, false, "AUTO TP + PAD SIZE")
        status.Text = "Auto TP berhenti"
    end
end

local function getRoot()
    local char = player.Character
    return char and char:FindFirstChild("HumanoidRootPart")
end

local function nearPosition(root, pos, radius)
    return root ~= nil and (root.Position - pos).Magnitude <= radius
end

local function startTPLoop(id)
    task.spawn(function()
        while autoTP and tpRunId == id and screenGui.Parent
            and _G.StandaloneAutomationRunId == runId do

            local root = getRoot()

            if root and nearPosition(root, POS1, TOLERANCE) then
                status.Text = "POS1 terdeteksi..."

                task.wait(math.random(3, 5))

                if not autoTP or tpRunId ~= id then
                    break
                end

                root = getRoot()
                if root and nearPosition(root, POS1, TOLERANCE) then
                    root.CFrame = CFrame.new(POS2)
                    status.Text = "Teleport ke POS2..."
                    task.wait(2)

                    if not autoTP or tpRunId ~= id then
                        break
                    end

                    HwEvent:FireServer("padSize", 1)
                    status.Text = "Pad Size dikirim; menunggu POS1"

                    repeat
                        task.wait(0.25)
                        root = getRoot()
                    until not autoTP
                        or tpRunId ~= id
                        or (root and nearPosition(root, POS1, TOLERANCE))
                end
            else
                status.Text = "Mencari POS1 (30 studs)"
                task.wait(0.25)
            end
        end
    end)
end

