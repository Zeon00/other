--============================================================
-- ENEMY SCAN
--============================================================

local function GetEnemies()
    local Result = {}
    local Folder = Workspace:FindFirstChild("MyEnemies")
    local PlayerRoot = GetCharacterRoot()

    if not Folder or not PlayerRoot then
        return Result
    end

    for _, Mob in ipairs(Folder:GetChildren()) do
        if IsAlive(Mob) then
            local Root = GetRoot(Mob)

            if Root then
                local Distance =
                    (Root.Position - PlayerRoot.Position).Magnitude

                if Distance <= ENEMY_SCAN_DISTANCE then
                    table.insert(Result, {
                        Model = Mob,
                        Root = Root,
                        Distance = Distance
                    })
                end
            end
        end
    end

    return Result
end

--============================================================
-- ACTION POSITIONS
--============================================================

local function GetActionPositions()
    local Positions = {}

    if KuramaEnabled then
        local Kurama = GetKurama()
        local Root = Kurama and GetRoot(Kurama)

        if Root then
            table.insert(Positions, Root.Position)
            return Positions
        end
    end

    if EnemiesEnabled then
        for _, Data in ipairs(GetEnemies()) do
            if Data.Root and Data.Root.Parent then
                table.insert(Positions, Data.Root.Position)
            end
        end
    end

    return Positions
end

--============================================================
-- TRAIN + AUTO SKILL E/R
--============================================================

local function ProcessTraining()
    if not TrainEnabled or Destroyed then return end

    local Now = os.clock()

    if Now >= NextTrain then
        NextTrain = Now + TRAIN_DELAY

        pcall(function()
            TrainRemote:FireServer()
        end)

        local Positions = GetActionPositions()

        if #Positions == 0 then
            local Root = GetCharacterRoot()

            if Root then
                table.insert(Positions, Root.Position)
            end
        end

        for _, Position in ipairs(Positions) do
            if not TrainEnabled or Destroyed then break end

            pcall(function()
                CastRemote:FireServer("attack", Position)
            end)
        end
    end

    if not TrainEnabled or Destroyed then return end

    if Now >= NextSkill then
        NextSkill = Now + SKILL_DELAY

        local Targets = GetActionPositions()

        for _, Position in ipairs(Targets) do
            if not TrainEnabled or Destroyed then break end

            pcall(function()
                CastRemote:FireServer("E", Position)
            end)

            pcall(function()
                CastRemote:FireServer("R", Position)
            end)
        end
    end
end

