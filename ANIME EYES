end

--============================================================
-- AUTO JOIN KURAMA
--============================================================

local function IsInArena()
    local _, _, Root = GetAliveCharacter()
    if not Root then return false end

    local Centre = Boss.CENTRE
    local Position = Root.Position

    local DX = Position.X - Centre.X
    local DZ = Position.Z - Centre.Z

    return (
        DX * DX + DZ * DZ
        <= Boss.INSIDE_RADIUS * Boss.INSIDE_RADIUS
    ) and math.abs(Position.Y - Centre.Y) < 80
end

local function TryJoinKurama()
    if Destroyed or not AutoJoinEnabled then return end

    local Phase = Workspace:GetAttribute("BossPhase")

    if Phase ~= "coming" and Phase ~= "fight" then
        return
    end

    if Player:GetAttribute("InStages") == true then return end
    if Player:GetAttribute("InWave") == true then return end
    if IsInArena() then return end

    local Now = os.clock()

    if Now - LastJoinTime < JOIN_INTERVAL then
        return
    end

    LastJoinTime = Now

    pcall(function()
        BossRemote:FireServer("join")
    end)
end

--============================================================
-- DODGE ATTACK VALIDATION
--============================================================

local function IsValidAttack(Kind)
    if type(Kind) ~= "string" then return false end
    if type(Boss.ATTACKS) ~= "table" then return false end
    if not Boss.ATTACKS[Kind] then return false end
    if type(Boss.ALL) ~= "table" then return false end

    return table.find(Boss.ALL, Kind) ~= nil
end

local function CopyShapes(Source)
    local Result = {}

    if type(Source) ~= "table" then
        return Result
    end

    for _, Shape in pairs(Source) do
        if type(Shape) == "table"
            and type(Shape.x) == "number"
            and type(Shape.z) == "number"
            and type(Shape.radius) == "number"
            and (
                Shape.kind == "circle"
                or Shape.kind == "ring"
                or Shape.kind == "cone"
            ) then

            table.insert(Result, {
                kind = Shape.kind,
                x = Shape.x,
                z = Shape.z,
                radius = Shape.radius,
                inner = Shape.inner,
                yaw = Shape.yaw,
                half = Shape.half
            })
        end
    end

    return Result
end

local function AddAttack(Data)
    if type(Data) ~= "table" then return end
    if Data.t ~= "atk" then return end
    if not IsValidAttack(Data.k) then return end
    if type(Data.hit) ~= "number" then return end

    local Shapes = CopyShapes(Data.sh)

    if #Shapes == 0 then return end

    table.insert(PendingAttacks, {
        kind = Data.k,
        hit = Data.hit,
        shapes = Shapes
    })
end

local function CleanAttacks()
    local Now = Workspace:GetServerTimeNow()

    for I = #PendingAttacks, 1, -1 do
        local Attack = PendingAttacks[I]

        if Now >= Attack.hit + ATTACK_RETURN_DELAY then
            table.remove(PendingAttacks, I)
        end
    end
end

local function IsDangerous(X, Z)
    for _, Attack in ipairs(PendingAttacks) do
        local Success, Hit = pcall(function()
            return Boss.hits(
                Attack.shapes,
                X,
                Z,
                -DODGE_MARGIN
            )
        end)

        if Success and Hit then
            return true
        end
    end

    return false
end

--============================================================
-- FIND SAFE POSITION
--============================================================

local function FindSafePosition(Root)
    local Centre = Boss.CENTRE
    local Current = Root.Position

    local BestPosition = nil
    local BestScore = math.huge

    local Kurama = GetKurama()
    local KuramaRoot = Kurama and GetRoot(Kurama)

    local function CheckCandidate(X, Z)
        if not IsDangerous(X, Z) then
            local DistanceFromPlayer = (
                Vector2.new(X, Z)
                - Vector2.new(Current.X, Current.Z)
            ).Magnitude

            local DistanceFromKurama = 0

            if KuramaRoot and KuramaRoot.Parent then
                DistanceFromKurama = (
                    Vector2.new(X, Z)
                    - Vector2.new(
                        KuramaRoot.Position.X,
                        KuramaRoot.Position.Z
                    )
                ).Magnitude
            else
                DistanceFromKurama = (
                    Vector2.new(X, Z)
                    - Vector2.new(Centre.X, Centre.Z)
                ).Magnitude
            end

            local Score =
                DistanceFromKurama + DistanceFromPlayer * 0.15

            if Score < BestScore then
                BestScore = Score

                BestPosition = Vector3.new(
                    X,
                    Current.Y,
                    Z
                )
            end
        end
    end

    -- PRIORITAS 1: AREA SEKITAR KURAMA
    if KuramaRoot and KuramaRoot.Parent then
        local BossPosition = KuramaRoot.Position

        for Radius = 8, DODGE_SEARCH_MAX, 2 do
            for Angle = 0, 350, SAFE_ANGLE_STEP do
                local Radians = math.rad(Angle)

                local X =
                    BossPosition.X + math.cos(Radians) * Radius

                local Z =
                    BossPosition.Z + math.sin(Radians) * Radius

                CheckCandidate(X, Z)
            end
        end
    end

    -- PRIORITAS 2: AREA ARENA
    if not BestPosition then
        local MaxRadius = math.max(
            10,
            Boss.INSIDE_RADIUS - 8
        )

        for Radius = SAFE_RADIUS_START, MaxRadius, SAFE_RADIUS_STEP do
            for Angle = 0, 350, SAFE_ANGLE_STEP do
                local Radians = math.rad(Angle)

                local X =
                    Centre.X + math.cos(Radians) * Radius

                local Z =
                    Centre.Z + math.sin(Radians) * Radius

                CheckCandidate(X, Z)
            end
        end
    end

    return BestPosition
end

--============================================================
-- STOP DODGE MOVEMENT
--============================================================

local function StopDodgeMovement()
    local Humanoid = GetHumanoid()
    local Root = GetCharacterRoot()

    if Humanoid and Root then
        pcall(function()
            Humanoid:MoveTo(Root.Position)
        end)
    end

    SetDodgeWalking(false)

    SavedPosition = nil
    DodgeMoveTarget = nil
    ReturningFromDodge = false
    ReturnStarted = 0
end

--============================================================
-- MOVE TO SAFE POSITION | WALK ONLY
--============================================================

local function MoveToSafePosition(Position)
    if not Position then return false end

    local _, Humanoid, Root = GetAliveCharacter()

    if not Humanoid or not Root then
        return false
    end

    SetDodgeWalking(true)

    DodgeMoveTarget = Position

    pcall(function()
        Humanoid:MoveTo(Position)
    end)

    return true
end

--============================================================
-- RETURN TO SAVED POSITION | WALK ONLY
--============================================================

local function ReturnToSavedPosition()
    if not SavedPosition then
        StopDodgeMovement()
        return
    end

    local _, Humanoid, Root = GetAliveCharacter()

    if not Humanoid or not Root then
        StopDodgeMovement()
        return
    end

    if not ReturningFromDodge then
        ReturningFromDodge = true
        ReturnStarted = os.clock()

        SetDodgeWalking(true)

        pcall(function()
            Humanoid:MoveTo(SavedPosition)
        end)
    end

    local Distance = (
        Root.Position - SavedPosition
    ).Magnitude

    if Distance <= DODGE_RETURN_DISTANCE
        or os.clock() - ReturnStarted >= DODGE_RETURN_TIMEOUT then

        StopDodgeMovement()
    end
end

--============================================================
-- DODGE WORKER
--============================================================

local function StartDodgeWorker()
    if DodgeWorkerRunning or Destroyed then return end

    DodgeWorkerRunning = true

    task.spawn(function()
        while not Destroyed do
            CleanAttacks()

            local Phase = Workspace:GetAttribute("BossPhase")

            if not AutoDodgeEnabled or Phase ~= "fight" then
                if SavedPosition or DodgeWalking then
                    StopDodgeMovement()
                end

                task.wait(0.05)
                continue
            end

            local _, Humanoid, Root = GetAliveCharacter()

            if not Humanoid or not Root then
                task.wait(0.05)
                continue
            end

            if #PendingAttacks > 0 then
                local Unsafe = IsDangerous(
                    Root.Position.X,
                    Root.Position.Z
                )

                if Unsafe then
                    -- DODGE MENGAMBIL PRIORITAS.
                    if not SavedPosition then
                        SavedPosition = Root.Position
                        ReturningFromDodge = false
                    end

                    if os.clock() >= NextDodgeMove then
                        NextDodgeMove =
                            os.clock() + DODGE_RECHECK_DELAY

                        local SafePosition = FindSafePosition(Root)

                        if SafePosition then
                            MoveToSafePosition(SafePosition)
                        end
                    end
                end

                ReturningFromDodge = false

            elseif SavedPosition then
                ReturnToSavedPosition()
            end

            task.wait(0.03)
        end

        StopDodgeMovement()
        DodgeWorkerRunning = false
    end)
end

