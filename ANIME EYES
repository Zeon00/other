--============================================================
-- ENEMY ORBIT
--============================================================

local function GetOrbitTarget()
    local Enemies = GetEnemies()

    if CurrentOrbitModel then
        for _, Data in ipairs(Enemies) do
            if Data.Model == CurrentOrbitModel then
                return Data
            end
        end
    end

    local Nearest = nil
    local NearestDistance = ENEMY_SCAN_DISTANCE

    for _, Data in ipairs(Enemies) do
        if Data.Distance < NearestDistance then
            NearestDistance = Data.Distance
            Nearest = Data
        end
    end

    CurrentOrbitModel = Nearest and Nearest.Model or nil

    return Nearest
end

local function GetSafeOrbitPosition(PlayerRoot, TargetRoot)
    if not TargetRoot or not TargetRoot.Parent then
        return nil
    end

    local Angle = os.clock() * ORBIT_SPEED

    local Offset = Vector3.new(
        math.cos(Angle) * ORBIT_RADIUS,
        0,
        math.sin(Angle) * ORBIT_RADIUS
    )

    local DesiredPosition = TargetRoot.Position + Offset

    local Params = RaycastParams.new()
    Params.FilterType = Enum.RaycastFilterType.Exclude

    local Exclude = {}

    if GetCharacter() then
        table.insert(Exclude, GetCharacter())
    end

    if CurrentOrbitModel then
        table.insert(Exclude, CurrentOrbitModel)
    end

    Params.FilterDescendantsInstances = Exclude

    local Result = Workspace:Raycast(
        DesiredPosition + Vector3.new(0, 25, 0),
        Vector3.new(0, -100, 0),
        Params
    )

    if not Result then return nil end

    return Result.Position + Vector3.new(0, ORBIT_HEIGHT, 0)
end

local function ProcessOrbit(DeltaTime)
    if not EnemiesEnabled or Destroyed then
        CurrentOrbitModel = nil
        return
    end

    if GetKurama() and KuramaEnabled then
        CurrentOrbitModel = nil
        return
    end

    local PlayerRoot = GetCharacterRoot()
    if not PlayerRoot then return end

    local Target = GetOrbitTarget()

    if not Target or not Target.Root then
        CurrentOrbitModel = nil
        return
    end

    local SafePosition =
        GetSafeOrbitPosition(PlayerRoot, Target.Root)

    if not SafePosition then return end

    local LookAtPosition = Vector3.new(
        Target.Root.Position.X,
        SafePosition.Y,
        Target.Root.Position.Z
    )

    local Goal = CFrame.lookAt(SafePosition, LookAtPosition)

    local Alpha = math.clamp(
        DeltaTime * ORBIT_SMOOTHNESS,
        0,
        0.12
    )

    PlayerRoot.CFrame = PlayerRoot.CFrame:Lerp(Goal, Alpha)
end

