--============================================================
-- AUTO WALK INTO KURAMA
-- DODGE ALWAYS HAS PRIORITY
--============================================================

local function StopKuramaWalk()
    if not KuramaWalkActive then return end

    local Humanoid = GetHumanoid()
    local Root = GetCharacterRoot()

    if Humanoid and Root then
        pcall(function()
            Humanoid:MoveTo(Root.Position)
        end)
    end

    KuramaWalkActive = false
    LastKuramaWalkTarget = nil
    LastKuramaWalkCommand = 0
end

local function GetKuramaWalkPosition(KuramaRoot, PlayerRoot)
    local BossPosition = KuramaRoot.Position
    local PlayerPosition = PlayerRoot.Position

    local Direction = Vector3.new(
        PlayerPosition.X - BossPosition.X,
        0,
        PlayerPosition.Z - BossPosition.Z
    )

    if Direction.Magnitude < 0.1 then
        Direction = Vector3.new(1, 0, 0)
    else
        Direction = Direction.Unit
    end

    -- Posisi berhenti di luar tubuh Kurama.
    local TargetPosition =
        BossPosition + Direction * KURAMA_WALK_DISTANCE

    return Vector3.new(
        TargetPosition.X,
        PlayerPosition.Y,
        TargetPosition.Z
    )
end

local function StartKuramaWalkWorker()
    if KuramaWalkRunning or Destroyed then return end

    KuramaWalkRunning = true

    task.spawn(function()
        while not Destroyed do
            -- TOGGLE OFF
            if not AutoWalkKuramaEnabled then
                StopKuramaWalk()
                task.wait(0.15)
                continue
            end

            -- DODGE PRIORITY
            -- Jangan jalankan pendekatan ketika dodge sedang aktif.
            if DodgeWalking
                or SavedPosition ~= nil
                or ReturningFromDodge
                or #PendingAttacks > 0 then

                task.wait(0.08)
                continue
            end

            local Phase = Workspace:GetAttribute("BossPhase")

            if Phase ~= "fight" then
                StopKuramaWalk()
                task.wait(0.2)
                continue
            end

            local _, Humanoid, PlayerRoot = GetAliveCharacter()

            local Kurama = GetKurama()
            local KuramaRoot = Kurama and GetRoot(Kurama)

            if not Humanoid
                or not PlayerRoot
                or not KuramaRoot
                or not KuramaRoot.Parent then

                StopKuramaWalk()
                task.wait(0.2)
                continue
            end

            local Distance = (
                PlayerRoot.Position - KuramaRoot.Position
            ).Magnitude

            -- SUDAH CUKUP DEKAT
            if Distance <= KURAMA_STOP_DISTANCE then
                if KuramaWalkActive then
                    StopKuramaWalk()
                end

                task.wait(0.15)
                continue
            end

            -- UPDATE POSISI BERKALA AGAR MENGIKUTI KURAMA
            if os.clock() - LastKuramaWalkCommand
                >= KURAMA_WALK_REFRESH then

                LastKuramaWalkCommand = os.clock()

                local TargetPosition = GetKuramaWalkPosition(
                    KuramaRoot,
                    PlayerRoot
                )

                -- Pastikan dodge belum mengambil alih.
                if not DodgeWalking
                    and SavedPosition == nil
                    and #PendingAttacks == 0 then

                    KuramaWalkActive = true
                    LastKuramaWalkTarget = TargetPosition

                    -- Kecepatan normal Player Speed.
                    ApplyPlayerSpeed()

                    pcall(function()
                        Humanoid:MoveTo(TargetPosition)
                    end)
                end
            end

            task.wait(0.08)
        end

        StopKuramaWalk()
        KuramaWalkRunning = false
    end)
end

