    StateLabel.TextSize = 9
    StateLabel.Parent = Button

    Instance.new("UICorner", StateLabel).CornerRadius = UDim.new(0, 5)

    local State = DefaultState == true

    local function Refresh()
        StateLabel.Text = State and "ON" or "OFF"

        StateLabel.BackgroundColor3 = State
            and Color3.fromRGB(35, 155, 95)
            or Color3.fromRGB(95, 65, 72)

        Button.BackgroundColor3 = State
            and Color3.fromRGB(43, 65, 66)
            or Color3.fromRGB(42, 46, 63)
    end

    Track(Button.MouseButton1Click:Connect(function()
        if Destroyed then return end

        State = not State
        Refresh()

        Callback(State)
        UpdateStatus()
    end))

    Refresh()

    return Button
end

