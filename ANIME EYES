--============================================================
-- CHARACTER HELPERS
--============================================================

local function GetCharacter()
    return Player.Character
end

local function GetCharacterRoot()
    local Character = GetCharacter()
    if not Character then return nil end

    return Character:FindFirstChild("HumanoidRootPart")
end

local function GetHumanoid()
    local Character = GetCharacter()
    if not Character then return nil end

    return Character:FindFirstChildWhichIsA("Humanoid")
end

local function GetAliveCharacter()
    local Character = GetCharacter()
    if not Character then return nil end

    local Humanoid = Character:FindFirstChildWhichIsA("Humanoid")
    local Root = Character:FindFirstChild("HumanoidRootPart")

    if not Humanoid or not Root or Humanoid.Health <= 0 then
        return nil
    end

    return Character, Humanoid, Root
end

--============================================================
-- PLAYER SPEED
--============================================================

local function ApplyPlayerSpeed()
    if Destroyed then return end

    local Humanoid = GetHumanoid()

    if Humanoid and Humanoid.Health > 0 then
        pcall(function()
            if DodgeWalking then
                Humanoid.WalkSpeed = DODGE_WALK_SPEED
            else
                Humanoid.WalkSpeed = PlayerSpeed
            end
        end)
    end
end

local function SetDodgeWalking(State)
    DodgeWalking = State == true
    ApplyPlayerSpeed()
end

--============================================================
-- AUTO TP POSITION | POS 1 -> POS 2
--============================================================

local function ProcessAutoTPPosition()
    if Destroyed or not AutoTPEnabled then return end
    if os.clock() < NextPositionCheck then return end

    NextPositionCheck = os.clock() + TP_CHECK_DELAY

    local Root = GetCharacterRoot()
    if not Root then return end

    local Distance = (
        Root.Position - TP_TRIGGER_POSITION
    ).Magnitude

    if Distance <= TP_TOLERANCE then
        Root.CFrame =
            CFrame.new(TP_TARGET_POSITION) * Root.CFrame.Rotation

        Root.AssemblyLinearVelocity = Vector3.zero
    end
end

--============================================================
-- MODEL HELPERS
--============================================================

local function GetRoot(Object)
    if not Object then return nil end

    if Object:IsA("BasePart") then
        return Object
    end

    if Object:IsA("Model") then
        return Object.PrimaryPart
            or Object:FindFirstChild("HumanoidRootPart")
            or Object:FindFirstChild("Torso")
            or Object:FindFirstChildWhichIsA("BasePart", true)
    end

    return nil
end

local function IsAlive(Object)
    if not Object or not Object.Parent then
        return false
    end

    local Humanoid = Object:FindFirstChildWhichIsA("Humanoid", true)

    if Humanoid and Humanoid.Health <= 0 then
        return false
    end

    return GetRoot(Object) ~= nil
end

