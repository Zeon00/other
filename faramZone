--========================================================
-- SNOW FARM - ACTIVE ZONE + BOSS PRIORITY + CHEST + ENTRY
--========================================================

local ORBIT_RADIUS = 12
local ORBIT_HEIGHT = 12
local ORBIT_SPEED = 2
local ATTACK_INTERVAL = 0.1
local SKILL_INTERVAL = 0.05
local EMPTY_CONFIRM_TIME = 1.5
local ZONE_WAIT_TIME = 5
local CHEST_RANGE = 50
local MOB_RANGE = 100

local Inputs = ReplicatedStorage
    :WaitForChild("Player")
    :WaitForChild("Remotes")
    :WaitForChild("Inputs")

local AttackRemote = Inputs:WaitForChild("Attack")
local SkillRemote = Inputs:WaitForChild("Skill")

local function getRoot()
    local character = player.Character
    if not character then return nil end
    return character:FindFirstChild("HumanoidRootPart") or character.PrimaryPart
end

local function getMap()
    for _, object in ipairs(Workspace:GetChildren()) do
        if object.Name:match("^Generated_Snow_") and object:FindFirstChild("NPCs") then
            return object
        end
    end
    return nil
end

local function getMobPart(model)
    if not model then return nil end
    if model:IsA("BasePart") then return model end
    if not model:IsA("Model") then return nil end

    for _, name in ipairs({"HumanoidRootPart", "UpperTorso", "Torso", "LowerTorso", "Head"}) do
        local part = model:FindFirstChild(name, true)
        if part and part:IsA("BasePart") then return part end
    end
    for _, obj in ipairs(model:GetDescendants()) do
        if obj:IsA("BasePart") then return obj end
    end
    return nil
end

local function isDead(model)
    if not model or not model.Parent then return true end
    local humanoid = model:IsA("Model") and (model:FindFirstChildOfClass("Humanoid")
        or model:FindFirstChildWhichIsA("Humanoid", true))
    if humanoid then return humanoid.Health <= 0 end

    local state = model:GetAttribute("State")
    if state == nil and model:IsA("Model") then
        local value = model:FindFirstChild("State", true)
        if value and (value:IsA("StringValue") or value:IsA("BoolValue")) then
            state = value.Value
        end
    end
    if type(state) == "string" then
        local v = string.lower(state)
        if v == "dead" or v == "died" or v == "destroyed" or v == "despawned" then
            return true
        end
    elseif type(state) == "boolean" and state then
        return true
    end
    local health = model:GetAttribute("Health")
    return type(health) == "number" and health <= 0
end

local function getWallCaps(map)
    local rooms = {}
    for _, obj in ipairs(map:GetChildren()) do
        if obj:IsA("Model") and obj.Name:match("^WallCap_Side_Room_%d+$") then
            table.insert(rooms, obj)
        end
    end
    table.sort(rooms, function(a, b)
        return (tonumber(a.Name:match("(%d+)$")) or 0)
            < (tonumber(b.Name:match("(%d+)$")) or 0)
    end)
    return rooms
end

-- Bounds use the actual WallCap model bounding box. Rotated rooms are supported.
local function getZoneBounds(zone)
    if not zone or not zone.Parent then return nil end
    local ok, cf, size = pcall(function()
        return zone:GetBoundingBox()
    end)
    if ok and cf and size then return cf, size end
    return nil
end

local function isInsideZone(position, zone)
    local cf, size = getZoneBounds(zone)
    if not cf then return false end
    local localPos = cf:PointToObjectSpace(position)
    return math.abs(localPos.X) <= size.X / 2
        and math.abs(localPos.Y) <= size.Y / 2
        and math.abs(localPos.Z) <= size.Z / 2
end

-- Current zone is the WallCap volume containing the player's current position.
-- If bounds overlap, use the smallest volume as the most specific room.
local function getPlayerActiveZone(map)
    local root = getRoot()
    if not root then return nil end
    local selected, selectedVolume
    for _, zone in ipairs(getWallCaps(map)) do
        if isInsideZone(root.Position, zone) then
            local _, size = getZoneBounds(zone)
            local volume = size and size.X * size.Y * size.Z or math.huge
            if not selected or volume < selectedVolume then
                selected, selectedVolume = zone, volume
            end
        end
    end
    return selected
end

local function getChestPart(chest)
    if chest:IsA("BasePart") then return chest end
    if chest:IsA("Model") then return getMobPart(chest) end
    for _, obj in ipairs(chest:GetDescendants()) do
        if obj:IsA("BasePart") then return obj end
    end
    return nil
end

-- Chests are direct children of Generated_Snow_xxx; only accept chests
-- physically inside the player's active WallCap and within 50 studs.
local function getNearbyDungeonChest(map, activeZone)
    local root = getRoot()
    if not root or not activeZone then return nil end
    local nearest, nearestDistance = nil, CHEST_RANGE
    for _, chest in ipairs(map:GetChildren()) do
        if chest.Name:match("^DungeonChest_") then
            local part = getChestPart(chest)
            if part and isInsideZone(part.Position, activeZone) then
                local distance = (part.Position - root.Position).Magnitude
                if distance <= nearestDistance then
                    nearest, nearestDistance = chest, distance
                end
            end
        end
    end
    return nearest
end

local function getBoss(map)
    local folder = map and map:FindFirstChild("NPCs")
    local boss = folder and folder:FindFirstChild("Valkskar", true)
    if boss and (boss:IsA("Model") or boss:IsA("BasePart")) and not isDead(boss) then
        local part = getMobPart(boss)
        if part then return {model = boss, part = part, isBoss = true} end
    end
    return nil
end

local function getActiveZoneTargets(map, zone)
    local targets = {}
    local folder = map and map:FindFirstChild("NPCs")
    -- Saat stage baru mulai, player mungkin belum berada di dalam bounds WallCap.
    -- Dalam kondisi itu scan seluruh NPCs agar mob yang sudah mengepung tetap diserang.
    if not folder then return targets end

    for _, model in ipairs(folder:GetDescendants()) do
        if model:IsA("Model") and model.Parent and not isDead(model) then
            local nested = false
            local ancestor = model.Parent
            while ancestor and ancestor ~= folder do
                if ancestor:IsA("Model") then nested = true break end
                ancestor = ancestor.Parent
            end
            if not nested then
                local part = getMobPart(model)
                if part and part:IsDescendantOf(folder)
                    and (not zone or isInsideZone(part.Position, zone)) then
                    table.insert(targets, {model = model, part = part})
                end
            end
        end
    end
    return targets
end

local function getEntryDestination(zone)
    local connectors = zone and zone:FindFirstChild("Connectors")
    local entry = connectors and connectors:FindFirstChild("Entry", true)
    if entry then
        local part = getMobPart(entry)
        if part then return part.CFrame + Vector3.new(0, 4, 0) end
        if entry:IsA("Model") then return entry:GetPivot() + Vector3.new(0, 4, 0) end
    end
    return zone:GetPivot() + Vector3.new(0, 4, 0)
end

local function getNextZone(map, currentZone)
    local rooms = getWallCaps(map)
    if #rooms == 0 then return nil end
    if not currentZone then return rooms[1] end
    local currentIndex = table.find(rooms, currentZone)
    if not currentIndex then return rooms[1] end
    return rooms[(currentIndex % #rooms) + 1]
end

local function teleportTo(cframe)
    local character = player.Character
    if not character then return false end
    local ok, err = pcall(function()
        character:PivotTo(cframe)
    end)
    if not ok then warn("[Snow Farm TP]", err) end
    return ok
end

local function snowFarmLoop(runId)
    local currentModel
    local lockedY
    local angle = 0
    local lastAttack, lastSkill = 0, 0
    local skillNumber = 1
    -- Patrol Entry berurutan berdasarkan nomor WallCap (Room_1, Room_2, ...).
    local entryMap
    local entryIndex = 1

    while featureRunning("AutoFarmSnowZone", runId) do
        local map = getMap()
        local root = getRoot()

        if not map then
            setStatus("WAITING FOR SNOW MAP")
            task.wait(0.3)
            continue
        end
        if not root then
            setStatus("WAITING FOR CHARACTER")
            task.wait(0.2)
            continue
        end

        -- Scan SEMUA NPC dalam map.NPCs, tanpa filter WallCap / room.
        -- Hanya target yang berjarak maksimal 100 studs dari player.
        local targets = getActiveZoneTargets(map, nil)
        local target
        local nearestDistance = MOB_RANGE

        for _, data in ipairs(targets) do
            local part = data.part
            if part and part.Parent and not isDead(data.model) then
                local distance = (part.Position - root.Position).Magnitude
                if distance <= nearestDistance then
                    nearestDistance = distance
                    target = data
                end
            end
        end

        if not target then
            currentModel = nil
            lockedY = nil

            -- Jika tidak ada mob dalam radius 100 studs, patrol Entry
            -- berdasarkan nomor WallCap dari kecil ke besar, BUKAN jarak.
            if entryMap ~= map then
                entryMap = map
                entryIndex = 1
            end

            local rooms = getWallCaps(map) -- sudah diurutkan Room_1, Room_2, ...
            local entryDestination
            local selectedRoom
            local checked = 0

            while #rooms > 0 and checked < #rooms do
                if entryIndex > #rooms then entryIndex = 1 end
                local zone = rooms[entryIndex]
                -- Geser pointer supaya kunjungan berikutnya selalu room berikutnya.
                entryIndex = entryIndex + 1
                checked = checked + 1

                local connectors = zone:FindFirstChild("Connectors")
                local entry = connectors and connectors:FindFirstChild("Entry", true)
                if entry then
                    local entryPart = getMobPart(entry)
                    if entryPart then
                        entryDestination = entryPart.CFrame + Vector3.new(0, 4, 0)
                    elseif entry:IsA("Model") then
                        entryDestination = entry:GetPivot() + Vector3.new(0, 4, 0)
                    end
                    if entryDestination then
                        selectedRoom = zone
                        break
                    end
                end
            end

            if entryDestination then
                setStatus("NO MOB IN 100 STUDS - ENTRY " .. selectedRoom.Name)
                teleportTo(entryDestination)
                task.wait(0.45) -- beri waktu NPC muncul, lalu scan radius lagi
            else
                setStatus("NO MOB IN 100 STUDS - ENTRY NOT FOUND")
                task.wait(0.5)
            end
            continue
        end

        local part = getMobPart(target.model)
        if not part or not part.Parent then
            task.wait(0.05)
            continue
        end

        -- Reset ketinggian orbit setiap ganti target.
        if currentModel ~= target.model then
            currentModel = target.model
            lockedY = part.Position.Y + ORBIT_HEIGHT
            angle = 0
        end

        setStatus("ATTACKING: " .. target.model.Name .. " | " .. math.floor(nearestDistance) .. " STUDS",
            Color3.fromRGB(125, 235, 155))

        local dt = RunService.Heartbeat:Wait()
        if not featureRunning("AutoFarmSnowZone", runId) then break end

        root = getRoot()
        part = getMobPart(target.model)
        if root and part and part.Parent and not isDead(target.model) then
            local pos = part.Position
            angle += ORBIT_SPEED * dt
            local destination = Vector3.new(
                pos.X + math.cos(angle) * ORBIT_RADIUS,
                lockedY or (pos.Y + ORBIT_HEIGHT),
                pos.Z + math.sin(angle) * ORBIT_RADIUS
            )

            -- Dekati target lalu terus serang sampai mati / keluar radius.
            root.CFrame = CFrame.lookAt(destination, Vector3.new(pos.X, destination.Y, pos.Z))

            local now = os.clock()
            if now - lastAttack >= ATTACK_INTERVAL then
                pcall(function()
                    AttackRemote:FireServer(pos)
                end)
                lastAttack = now
            end

            if now - lastSkill >= SKILL_INTERVAL then
                pcall(function()
                    SkillRemote:FireServer(skillNumber, "tap", pos, nil)
                end)
                skillNumber = (skillNumber % 4) + 1
                lastSkill = now
            end
        else
            currentModel = nil
            lockedY = nil
            task.wait(0.05)
        end
    end
end

