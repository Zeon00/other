        state = value == true

        if state then
            switch.BackgroundColor3 = Color3.fromRGB(112, 70, 220)
            knob.Position = UDim2.new(1, -22, 0, 3)
        else
            switch.BackgroundColor3 = Color3.fromRGB(70, 68, 80)
            knob.Position = UDim2.fromOffset(3, 3)
        end

        if callCallback and callback then
            local ok, err = pcall(callback, state)
            if not ok then
                warn("[Automation Hub] " .. label .. ": " .. tostring(err))
            end
        end
    end

    switch.Activated:Connect(function()
        setState(not state, true)
    end)

    setState(defaultState == true, false)

    if defaultState == true and callback then
        task.defer(function()
            if alive() then
                local ok, err = pcall(callback, true)
                if not ok then
                    warn("[Automation Hub] " .. label .. ": " .. tostring(err))
                end
            end
        end)
    end

    return function(value)
        setState(value, true)
    end
end

