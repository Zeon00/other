--========================================================
-- SNOW FARM
--========================================================

local ORBIT_RADIUS = 12
local ORBIT_HEIGHT = 12
local ORBIT_SPEED = 2
local ATTACK_INTERVAL = 0.1
local SKILL_INTERVAL = 0.05
local EMPTY_CONFIRM_TIME = 1.5
local ZONE_WAIT_TIME = 5

local Inputs = ReplicatedStorage
    :WaitForChild("Player")
    :WaitForChild("Remotes")
    :WaitForChild("Inputs")

local AttackRemote = Inputs:WaitForChild("Attack")
local SkillRemote = Inputs:WaitForChild("Skill")

local function getRoot()
    local character = player.Character
    if not character then
        return nil
    end

    return character:FindFirstChild("HumanoidRootPart")
        or character.PrimaryPart
end

local function getMap()
    for _, object in ipairs(Workspace:GetChildren()) do
        if object.Name:match("^Generated_Snow_")
            and object:FindFirstChild("NPCs") then
            return object
        end
    end
    return nil
end



local function getMobPart(model)
    if not model or not model:IsA("Model") then
        return nil
    end

    -- Prioritas pertama: part badan
    for _, name in ipairs({
        "HumanoidRootPart",
        "UpperTorso",
        "Torso",
        "LowerTorso",
        "Head",
    }) do
        local part = model:FindFirstChild(name, true)

        if part and part:IsA("BasePart") then
            return part
        end
    end

    -- Prioritas kedua: Handle milik Accessory
    for _, obj in ipairs(model:GetDescendants()) do
        if obj:IsA("Accessory") then
            local handle = obj:FindFirstChild("Handle")

            if handle and handle:IsA("BasePart") then
                return handle
            end
        end
    end

    -- Prioritas terakhir: BasePart apa pun
    for _, obj in ipairs(model:GetDescendants()) do
        if obj:IsA("BasePart") then
            return obj
        end
    end

    return nil
end



-- Status NPC yang tahan terhadap atribut State lama/stale.
local function isDead(model)
    if not model or not model:IsA("Model") or not model.Parent then
        return true
    end

    local humanoid = model:FindFirstChildOfClass("Humanoid")
        or model:FindFirstChildWhichIsA("Humanoid", true)

    -- Kalau ada Humanoid, Health adalah sumber utama.
    if humanoid then
        return humanoid.Health <= 0
    end

    -- NPC custom tanpa Humanoid: baca Attribute atau Value object.
    local state = model:GetAttribute("State")
    if state == nil then
        local stateValue = model:FindFirstChild("State", true)
        if stateValue and (stateValue:IsA("StringValue") or stateValue:IsA("BoolValue")) then
            state = stateValue.Value
        end
    end

    if type(state) == "string" then
        local normalized = string.lower(state)
        return normalized == "dead"
            or normalized == "died"
            or normalized == "destroyed"
            or normalized == "despawned"
    elseif type(state) == "boolean" then
        return state == true
    end

    local health = model:GetAttribute("Health")
    if type(health) == "number" then
        return health <= 0
    end

    return false
end

-- Scan semua descendant, termasuk NPC yang disimpan di subfolder.
-- Model yang berada di dalam model NPC tidak dihitung sebagai NPC terpisah.
local function getNPCState(map)
    local targets = {}
    local folder = map and map:FindFirstChild("NPCs")

    if not folder then
        return targets, false
    end

    for _, model in ipairs(folder:GetDescendants()) do
        if model:IsA("Model") and model.Parent and not isDead(model) then
            local hasModelAncestor = false
            local ancestor = model.Parent

            while ancestor and ancestor ~= folder do
                if ancestor:IsA("Model") then
                    hasModelAncestor = true
                    break
                end
                ancestor = ancestor.Parent
            end

            if not hasModelAncestor then
                local part = getMobPart(model)
                if part and part.Parent and part:IsDescendantOf(folder) then
                    table.insert(targets, {
                        model = model,
                        part = part,
                    })
                end
            end
        end
    end

    -- Log hanya saat jumlah target berubah agar Output tidak spam.
    if _G._SnowFarmLastNPCCount ~= #targets then
        _G._SnowFarmLastNPCCount = #targets
        print("[Snow Farm] NPC valid:", #targets, "|", folder:GetFullName())
        for index, target in ipairs(targets) do
            print("[Snow Farm] Target", index, target.model:GetFullName(), "->", target.part.Name)
        end
    end

    return targets, #targets > 0
end


--========================================================
-- DUNGEON CHEST SCANNER - PENGGANTI WALLCAP
--========================================================

local function getDungeonChests(map)
    local chests = {}

    if not map then
        return chests
    end

    for _, obj in ipairs(map:GetDescendants()) do
        if obj:IsA("Model")
            and obj.Name:match("^DungeonChest_.+") then
            table.insert(chests, obj)
        end
    end

    table.sort(chests, function(a, b)
        return a.Name < b.Name
    end)

    return chests
end

local function getChestDestination(chest)
    return chest:GetPivot().Position + Vector3.new(0, 4, 0)
end

local function snowFarmLoop(runId)
    local currentTarget
    local lockedY
    local angle = 0
    local lastAttack = 0
    local lastSkill = 0
    local skillNumber = 1
    local emptySince
    local visitedZones = {}

    while featureRunning("AutoFarmSnowZone", runId) do
        local map = getMap()

        if not map then
            currentTarget = nil
            lockedY = nil
            setStatus("WAITING FOR SNOW MAP")
            task.wait(0.5)
            continue
        end

        local root = getRoot()
        if not root then
            setStatus("WAITING FOR CHARACTER")
            task.wait(0.25)
            continue
        end

        local targets, hasNPC = getNPCState(map)

        if hasNPC then
            emptySince = nil

            if not currentTarget
                or not currentTarget.model.Parent
                or isDead(currentTarget.model)
                or not currentTarget.part.Parent then

                currentTarget = nil
                lockedY = nil

                local nearestDistance = math.huge

                for _, data in ipairs(targets) do
                    if data.part and data.part.Parent then
                        local distance = (data.part.Position - root.Position).Magnitude
                        if distance < nearestDistance then
                            nearestDistance = distance
                            currentTarget = data
                        end
                    end
                end

                if currentTarget then
                    local part = currentTarget.part
                    angle = math.atan2(
                        root.Position.Z - part.Position.Z,
                        root.Position.X - part.Position.X
                    )
                    lockedY = part.Position.Y + ORBIT_HEIGHT
                end
            end

            if not currentTarget then
                setStatus("NPC PRESENT - WAITING FOR TARGET")
                task.wait(0.15)
                continue
            end

-- Refresh part target setiap loop, bukan memakai part lama terus
local part = getMobPart(currentTarget.model)

if not part or not part.Parent then
    currentTarget = nil
    lockedY = nil
    task.wait(0.1)
    continue
end

currentTarget.part = part

            setStatus("FARMING: " .. currentTarget.model.Name,
                Color3.fromRGB(125, 235, 155))

            local dt = RunService.Heartbeat:Wait()
            if not featureRunning("AutoFarmSnowZone", runId) then
                break
            end

            root = getRoot()

            if root and part.Parent and not isDead(currentTarget.model) then
                angle += ORBIT_SPEED * dt
                local targetPosition = part.Position

                local destination = Vector3.new(
                    targetPosition.X + math.cos(angle) * ORBIT_RADIUS,
                    lockedY,
                    targetPosition.Z + math.sin(angle) * ORBIT_RADIUS
                )

                root.CFrame = CFrame.lookAt(
                    destination,
                    Vector3.new(targetPosition.X, lockedY, targetPosition.Z)
                )

                local now = os.clock()

                if now - lastAttack >= ATTACK_INTERVAL then
                    pcall(function()
                        AttackRemote:FireServer(targetPosition)
                    end)
                    lastAttack = now
                end

                if now - lastSkill >= SKILL_INTERVAL then
                    pcall(function()
                        SkillRemote:FireServer(skillNumber, "tap", targetPosition, nil)
                    end)
                    skillNumber = (skillNumber % 4) + 1
                    lastSkill = now
                end
            end
        else
            currentTarget = nil
            lockedY = nil

            emptySince = emptySince or os.clock()
            setStatus("CHECKING NPC CLEAR")

            if os.clock() - emptySince < EMPTY_CONFIRM_TIME then
                task.wait(0.15)
                continue
            end

            local _, stillHasNPC = getNPCState(map)
            if stillHasNPC then
                emptySince = nil
                continue
            end

                        -- NPC kosong: teleport ke semua DungeonChest.
            local chests = getDungeonChests(map)

            if #chests == 0 then
                setStatus("WAITING FOR DUNGEON CHESTS")
                task.wait(0.75)
                continue
            end

            local candidates = {}

            for _, chest in ipairs(chests) do
                if chest:IsDescendantOf(map)
                    and not visitedZones[chest] then
                    table.insert(candidates, chest)
                end
            end

            if #candidates == 0 then
                visitedZones = {}

                for _, chest in ipairs(chests) do
                    if chest:IsDescendantOf(map) then
                        table.insert(candidates, chest)
                    end
                end
            end

            if #candidates == 0 then
                task.wait(0.25)
                continue
            end

            local _, npcAppeared = getNPCState(map)
            if npcAppeared then
                emptySince = nil
                continue
            end

            local chest = candidates[1]
            visitedZones[chest] = true
            root = getRoot()

            if root and chest.Parent then
                local ok, err = pcall(function()
                    root.CFrame = CFrame.new(
                        getChestDestination(chest)
                    )
                end)

                if not ok then
                    warn("[DungeonChest TP]", err)
                end
            end

            setStatus("TP CHEST: " .. chest.Name,
                Color3.fromRGB(125, 235, 155))

            local deadline = os.clock() + ZONE_WAIT_TIME

            while featureRunning("AutoFarmSnowZone", runId)
                and os.clock() < deadline do

                task.wait(0.15)

                local latestMap = getMap()
                if latestMap then
                    map = latestMap
                end

                local _, spawned = getNPCState(map)
                if spawned then
                    emptySince = nil
                    break
                end
            end

            emptySince = nil
        end
    end
end

