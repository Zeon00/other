-- AUTO SELECT BOOST
--========================================================

addToggle("Auto Select Boost", true, function(state)
    _G.AutoSelectBoost = state
    local id = nextRunId("AutoSelectBoost")
    if not state then return end

    task.spawn(function()
        local controller

        local ok, err = pcall(function()
            controller = getKnit().GetController("BoostSelectionController")
        end)

        if not ok or not controller then
            warn("[Auto Boost] Controller gagal:", err)
            return
        end

        local function getPriority(candidate)
            local title = string.lower(tostring(candidate.Title or ""))
            local desc = string.lower(tostring(candidate.Description or ""))
            local combined = title .. " " .. desc

            if combined:find("overall damage", 1, true) then
                return 1
            end

            if combined:find("max hp", 1, true)
                or combined:find("maximum hp", 1, true)
                or combined:find("max health", 1, true)
                or combined:find("maximum health", 1, true) then
                return 2
            end

            return 99
        end

        while featureRunning("AutoSelectBoost", id) do
            if controller._active
                and controller._ready
                and not controller._selecting
                and type(controller._candidates) == "table" then

                local candidates = controller._candidates
                local selectedIndex
                local bestPriority = 99

                for i, candidate in ipairs(candidates) do
                    if candidate then
                        local priority = getPriority(candidate)
                        if priority < bestPriority then
                            bestPriority = priority
                            selectedIndex = i
                        end
                    end
                end

                if not selectedIndex and candidates[1] then
                    selectedIndex = 1
                end

                if selectedIndex and featureRunning("AutoSelectBoost", id) then
                    local offerId = controller._offerId

                    pcall(function()
                        controller:_OnCardClicked(selectedIndex)
                    end)

                    local elapsed = 0
                    while featureRunning("AutoSelectBoost", id)
                        and controller._active
                        and controller._offerId == offerId
                        and elapsed < 10 do

                        task.wait(0.2)
                        elapsed += 0.2
                    end
                end
            end

            task.wait(0.15)
        end
    end)
end)

