    if not state then return end

    task.spawn(function()
        local controller

        local ok, err = pcall(function()
            controller = getKnit().GetController("ChestSelectionController")
        end)

        if not ok or not controller then
            warn("[Auto Chest] Controller gagal:", err)
            return
        end

        while featureRunning("AutoSelectChest", id) do
            if controller._active
                and controller._ready
