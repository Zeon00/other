addToggle("Auto TP NPC", false, function(state)
    _G.AutoTPNPC = state
    _G.AutoTPNPCRunId += 1

    local runId = _G.AutoTPNPCRunId

    if not state then
        setStatus("AUTO TP NPC OFF")
        return
    end

    task.spawn(function()
        while alive()
            and _G.AutoTPNPC
            and _G.AutoTPNPCRunId == runId
            and not _G.AutoFarmSnowZone do

            local map = getMap()
            local folder = map and map:FindFirstChild("NPCs")
            local character = player.Character
            local humanoid = character
                and character:FindFirstChildOfClass("Humanoid")

            local target
            local nearest = math.huge

            if folder and character and humanoid
                and humanoid.Health > 0 then

                local okRoot, characterPivot =
                    pcall(function()
                        return character:GetPivot()
                    end)

                if okRoot then
                    for _, mob in ipairs(folder:GetChildren()) do
                        if mob:IsA("Model") and mob.Parent then
                            local ok, mobPivot = pcall(function()
                                return mob:GetPivot()
                            end)

                            if ok and not isDead(mob) then
                                local distance =
                                    (mobPivot.Position
                                    - characterPivot.Position).Magnitude

                                if distance < nearest then
                                    nearest = distance
                                    target = mob
                                end
                            end
                        end
                    end
                end
            end

            if target and target.Parent and character.Parent then
                local ok, err = pcall(function()
                    local destination = target:GetPivot().Position
                        + Vector3.new(0, 4, 0)

                    character:PivotTo(CFrame.new(destination))
                end)

                if ok then
                    setStatus("TARGET: " .. target.Name,
                        Color3.fromRGB(125, 235, 155))
                else
                    warn("[Auto TP NPC]", err)
                end
            else
                setStatus("NPC NOT FOUND")
            end

            task.wait(0.5)
        end
    end)
end)

