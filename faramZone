-- SNOW FARM - ALL ROOM ZONES + 1 SECOND SCAN + LOOP
-- Boss Priority | Mob Farm | Entry Patrol
--========================================================

local ORBIT_RADIUS = 12
local ORBIT_HEIGHT = 12
local ORBIT_SPEED = 2
local ATTACK_INTERVAL = 0.1
local SKILL_INTERVAL = 0.05
local ZONE_WAIT_TIME = 1
local MOB_RANGE = 100

local Inputs = ReplicatedStorage
    :WaitForChild("Player")
    :WaitForChild("Remotes")
    :WaitForChild("Inputs")

local AttackRemote = Inputs:WaitForChild("Attack")
local SkillRemote = Inputs:WaitForChild("Skill")

local function getRoot()
    local character = player.Character
    if not character then return nil end
    return character:FindFirstChild("HumanoidRootPart")
        or character.PrimaryPart
end

local function getMap()
    for _, object in ipairs(Workspace:GetChildren()) do
        if object.Name:match("^Generated_Snow_%x+$")
            and object:FindFirstChild("NPCs") then
            return object
        end
    end
    return nil
end

local function getMobPart(model)
    if not model then return nil end
    if model:IsA("BasePart") then return model end
    if not model:IsA("Model") then return nil end

    for _, name in ipairs({
        "HumanoidRootPart", "UpperTorso", "Torso",
        "LowerTorso", "Head"
    }) do
        local part = model:FindFirstChild(name, true)
        if part and part:IsA("BasePart") then
            return part
        end
    end

    for _, obj in ipairs(model:GetDescendants()) do
        if obj:IsA("BasePart") then
            return obj
        end
    end

    return nil
end

local function isDead(model)
    if not model or not model.Parent then return true end

    local humanoid = model:IsA("Model")
        and (model:FindFirstChildOfClass("Humanoid")
        or model:FindFirstChildWhichIsA("Humanoid", true))

    if humanoid then
        return humanoid.Health <= 0
    end

    local state = model:GetAttribute("State")

    if state == nil and model:IsA("Model") then
        local value = model:FindFirstChild("State", true)
        if value and (
            value:IsA("StringValue")
            or value:IsA("BoolValue")
        ) then
            state = value.Value
        end
    end

    if type(state) == "string" then
        local value = string.lower(state)
        if value == "dead" or value == "died"
            or value == "destroyed"
            or value == "despawned" then
            return true
        end
    elseif type(state) == "boolean" and state then
        return true
    end

    local health = model:GetAttribute("Health")
    return type(health) == "number" and health <= 0
end

--========================================================
-- BOSS DETECTION
--========================================================

local function getBoss(map)
    local aliases = {
        "valksar", "valskar", "valkskar", "valkzar"
    }

    for _, folderName in ipairs({"NPCs", "Snow_NPC"}) do
        local folder = map:FindFirstChild(folderName)

        if folder then
            for _, obj in ipairs(folder:GetDescendants()) do
                if (obj:IsA("Model") or obj:IsA("BasePart"))
                    and not isDead(obj) then

                    local normalized =
                        string.lower(obj.Name):gsub("[^%w]", "")

                    for _, alias in ipairs(aliases) do
                        if normalized:find(alias, 1, true) then
                            local part = getMobPart(obj)
                            if part then
                                return {
                                    model = obj,
                                    part = part,
                                    isBoss = true
                                }
                            end
                        end
                    end
                end
            end
        end
    end

    return nil
end

--========================================================
-- NORMAL MOB DETECTION
--========================================================

local function getAllTargets(map)
    local targets = {}
    local seen = {}

    for _, folderName in ipairs({"NPCs", "Snow_NPC"}) do
        local folder = map:FindFirstChild(folderName)

        if folder then
            for _, model in ipairs(folder:GetDescendants()) do
                if model:IsA("Model")
                    and model.Parent
                    and not seen[model]
                    and not isDead(model) then

                    local nested = false
                    local ancestor = model.Parent

                    while ancestor and ancestor ~= folder do
                        if ancestor:IsA("Model") then
                            nested = true
                            break
                        end
                        ancestor = ancestor.Parent
                    end

                    if not nested then
                        local part = getMobPart(model)

                        if part then
                            seen[model] = true
                            table.insert(targets, {
                                model = model,
                                part = part
                            })
                        end
                    end
                end
            end
        end
    end

    return targets
end

local function getNearestMob(map, root)
    local nearest
    local nearestDistance = MOB_RANGE

    for _, data in ipairs(getAllTargets(map)) do
        local part = getMobPart(data.model)

        if part and part.Parent and not isDead(data.model) then
            local distance =
                (part.Position - root.Position).Magnitude

            if distance <= nearestDistance then
                nearestDistance = distance
                nearest = {
                    model = data.model,
                    part = part
                }
            end
        end
    end

    return nearest
end

--========================================================
-- ROOM ZONE DISCOVERY
-- Structure: Generated_Snow_xxx.Room_1.Zone
--========================================================

local function getAllRoomZones(map)
    local rooms = {}

    for _, room in ipairs(map:GetChildren()) do
        local roomNumber =
            tonumber(room.Name:match("^Room_(%d+)$"))

        if roomNumber then
            local zone = room:FindFirstChild("Zone")

            if zone then
                local locked = false
                local current = zone

                while current and current ~= map do
                    if string.lower(current.Name) == "locked" then
                        locked = true
                        break
                    end
                    current = current.Parent
                end

                if not locked then
                    table.insert(rooms, {
                        number = roomNumber,
                        room = room,
                        zone = zone
                    })
                end
            end
        end
    end

    table.sort(rooms, function(a, b)
        return a.number < b.number
    end)

    return rooms
end

local function getZoneCFrame(zone)
    if not zone then return nil end

    if zone:IsA("BasePart") then
        return zone.CFrame + Vector3.new(0, 4, 0)
    end

    if zone:IsA("Model") then
        local ok, cf = pcall(function()
            return zone:GetBoundingBox()
        end)

        if ok and cf then
            return cf + Vector3.new(0, 4, 0)
        end
    end

    local part = getMobPart(zone)
    if part then
        return part.CFrame + Vector3.new(0, 4, 0)
    end

    return nil
end

--========================================================
-- ENTRY WALLCAP DISCOVERY
--========================================================

local function getWallCaps(map)
    local rooms = {}

    for _, obj in ipairs(map:GetChildren()) do
        if obj:IsA("Model")
            and obj.Name:match("^WallCap_Side_Room_%d+$") then
            table.insert(rooms, obj)
        end
    end

    table.sort(rooms, function(a, b)
        return (tonumber(a.Name:match("(%d+)$")) or 0)
            < (tonumber(b.Name:match("(%d+)$")) or 0)
    end)

    return rooms
end

local function getRoomsWithEntry(map)
    local result = {}

    for _, wallCap in ipairs(getWallCaps(map)) do
        local number =
            tonumber(wallCap.Name:match("(%d+)$"))

        local connectors = wallCap:FindFirstChild("Connectors")
        local entry = connectors
            and connectors:FindFirstChild("Entry", true)

        if entry and number then
            local part = getMobPart(entry)
            local cf

            if part then
                cf = part.CFrame + Vector3.new(0, 4, 0)
            elseif entry:IsA("Model") then
                cf = entry:GetPivot() + Vector3.new(0, 4, 0)
            end

            if cf then
                table.insert(result, {
                    number = number,
                    wallCap = wallCap,
                    entryCFrame = cf
                })
            end
        end
    end

    return result
end

local function teleportTo(cframe)
    local character = player.Character
    if not character then return false end

    local ok, err = pcall(function()
        character:PivotTo(cframe)
    end)

    if not ok then
        warn("[Snow Farm TP]", err)
    end

    return ok
end

--========================================================
-- MAIN FARM LOOP
--========================================================

local function snowFarmLoop(runId)
    local currentModel
    local lockedY
    local angle = 0

    local lastAttack = 0
    local lastSkill = 0
    local skillNumber = 1

    local entryMap
    local patrolEntries = {}
    local patrolZones = {}

    local entryIndex = 1
    local zoneIndex = 1
    local patrolPhase = "ENTRY"

    local function running()
        return featureRunning("AutoFarmSnowZone", runId)
    end

    while running() do
        local map = getMap()
        local root = getRoot()

        if not map then
            setStatus("WAITING FOR SNOW MAP")
            task.wait(0.3)
            continue
        end

        if not root then
            setStatus("WAITING FOR CHARACTER")
            task.wait(0.2)
            continue
        end

        -- Refresh route when map changes.
        if entryMap ~= map then
            entryMap = map
            patrolEntries = getRoomsWithEntry(map)
            patrolZones = getAllRoomZones(map)
            entryIndex = 1
            zoneIndex = 1
            patrolPhase = "ENTRY"
        end

        -- Boss has priority anywhere in the map.
        local target = getBoss(map)

        -- Normal mobs: nearby targets only.
        if not target then
            target = getNearestMob(map, root)
        end

        --================================================
        -- NO TARGET: PATROL
        --================================================

        if not target then
            currentModel = nil
            lockedY = nil

            -- Refresh room data so newly spawned zones are included.
            patrolEntries = getRoomsWithEntry(map)
            patrolZones = getAllRoomZones(map)

            if patrolPhase == "ENTRY" and #patrolEntries > 0 then
                if entryIndex > #patrolEntries then
                    entryIndex = 1
                end

                local selected = patrolEntries[entryIndex]

                setStatus(
                    "TP ENTRY WALLCAP " .. tostring(selected.number)
                )

                teleportTo(selected.entryCFrame)
                task.wait(0.65)

                -- Entry -> all zones.
                zoneIndex = 1
                patrolPhase = "ZONE"

            elseif patrolPhase == "ZONE" and #patrolZones > 0 then
                if zoneIndex > #patrolZones then
                    -- All zones checked. Move to next entry.
                    patrolPhase = "ENTRY"
                    entryIndex += 1

                    if entryIndex > #patrolEntries then
                        entryIndex = 1
                    end

                    zoneIndex = 1
                    task.wait(0.1)
                else
                    local selected = patrolZones[zoneIndex]
                    local destination = getZoneCFrame(selected.zone)

                    if destination then
                        setStatus(
                            "CHECK ZONE ROOM " .. tostring(selected.number)
                            .. " (" .. tostring(zoneIndex)
                            .. "/" .. tostring(#patrolZones) .. ")"
                        )

                        teleportTo(destination)

                        -- Wait 1 second, checking for enemies during the wait.
                        local started = os.clock()

                        while running()
                            and os.clock() - started < ZONE_WAIT_TIME do

                            local currentRoot = getRoot()
                            local found

                            if currentRoot then
                                found = getBoss(map)
                                if not found then
                                    found = getNearestMob(map, currentRoot)
                                end
                            end

                            if found then
                                break
                            end

                            task.wait(0.1)
                        end

                        -- Check again before skipping this zone.
                        local currentRoot = getRoot()
                        local found

                        if currentRoot then
                            found = getBoss(map)
                            if not found then
                                found = getNearestMob(map, currentRoot)
                            end
                        end

                        if not found then
                            zoneIndex += 1
                        end
                    else
                        zoneIndex += 1
                    end
                end

            else
                setStatus("WAITING FOR ROOM ZONES / ENTRY")
                task.wait(0.5)
            end

            continue
        end

        --================================================
        -- ATTACK TARGET
        --================================================

        local part = getMobPart(target.model)

        if not part or not part.Parent or isDead(target.model) then
            currentModel = nil
            lockedY = nil
            task.wait(0.05)
            continue
        end

        local targetDistance =
            (part.Position - root.Position).Magnitude

        if currentModel ~= target.model then
            currentModel = target.model
            lockedY = part.Position.Y + ORBIT_HEIGHT
            angle = 0
        end

        setStatus(
            "ATTACKING: " .. target.model.Name
            .. " | " .. math.floor(targetDistance) .. " STUDS",
            Color3.fromRGB(125, 235, 155)
        )

        local dt = RunService.Heartbeat:Wait()
        if not running() then break end

        root = getRoot()
        part = getMobPart(target.model)

        if root and part and part.Parent and not isDead(target.model) then
            local pos = part.Position

            angle += ORBIT_SPEED * dt

            local destination = Vector3.new(
                pos.X + math.cos(angle) * ORBIT_RADIUS,
                lockedY or (pos.Y + ORBIT_HEIGHT),
                pos.Z + math.sin(angle) * ORBIT_RADIUS
            )

            root.CFrame = CFrame.lookAt(
                destination,
                Vector3.new(pos.X, destination.Y, pos.Z)
            )

            local now = os.clock()

            if now - lastAttack >= ATTACK_INTERVAL then
                pcall(function()
                    AttackRemote:FireServer(pos)
                end)
                lastAttack = now
            end

            if now - lastSkill >= SKILL_INTERVAL then
                pcall(function()
                    SkillRemote:FireServer(
                        skillNumber, "tap", pos, nil
                    )
                end)

                skillNumber = (skillNumber % 4) + 1
                lastSkill = now
            end
        else
            currentModel = nil
            lockedY = nil
            task.wait(0.05)
        end
    end
end

