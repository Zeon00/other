    if isMouse or isTouch then
        local delta = input.Position - dragStart
        local viewport = getViewport()

        local newX = startPosition.X.Offset + delta.X
        local newY = startPosition.Y.Offset + delta.Y

        local maxX = math.max(0, viewport.X - Main.AbsoluteSize.X)
        local maxY = math.max(0, viewport.Y - Main.AbsoluteSize.Y)

        Main.Position = UDim2.fromOffset(
            math.clamp(newX, 0, maxX),
            math.clamp(newY, 0, maxY)
        )
    end
end))

track(UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then

