    stopAntiVoid()
    EclipseRunId += 1
    ClaimRunId += 1
    EnchantRunId += 1

    releaseAllKeys()
    cleanupHover()

    for _, connection in ipairs(Connections) do
        pcall(function()
            connection:Disconnect()
        end)
    end

    table.clear(Connections)

    if Gui then
        pcall(function()
            Gui:Destroy()
        end)

        Gui = nil
    end

    if _G.AF_SwingSkillOrbitController == Controller then
        _G.AF_SwingSkillOrbitController = nil
    end
end

