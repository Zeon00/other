                task.wait(2)
                continue
            end

            status("Masuk dungeon! Anti Void aktif...")
            startAntiVoid(alive)
            task.wait(0.25)

            if not AutoOrbit then startOrbit() end
            if not AutoSkill then startSkill() end
            if not AutoCombat then startCombat() end

            if not waitForProgressComplete(alive, status, true) then
                break
            end

            if not alive() then break end

            -- Matikan rescue sebelum perpindahan normal ke FloorGlow.
            stopAntiVoid()
            status("Progress selesai! Mencari FloorGlow...")

            local glow = getDungeonObject(name, {
                "BossDoor",
                "FloorGlow"
            })

            if not glow then
                status("FloorGlow tidak ditemukan!")
                break
            end

            if not teleportObject(glow) then
                status("Teleport FloorGlow gagal!")
                break
            end

            status("Teleport FloorGlow berhasil!")
            task.wait(DUNGEON_AFTER_FLOOR)

            if not alive() then break end
            if not waitDungeonUnpaused(alive) then break end

            if not waitForEnemyClear(alive, status) then
                break
            end

            if not alive() then break end

            status("Menunggu Enemies kosong selama 2 detik...")

if not waitForEnemyClear(alive, status) then
    break
end

if not alive() then break end

            local exit = getDungeonObject(name, {
                "Markers",
                "BossExit"
            })

            if not exit then
                status("BossExit tidak ditemukan!")
                break
            end

            status("Teleport BossExit...")

            if not teleportObject(exit) then
                status("TP BossExit gagal!")
                break
            end

            restoreAfterExit()

            status("Dungeon selesai!")
            task.wait(1)
        end

        stopAntiVoid()
        RebirthPaused = false
        RebirthBusy = false

        if DungeonRunId == id then
            if not combatWasOn and AutoCombat then
                stopCombat()
            end

            if AutoOrbit then stopOrbit() end
            if AutoSkill then stopSkill() end

            AutoDungeon = false
            DungeonStatus = "Dungeon: OFF"
        end
    end)
end

--============================================================
-- AUTO ECLIPSE | DIRECT TP UMBRA
-- TP UMBRA -> ORBIT + SKILL -> LEAVE -> REPEAT
--============================================================

local function eclipseAlive(id)
    return Running and AutoEclipse and EclipseRunId == id
end

local function getCurrentEclipse()
    local attribute = Workspace:GetAttribute("EclipseDungeon")

    if not attribute then
        return nil, nil
    end

    local success, config = pcall(function()
        return DungeonConfig.get(attribute)
    end)

    if not success or not config or not config.Id then
        return nil, attribute
    end

    return config, attribute
end

local function findUmbra()
    local enemies = Workspace:FindFirstChild("Enemies")

    if not enemies then
        return nil
    end

    for _, mob in ipairs(enemies:GetChildren()) do
        if mob:IsA("Model")
            and mob.Name == "Umbra the Sun-Eater"
            and not isDead(mob) then

            return mob
        end
    end

    return nil
end

local function teleportToUmbra(mob)
    if not mob or not mob.Parent or isDead(mob) then
        return false
    end

    updateCharacter()

    if not Root then
        return false
    end

    local mobRoot = getMobRoot(mob)

    if not mobRoot then
        return false
    end

    return pcall(function()
        local destination = mobRoot.CFrame * CFrame.new(0, 0, 5)

        Root.CFrame = CFrame.lookAt(
            destination.Position,
            mobRoot.Position
        )
    end)
end

local function leaveEclipseDungeon()
    local enemies = Workspace:FindFirstChild("Enemies")

    -- Pastikan folder Enemies tersedia
    if not enemies then
        return false
    end

    -- Pastikan Umbra benar-benar sudah hilang
    if enemies:FindFirstChild("Umbra the Sun-Eater") then
        return false
    end

    local event = ReplicatedStorage
        :WaitForChild("SwordShared")
        :WaitForChild("Remotes")
        :WaitForChild("Request")

    local success, result = pcall(function()
        return event:InvokeServer("LeaveDungeon")
    end)

    return success, result
end

local function stopEclipse()
    AutoEclipse = false
    EclipseRunId += 1

    EclipseTarget = nil

    if AutoOrbit then
        stopOrbit()
    end

    if AutoSkill then
        stopSkill()
    end

    EclipseStatus = "Eclipse: OFF"
end

