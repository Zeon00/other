local function getDungeonProgress()
    local playerGui = Player:FindFirstChild("PlayerGui")
    local gameUI = playerGui and playerGui:FindFirstChild("GameUI")
    local dungeonBar = gameUI and gameUI:FindFirstChild("DungeonBar")
    local progress = dungeonBar and dungeonBar:FindFirstChild("Progress")
    local textFolder = progress and progress:FindFirstChild("Text")

    if not textFolder then
        return nil, nil, nil
    end

    local valueObject = textFolder:FindFirstChild("Value")
    local captionObject = textFolder:FindFirstChild("Caption")

    local rawText = valueObject and valueObject.Text or ""
    local caption = captionObject and captionObject.Text or ""

    local current, total = rawText:match("(%d+)%s*/%s*(%d+)")

    return tonumber(current), tonumber(total), caption
end

local function getRoamOuterMarkers()
    local markers = getDungeonObject(SelectedDungeon, {"Markers"})
    local result = {}

    if not markers then return result end

    for _, object in ipairs(markers:GetChildren()) do
        local number = object.Name:match("^Roam_Outer_(%d+)$")

        if number and getObjectCFrame(object) then
            table.insert(result, {
                object = object,
                index = tonumber(number)
            })
        end
    end

    table.sort(result, function(a, b)
        return a.index < b.index
    end)

    return result
end

local function waitForProgressComplete(isAlive, statusCallback, useBeacon)
    local function status(message)
        if statusCallback then statusCallback(message) end
    end

    local function bossOpen()
        local _, _, caption = getDungeonProgress()

        if caption then
            local value = string.lower(caption:match("^%s*(.-)%s*$"))
            return value == "open!" or value == "open"
        end

        return false
    end

    local emptyStart = nil
    local markerIndex = 1
    local retryAt = 0

    while isAlive() do
        if RebirthPaused then
            status("PAUSED | Menunggu Rebirth...")
            task.wait(0.1)
            continue
        end

        if bossOpen() then
            status("BOSS OPEN! Progress selesai!")
            return true
        end

        local enemyCount = getEnemyCount()

        if enemyCount > 0 then
            emptyStart = nil
            status("Enemies ditemukan: " .. enemyCount .. " | Combat berjalan...")
            task.wait(0.15)
            continue
        end

        emptyStart = emptyStart or os.clock()
        local emptyDuration = os.clock() - emptyStart

        if emptyDuration < MOB_EMPTY_CONFIRM_TIME then
            status("Enemies kosong | Konfirmasi " .. string.format("%.1f", emptyDuration) .. "/2 detik")
            task.wait(0.15)
            continue
        end

        if bossOpen() then
            status("BOSS OPEN! Progress selesai!")
            return true
        end

        local markers = getRoamOuterMarkers()

        if #markers == 0 then
            status("Roam_Outer tidak ditemukan di Dungeons." .. SelectedDungeon .. ".Markers")
            task.wait(1)
            continue
        end

        if markerIndex > #markers then
            markerIndex = 1
        end

        local entry = markers[markerIndex]
        local marker = entry.object

        if not marker or not marker.Parent then
            status("Marker hilang! Scan ulang...")
            task.wait(0.3)
            continue
        end

        if os.clock() < retryAt then
            task.wait(0.1)
            continue
        end

        updateCharacter()

        if not Root then
            task.wait(0.2)
            continue
        end

        local markerCF = getObjectCFrame(marker)

        if not markerCF then
            markerIndex += 1
            continue
        end

        local distance = (Root.Position - markerCF.Position).Magnitude

        if distance <= 8 then
            status("Roam Outer " .. entry.index .. " tercapai | Mencari spawn...")
            markerIndex += 1

            if markerIndex > #markers then
                markerIndex = 1
            end

            local waitStart = os.clock()

            while isAlive() and os.clock() - waitStart < 0.75 do
                if getEnemyCount() > 0 then break end
                if bossOpen() then return true end
                task.wait(0.1)
            end

            emptyStart = nil
            continue
        end

        status("Enemies kosong! Pathfinding Roam_Outer_" .. entry.index .. " | " .. math.floor(distance) .. " studs")

        local function canContinueRoaming()
            return isAlive()
                and getEnemyCount() == 0
                and not bossOpen()
        end

        local moved = moveDungeonPointer(
            marker,
            isAlive,
            status,
            canContinueRoaming
        )

        if not isAlive() then return false end

        if RebirthPaused then
            status("PAUSED | Rebirth berjalan...")

            while isAlive() and RebirthPaused do
                task.wait(0.1)
            end

            emptyStart = nil
            continue
        end

        if getEnemyCount() > 0 then
            status("Mob muncul saat roaming! Combat!")
            emptyStart = nil
            task.wait(0.1)
            continue
        end

        if bossOpen() then
            status("BOSS OPEN! Progress selesai!")
            return true
        end

        if moved then
            markerIndex += 1

            if markerIndex > #markers then
                markerIndex = 1
            end

            emptyStart = nil
        else
            retryAt = os.clock() + 0.5
            status("Roam Outer " .. entry.index .. " gagal | Retry...")
        end

        task.wait(0.1)
    end

    return false
end

