-- NORMAL DUNGEON
--============================================================

local function dungeonAlive(id)
    return Running and AutoDungeon and DungeonRunId == id
end

local function waitDungeonUnpaused(isAlive)
    while isAlive() and RebirthPaused do
        task.wait(0.1)
    end

    return isAlive()
end

local function waitDungeonStart(id)
    DungeonStatus = "Menunggu posisi 1..."

    while dungeonAlive(id) do
        if not waitDungeonUnpaused(function()
            return dungeonAlive(id)
        end) then
            return false
        end

        updateCharacter()

        if Root and (Root.Position - DUNGEON_START).Magnitude <= DUNGEON_TOLERANCE then
            return true
        end

        task.wait(DUNGEON_WAIT_DELAY)
    end

    return false
end

local function walkDungeonEntry(id)
    DungeonStatus = SelectedDungeon .. " | Jalan kaki ke posisi 2..."

    local lastOrder = 0

    while dungeonAlive(id) do
        if not waitDungeonUnpaused(function()
            return dungeonAlive(id)
        end) then
            return false
        end

        updateCharacter()

        if not Root or not Humanoid or Humanoid.Health <= 0 then
            return false
        end

        if (Root.Position - DUNGEON_ENTRY).Magnitude <= ENTRY_TOLERANCE then
            Humanoid:MoveTo(Root.Position)
            return true
        end

        if os.clock() - lastOrder >= 3 then
            Humanoid:MoveTo(DUNGEON_ENTRY)
            lastOrder = os.clock()
        end

        task.wait(0.1)
    end

    return false
end

local function stopDungeon()
    AutoDungeon = false
    RebirthPaused = false
    RebirthBusy = false
    DungeonRunId += 1
    stopAntiVoid()
    DungeonStatus = "Dungeon: OFF"
end

local function startDungeon()
    if not Running or AutoDungeon then return end

    if EclipsePriority then
        DungeonStatus = "Eclipse sedang prioritas!"
        return
    end

    local name = DungeonNameInput and DungeonNameInput.Text or "Z3"
    name = string.upper(string.match(name, "^%s*(.-)%s*$") or "")

    if name == "" then
        DungeonStatus = "Isi nama dungeon!"
        return
    end

    SelectedDungeon = name
    AutoDungeon = true
    DungeonRunId += 1

    local id = DungeonRunId
    local combatWasOn = AutoCombat
    local skillWasOn = AutoSkill
    local tpWasOn = AutoTP

    DungeonOwnsTP = not tpWasOn

    task.spawn(function()
        local function alive()
            return dungeonAlive(id)
        end

        local function status(message)
            DungeonStatus = name .. " | " .. message
        end

        local function restoreAfterExit()
            if not combatWasOn and AutoCombat then stopCombat() end
            if not skillWasOn and AutoSkill then stopSkill() end

            if DungeonOwnsTP and not tpWasOn and AutoTP then
                stopTP()
            end

            DungeonOwnsTP = false
        end

        while alive() do
            if not waitDungeonUnpaused(alive) then break end
            if not waitDungeonStart(id) then break end

            if not walkDungeonEntry(id) then
                if not alive() then break end
                continue
            end

            updateCharacter()

            if not Root
                or (Root.Position - DUNGEON_ENTRY).Magnitude > ENTRY_TOLERANCE then
                continue
            end

            status("Posisi 2 tercapai, tunggu 2 detik...")
            task.wait(DUNGEON_BEFORE_REMOTE)

            if not alive() then break end
            if not waitDungeonUnpaused(alive) then break end

            updateCharacter()

            if not Root
                or (Root.Position - DUNGEON_ENTRY).Magnitude > ENTRY_TOLERANCE then
                status("Posisi 2 berubah, ulangi...")
                continue
            end

            status("EnterDungeon...")

            local ok, result = pcall(function()
                local count = math.max(
                    1,
                    math.floor(tonumber(DungeonCountInput.Text) or 3)
                )

                return RequestRemote:InvokeServer("EnterDungeon", name, count)
            end)

            if not alive() then break end

            if not ok or result ~= true then
                status("EnterDungeon gagal: " .. tostring(result))
                task.wait(2)
                continue
            end

            status("Masuk dungeon! Anti Void aktif...")
            startAntiVoid(alive)
            task.wait(0.25)

            if not AutoTP then startTP() end
            if not AutoSkill then startSkill() end
            if not AutoCombat then startCombat() end

            if not waitForProgressComplete(alive, status, true) then
                break
            end

            if not alive() then break end

            stopAntiVoid()
            status("Progress selesai! Mencari FloorGlow...")

            local glow = getDungeonObject(name, {"BossDoor", "FloorGlow"})

            if not glow then
                status("FloorGlow tidak ditemukan!")
                break
            end

            if not teleportObject(glow) then
                status("Teleport FloorGlow gagal!")
                break
            end

            status("Teleport FloorGlow berhasil!")
            task.wait(DUNGEON_AFTER_FLOOR)

            if not alive() then break end
            if not waitDungeonUnpaused(alive) then break end
            if not waitForEnemyClear(alive, status) then break end
            if not alive() then break end

            status("Memastikan Enemies kosong...")

            if not waitForEnemyClear(alive, status) then break end
            if not alive() then break end

            local exit = getDungeonObject(name, {"Markers", "BossExit"})

            if not exit then
                status("BossExit tidak ditemukan!")
                break
            end

            status("Teleport BossExit...")

            if not teleportObject(exit) then
                status("TP BossExit gagal!")
                break
            end

            restoreAfterExit()

            status("Dungeon selesai!")
            task.wait(1)
        end

        stopAntiVoid()
        RebirthPaused = false
        RebirthBusy = false

        if DungeonRunId == id then
            if not combatWasOn and AutoCombat then stopCombat() end
            if not skillWasOn and AutoSkill then stopSkill() end

            if DungeonOwnsTP and not tpWasOn and AutoTP then
                stopTP()
            end

            DungeonOwnsTP = false
            AutoDungeon = false
            DungeonStatus = "Dungeon: OFF"
        end
    end)
end

