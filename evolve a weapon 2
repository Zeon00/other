local function getObjectCFrame(object)
    if not object then return nil end

    if object:IsA("BasePart") then
        return object.CFrame
    end

    if object:IsA("Model") then
        return object:GetPivot()
    end

    local part = object:FindFirstChildWhichIsA("BasePart", true)

    return part and part.CFrame or nil
end

local function teleportObject(object)
    local cf = getObjectCFrame(object)

    if not cf then return false end

    updateCharacter()

    if not Root then return false end

    return pcall(function()
        Root.CFrame = cf + Vector3.new(0, 3, 0)
    end)
end

local function teleportPosition(position)
    updateCharacter()

    if not Root then return false end

    return pcall(function()
        Root.CFrame = CFrame.new(position + Vector3.new(0, 3, 0))
    end)
end

local function getDungeonObject(name, path)
    local current = Workspace:FindFirstChild("Dungeons")

    if not current then return nil end

    current = current:FindFirstChild(name)

    if not current then return nil end

    for _, childName in ipairs(path) do
        current = current:FindFirstChild(childName)

        if not current then return nil end
    end

    return current
end

--============================================================
-- DUNGEON POINTER MOVEMENT | ROAM MARKER
-- MAX TP STEP 10 STUD | INTERRUPTIBLE
--============================================================

local DUNGEON_TP_STEP = 10
local DUNGEON_TP_DELAY = 0.08
local DUNGEON_PATH_RETRY = 3

local function moveDungeonPointer(object, isAlive, statusCallback, canMove)
    local function active()
        return isAlive()
            and not RebirthPaused
            and (not canMove or canMove())
    end

    if not object or not active() then
        return false
    end

    updateCharacter()

    if not Root or not Humanoid then
        return false
    end

    local targetCF = getObjectCFrame(object)
    if not targetCF then
        return false
    end

    local path = PathfindingService:CreatePath({
        AgentRadius = 2,
        AgentHeight = 5,
        AgentCanJump = true,
        AgentCanClimb = true,
        WaypointSpacing = 6
    })

    local success = false

    for attempt = 1, DUNGEON_PATH_RETRY do
        if not active() then return false end

        updateCharacter()
        if not Root then return false end

        local ok = pcall(function()
            path:ComputeAsync(
                Root.Position,
                targetCF.Position
            )
        end)

        if ok and path.Status == Enum.PathStatus.Success then
            success = true
            break
        end

        if statusCallback then
            statusCallback(
                "Pathfinding retry " .. attempt .. "/" .. DUNGEON_PATH_RETRY
            )
        end

        task.wait(0.25)
    end

    if not success then
        if statusCallback then
            statusCallback("Path gagal! Marker akan dicoba kembali.")
        end
        return false
    end

    local waypoints = path:GetWaypoints()

    for _, waypoint in ipairs(waypoints) do
        if not active() then return false end

        updateCharacter()

        if not Root or not Root.Parent then
            return false
        end

        if waypoint.Action == Enum.PathWaypointAction.Jump then
            Humanoid.Jump = true
        end

        local destination = waypoint.Position + Vector3.new(0, 3, 0)

        while active() do
            updateCharacter()

            if not Root or not Root.Parent then
                return false
            end

            local currentPosition = Root.Position
            local difference = destination - currentPosition
            local distance = difference.Magnitude

            if distance <= 1.5 then
                break
            end

            -- Maksimal 10 stud setiap perpindahan.
            local stepDistance = math.min(
                DUNGEON_TP_STEP,
                distance
            )

            local nextPosition =
                currentPosition + difference.Unit * stepDistance

            local moved = pcall(function()
                Root.CFrame = CFrame.new(nextPosition)
                Root.AssemblyLinearVelocity = Vector3.zero
                Root.AssemblyAngularVelocity = Vector3.zero
            end)

            if not moved then
                return false
            end

            task.wait(DUNGEON_TP_DELAY)
        end

        if not active() then
            return false
        end
    end

    return active()
end

--============================================================
-- ANTI VOID | NORMAL AUTO DUNGEON ONLY
-- Simpan posisi karakter setelah masuk dungeon; rescue jika jatuh.
--============================================================

local function stopAntiVoid()
    AntiVoidRunId += 1

    if AntiVoidConnection then
        pcall(function()
            AntiVoidConnection:Disconnect()
        end)
        AntiVoidConnection = nil
    end

    AntiVoidSafeCFrame = nil
    AntiVoidLastRescue = 0
end

local function startAntiVoid(isAlive)
    stopAntiVoid()

    local runId = AntiVoidRunId

    task.spawn(function()
        -- Beri server waktu memindahkan karakter ke dalam dungeon.
        local deadline = os.clock() + 6
        repeat
            if not isAlive() or AntiVoidRunId ~= runId then return end
            updateCharacter()
            if Root and Root.Parent then break end
            task.wait(0.1)
        until os.clock() >= deadline

        if not isAlive() or AntiVoidRunId ~= runId then return end
        updateCharacter()
        if not Root or not Root.Parent then return end

        AntiVoidSafeCFrame = Root.CFrame
        AntiVoidLastRescue = 0

        AntiVoidConnection = RunService.Heartbeat:Connect(function()
            if not isAlive() or AntiVoidRunId ~= runId then
                stopAntiVoid()
                return
            end

            updateCharacter()
            if not Root or not Root.Parent or not AntiVoidSafeCFrame then return end

            local safeY = AntiVoidSafeCFrame.Position.Y
            if Root.Position.Y < safeY - ANTI_VOID_FALL_DISTANCE
                and os.clock() - AntiVoidLastRescue >= ANTI_VOID_RESCUE_COOLDOWN then

                AntiVoidLastRescue = os.clock()
                pcall(function()
                    Root.CFrame = AntiVoidSafeCFrame + Vector3.new(0, 5, 0)
                    Root.AssemblyLinearVelocity = Vector3.zero
                    Root.AssemblyAngularVelocity = Vector3.zero
                end)
            end
        end)
    end)
end

--============================================================
-- ECLIPSE DUNGEON OBJECT FINDER
--============================================================

local function getEclipseDungeonObject(config, attribute, path)
    local names = {}

    local function addName(value)
        if value == nil then return end

        local name = tostring(value)

        if name ~= "" then
            for _, existing in ipairs(names) do
                if existing == name then
                    return
                end
            end

            table.insert(names, name)
        end
    end

    addName(config and config.Name)
    addName(config and config.Dungeon)
    addName(config and config.Id)
    addName(attribute)

    for _, name in ipairs(names) do
        local object = getDungeonObject(name, path)

        if object then
            return object
        end
    end

    -- Fallback: cari dungeon yang punya struktur BossDoor / Markers
    local folders = Workspace:FindFirstChild("Dungeons")

    if folders then
        for _, dungeon in ipairs(folders:GetChildren()) do
            local current = dungeon

            for _, childName in ipairs(path) do
                current = current and current:FindFirstChild(childName)
            end

            if current then
                return current
            end
        end
    end

    return nil
end

--============================================================
