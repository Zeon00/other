local function getTPTarget()
    if EclipseTarget then
        if EclipseTarget.Parent and not isDead(EclipseTarget) then
            return EclipseTarget
        end

        return nil
    end

    return getTarget()
end

local TP_BEHIND_DISTANCE = 5
local TP_REPATH_INTERVAL = 0.8
local TP_REPATH_DISTANCE = 7
local TP_ARRIVAL_DISTANCE = 3.5
local TP_STUCK_TIME = 1.5
local TP_MOVE_SPEED = 24

local TP_ACTIVE = false
local TP_ORIGINAL_WALKSPEED = nil
local TP_DODGE_PAUSED = false

local TP_LAST_GOAL = nil
local TP_CURRENT_PATH = nil
local TP_BLOCKED = false

local TP_VIM = game:GetService("VirtualInputManager")
local TP_PATH_SERVICE = PathfindingService

local function tpKeyW(state)
    pcall(function()
        TP_VIM:SendKeyEvent(state, Enum.KeyCode.W, false, game)
    end)
end

local function tpReleaseKeys()
    tpKeyW(false)
end

local function tpGetCharacter()
    local character = Player.Character
    if not character then return nil end

    local humanoid = character:FindFirstChildOfClass("Humanoid")
    local root = character:FindFirstChild("HumanoidRootPart")

    if not humanoid or not root then return nil end

    return character, humanoid, root
end

local function tpFaceDirection(direction)
    if direction.Magnitude < 0.05 then return end

    local camera = Workspace.CurrentCamera
    if not camera then return end

    local horizontal = Vector3.new(direction.X, 0, direction.Z)

    if horizontal.Magnitude < 0.05 then return end

    camera.CFrame = CFrame.lookAt(
        camera.CFrame.Position,
        camera.CFrame.Position + horizontal.Unit
    )
end

local function tpGetBehindPosition(mobRoot)
    local behind = mobRoot.Position
        - mobRoot.CFrame.LookVector * TP_BEHIND_DISTANCE

    return Vector3.new(
        behind.X,
        mobRoot.Position.Y,
        behind.Z
    )
end

local function tpComputePath(startPosition, goalPosition)
    local path = TP_PATH_SERVICE:CreatePath({
        AgentRadius = 2,
        AgentHeight = 5,
        AgentCanJump = true,
        AgentCanClimb = true,
        WaypointSpacing = 3
    })

    local success = pcall(function()
        path:ComputeAsync(startPosition, goalPosition)
    end)

    if not success or path.Status ~= Enum.PathStatus.Success then
        return nil
    end

    return path
end

local function tpStopMovement()
    tpReleaseKeys()

    local _, humanoid = tpGetCharacter()

    if humanoid then
        pcall(function()
            humanoid:Move(Vector3.zero, false)
        end)
    end
end

local function stopTP()
    TP_ACTIVE = false
    AutoTP = false
    TP_DODGE_PAUSED = false

    TPRunId += 1
    tpStopMovement()

    local _, humanoid = tpGetCharacter()

    if humanoid and TP_ORIGINAL_WALKSPEED then
        humanoid.WalkSpeed = TP_ORIGINAL_WALKSPEED
    end

    TP_ORIGINAL_WALKSPEED = nil
    TP_CURRENT_PATH = nil
    TP_LAST_GOAL = nil
end

local function startTP()
    if TP_ACTIVE then return end

    TP_ACTIVE = true
    AutoTP = true

    TPRunId += 1
    local thisRun = TPRunId

    task.spawn(function()
        local _, humanoid = tpGetCharacter()

        if not humanoid then
            TP_ACTIVE = false
            AutoTP = false
            return
        end

        TP_ORIGINAL_WALKSPEED = humanoid.WalkSpeed
        humanoid.WalkSpeed = TP_MOVE_SPEED
        humanoid.AutoRotate = true

        local currentWaypointIndex = 1
        local waypoints = {}
        local currentTarget
        local lastProgressPosition
        local lastProgressTime = os.clock()

        local function running()
            return Running
                and TP_ACTIVE
                and AutoTP
                and TPRunId == thisRun
        end

        local function getCurrentMob()
            local mob = getTPTarget()

            if not mob or not mob.Parent or isDead(mob) then
                return nil
            end

            local mobRoot = getMobRoot(mob)

            if not mobRoot then return nil end

            return mob, mobRoot
        end

        local function makeNewPath(mobRoot, root)
            local goal = tpGetBehindPosition(mobRoot)
            local path = tpComputePath(root.Position, goal)

            if not path then return false end

            TP_CURRENT_PATH = path
            TP_BLOCKED = false

            waypoints = path:GetWaypoints()
            currentWaypointIndex = math.min(2, #waypoints)

            TP_LAST_GOAL = goal
            lastProgressPosition = root.Position
            lastProgressTime = os.clock()

            path.Blocked:Connect(function(blockedIndex)
                if blockedIndex >= currentWaypointIndex then
                    TP_BLOCKED = true
                end
            end)

            return #waypoints > 0
        end

        while running() do
            local character, currentHumanoid, root = tpGetCharacter()

            if not character then
                task.wait(0.3)
                continue
            end

            if TP_DODGE_PAUSED then
                tpReleaseKeys()

                pcall(function()
                    currentHumanoid:Move(Vector3.zero, false)
                end)

                task.wait(0.035)
                continue
            end

            currentHumanoid.WalkSpeed = TP_MOVE_SPEED

            local mob, mobRoot = getCurrentMob()

            if not mob or not mobRoot then
                tpStopMovement()
                currentTarget = nil
                waypoints = {}
                task.wait(0.2)
                continue
            end

            if currentTarget and currentTarget ~= mob then
                local oldRoot = getMobRoot(currentTarget)

                if oldRoot and currentTarget.Parent and not isDead(currentTarget) then
                    mob = currentTarget
                    mobRoot = oldRoot
                else
                    currentTarget = mob
                    waypoints = {}
                end
            else
                currentTarget = mob
            end

            local goal = tpGetBehindPosition(mobRoot)

            local needRepath =
                #waypoints == 0
                or currentWaypointIndex > #waypoints
                or TP_BLOCKED
                or not TP_LAST_GOAL
                or (goal - TP_LAST_GOAL).Magnitude >= TP_REPATH_DISTANCE
                or (os.clock() - (TP_LAST_REPATH or 0)) >= TP_REPATH_INTERVAL

            if lastProgressPosition then
                if (root.Position - lastProgressPosition).Magnitude >= 0.6 then
                    lastProgressPosition = root.Position
                    lastProgressTime = os.clock()
                elseif os.clock() - lastProgressTime >= TP_STUCK_TIME then
                    needRepath = true
                    lastProgressPosition = root.Position
                    lastProgressTime = os.clock()
                end
            end

            if needRepath then
                tpReleaseKeys()

                if makeNewPath(mobRoot, root) then
                    TP_LAST_REPATH = os.clock()
                end
            end

            local waypoint = waypoints[currentWaypointIndex]

            if waypoint then
                local difference = waypoint.Position - root.Position
                local distance = difference.Magnitude

                if distance <= TP_ARRIVAL_DISTANCE then
                    tpReleaseKeys()
                    currentWaypointIndex += 1
                else
                    if waypoint.Action == Enum.PathWaypointAction.Jump then
                        currentHumanoid.Jump = true
                    end

                    tpFaceDirection(difference)
                    tpKeyW(true)
                end
            else
                tpReleaseKeys()
                task.wait(0.1)
            end

            task.wait(0.035)
        end

        tpStopMovement()

        local _, finalHumanoid = tpGetCharacter()

        if finalHumanoid and TP_ORIGINAL_WALKSPEED then
            finalHumanoid.WalkSpeed = TP_ORIGINAL_WALKSPEED
        end

        TP_ORIGINAL_WALKSPEED = nil
    end)
end

--============================================================
-- AUTO DODGE | RING + WEDGE FAN
--============================================================

local DODGE_CONFIG = {
    SCAN_INTERVAL = 0.03,
    FX_REFRESH_INTERVAL = 0.5,
    DODGE_COOLDOWN = 0.15,

    EXTRA_SAFE_DISTANCE = 5,
    WEDGE_SAFE_MARGIN = 5,
    TRIGGER_MARGIN = 2,

    WEDGE_SCAN_RANGE = 120,

    SEARCH_DISTANCES = {16, 22, 28, 36, 45, 55, 65},
    SEARCH_ANGLE_STEP = 15,

    FLOOR_CHECK_UP = 25,
    FLOOR_CHECK_DOWN = 65
}

local DodgeLastTime = 0
local DodgeCachedFX = {}
local DodgeLastFXRefresh = 0

local function dodgeAlive()
    updateCharacter()

    return Character
        and Root
        and Humanoid
        and Humanoid.Health > 0
end

local function dodgeHorizontalDistance(a, b)
    local dx = a.X - b.X
    local dz = a.Z - b.Z

    return math.sqrt(dx * dx + dz * dz)
end

local function getDodgeClientFX()
    if os.clock() - DodgeLastFXRefresh >= DODGE_CONFIG.FX_REFRESH_INTERVAL then
        DodgeLastFXRefresh = os.clock()
        DodgeCachedFX = {}

        for _, obj in ipairs(Workspace:GetDescendants()) do
            if obj.Name == "ClientFX" and obj:IsA("Folder") then
                table.insert(DodgeCachedFX, obj)
            end
        end
    end

    for i = #DodgeCachedFX, 1, -1 do
        if not DodgeCachedFX[i].Parent then
            table.remove(DodgeCachedFX, i)
        end
    end

    return DodgeCachedFX
end

local function getDodgeDangerObjects()
    local rings = {}
    local wedges = {}

    if not dodgeAlive() then
        return rings, wedges
    end

    local playerPosition = Root.Position

    for _, folder in ipairs(getDodgeClientFX()) do
        for _, obj in ipairs(folder:GetDescendants()) do

            -- RING
            if obj.Name == "Ring" and obj:IsA("BasePart") then
                if obj.Parent and obj.Transparency < 1 then
                    local radius = math.max(obj.Size.X, obj.Size.Z) / 2

                    if radius > 2 and radius < 100 then
                        if dodgeHorizontalDistance(
                            playerPosition,
                            obj.Position
                        ) <= DODGE_CONFIG.WEDGE_SCAN_RANGE then

                            table.insert(rings, {
                                Position = obj.Position,
                                RawRadius = radius,
                                Object = obj
                            })
                        end
                    end
                end
            end

            -- WEDGE / FAN
            if obj:IsA("WedgePart") and obj.Name == "Wedge" then
                if obj.Parent then
                    local distance = dodgeHorizontalDistance(
                        playerPosition,
                        obj.Position
                    )

                    local largestSize = math.max(
                        obj.Size.X,
                        obj.Size.Y,
                        obj.Size.Z
                    )

                    if distance <= DODGE_CONFIG.WEDGE_SCAN_RANGE
                        and largestSize > 0.2
                        and largestSize < 100 then

                        table.insert(wedges, {
                            CFrame = obj.CFrame,
                            Size = obj.Size,
                            Position = obj.Position,
                            Object = obj
                        })
                    end
                end
            end
        end
    end

    return rings, wedges
end

local function insideDodgeRing(position, ring, margin)
    return dodgeHorizontalDistance(
        position,
        ring.Position
    ) <= ring.RawRadius + margin
end

local function insideDodgeWedge(position, wedge, margin)
    local localPosition = wedge.CFrame:PointToObjectSpace(position)
    local half = wedge.Size / 2

    return math.abs(localPosition.X) <= half.X + margin
        and math.abs(localPosition.Y) <= half.Y + margin
        and math.abs(localPosition.Z) <= half.Z + margin
end

local function isDodgePositionSafe(position, rings, wedges)
    for _, ring in ipairs(rings) do
        if insideDodgeRing(
            position,
            ring,
            DODGE_CONFIG.EXTRA_SAFE_DISTANCE
        ) then
            return false
        end
    end

    for _, wedge in ipairs(wedges) do
        if insideDodgeWedge(
            position,
            wedge,
            DODGE_CONFIG.WEDGE_SAFE_MARGIN
        ) then
            return false
        end
    end

    return true
end

local function isDodgePlayerInDanger(rings, wedges)
    if not dodgeAlive() then return false end

    local position = Root.Position

    for _, ring in ipairs(rings) do
        if insideDodgeRing(
            position,
            ring,
            DODGE_CONFIG.TRIGGER_MARGIN
        ) then
            return true
        end
    end

    for _, wedge in ipairs(wedges) do
        if insideDodgeWedge(
            position,
            wedge,
            DODGE_CONFIG.TRIGGER_MARGIN
        ) then
            return true
        end
    end

    return false
end

local function getDodgeGroundPosition(position)
    if not dodgeAlive() then return nil end

    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = {Character}
    params.IgnoreWater = false

    local origin = position + Vector3.new(
        0,
        DODGE_CONFIG.FLOOR_CHECK_UP,
        0
    )

    local direction = Vector3.new(
        0,
        -DODGE_CONFIG.FLOOR_CHECK_DOWN,
        0
    )

    local result = Workspace:Raycast(
        origin,
        direction,
        params
    )

    if not result then return nil end
    if result.Material == Enum.Material.Water then return nil end
    if result.Normal.Y < 0.65 then return nil end

    local height = Humanoid.HipHeight + Root.Size.Y / 2 + 0.5

    return result.Position + Vector3.new(0, height, 0)
end

local function findDodgeSafePosition(rings, wedges)
    if not dodgeAlive() then return nil end

    local origin = Root.Position

    for _, distance in ipairs(DODGE_CONFIG.SEARCH_DISTANCES) do
        for angle = 0, 359, DODGE_CONFIG.SEARCH_ANGLE_STEP do
            local radians = math.rad(angle)

            local offset = Vector3.new(
                math.cos(radians) * distance,
                0,
                math.sin(radians) * distance
            )

            local candidate = origin + offset
            local ground = getDodgeGroundPosition(candidate)

            if ground and isDodgePositionSafe(ground, rings, wedges) then
                return ground
            end
        end
    end

    return nil
end

local function performDodge(rings, wedges)
    if not dodgeAlive() then return false end

    if os.clock() - DodgeLastTime < DODGE_CONFIG.DODGE_COOLDOWN then
        return false
    end

    if #rings == 0 and #wedges == 0 then
        return false
    end

    if not isDodgePlayerInDanger(rings, wedges) then
        return false
    end

    local safePosition = findDodgeSafePosition(rings, wedges)

    if not safePosition or not dodgeAlive() then
        return false
    end

    if not isDodgePositionSafe(safePosition, rings, wedges) then
        return false
    end

    DodgeLastTime = os.clock()

    local oldCFrame = Root.CFrame

    -- Pause TP Behind sementara agar tidak berebut posisi.
    local pauseTP = AutoTP and TP_ACTIVE

    if pauseTP then
        TP_DODGE_PAUSED = true
    end

    pcall(function()
        Root.CFrame = CFrame.new(safePosition) * (
            oldCFrame - oldCFrame.Position
        )

        Root.AssemblyLinearVelocity = Vector3.zero
        Root.AssemblyAngularVelocity = Vector3.zero
    end)

    if pauseTP then
        task.delay(0.25, function()
            if Running and AutoDodge and TP_ACTIVE then
                TP_DODGE_PAUSED = false
            end
        end)
    end

    DodgeStatus = "DODGE! | Ring: " .. #rings .. " Fan: " .. #wedges

    return true
end

