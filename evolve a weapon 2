--============================================================

local function readPlayerState(key)
    local ok, value = pcall(function()
        if type(PlayerState.get) == "function" then
            return PlayerState.get(key)
        end
        return nil
    end)
    if ok and value ~= nil then return value end

    local attr = Player:GetAttribute(key)
    if attr ~= nil then return attr end

    local leaderstats = Player:FindFirstChild("leaderstats")
    local stat = leaderstats and leaderstats:FindFirstChild(key)
    if stat and (stat:IsA("NumberValue") or stat:IsA("IntValue")) then
        return stat.Value
    end
    return nil
end

local function checkRebirthReady()
    if not ProgressionModule then
        return false, "Progression game tidak ditemukan; menunggu"
    end

    local rebirths = tonumber(readPlayerState("Rebirths"))
        or tonumber(Player:GetAttribute("Rebirths")) or 0
    local power = tonumber(readPlayerState("Power"))
    if power == nil then
        return false, "Data Power belum terbaca"
    end

    local okCost, cost = pcall(function()
        return ProgressionModule.rebirthCost(rebirths)
    end)
    if not okCost or tonumber(cost) == nil then
        return false, "Biaya Rebirth belum terbaca"
    end
    if power < tonumber(cost) then
        return false, "Power kurang: " .. tostring(math.floor(power)) .. " / " .. tostring(math.floor(cost))
    end

    local okNeed, needMet = pcall(function()
        local mastery = Mastery.of(Player)
        return ProgressionModule.rebirthNeedMet(
            rebirths,
            mastery,
            Player:GetAttribute("GateGrace")
        )
    end)
    if not okNeed then
        return false, "Syarat boss/dungeon belum bisa dicek"
    end
    if needMet ~= true then
        return false, "Menunggu syarat boss / star dungeon"
    end

    return true, "READY"
end

local function stopRebirth()
    AutoRebirth = false
    RebirthRunId += 1
    RebirthPaused = false
    RebirthBusy = false
    RebirthStatus = "Rebirth: OFF"
end

local function startRebirth()
    if not Running or AutoRebirth then return end
    AutoRebirth = true
    RebirthRunId += 1
    local runId = RebirthRunId

    task.spawn(function()
        while Running and AutoRebirth and RebirthRunId == runId do
            local ready, message = checkRebirthReady()
            if ready and not RebirthBusy then
                RebirthBusy = true
                RebirthPaused = true
                RebirthStatus = "Rebirth: READY | Menekan tombol..."

                local before = tonumber(readPlayerState("Rebirths")) or 0
                local requestOK, requestResult = pcall(function()
                    -- Sama dengan aksi tombol Rebirth di panel game.
                    return PlayerState.request("Rebirth")
                end)

                local confirmed = false
                local deadline = os.clock() + REBIRTH_CONFIRM_TIMEOUT
                repeat
                    local now = tonumber(readPlayerState("Rebirths")) or 0
                    if now > before then
                        confirmed = true
                        break
                    end
                    task.wait(0.1)
                until not Running or not AutoRebirth or RebirthRunId ~= runId or os.clock() >= deadline

                RebirthPaused = false
                RebirthBusy = false

                if confirmed then
                    RebirthStatus = "Rebirth sukses: " .. tostring(readPlayerState("Rebirths"))
                elseif not requestOK then
                    RebirthStatus = "Rebirth error: " .. tostring(requestResult)
                else
                    RebirthStatus = "Request terkirim, belum terkonfirmasi"
                end
                task.wait(1)
            else
                RebirthStatus = "Rebirth: " .. tostring(message)
                task.wait(REBIRTH_POLL_INTERVAL)
            end
        end

        if RebirthRunId == runId then
            RebirthBusy = false
            RebirthPaused = false
        end
    end)
end

