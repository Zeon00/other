local function getObjectCFrame(object)
    if not object then return nil end

    if object:IsA("BasePart") then
        return object.CFrame
    end

    if object:IsA("Model") then
        return object:GetPivot()
    end

    local part = object:FindFirstChildWhichIsA("BasePart", true)

    return part and part.CFrame or nil
end

local function teleportObject(object)
    local cf = getObjectCFrame(object)

    if not cf then return false end

    updateCharacter()
    if not Root then return false end

    return pcall(function()
        Root.CFrame = cf + Vector3.new(0, 3, 0)
    end)
end

local function teleportPosition(position)
    updateCharacter()
    if not Root then return false end

    return pcall(function()
        Root.CFrame = CFrame.new(position + Vector3.new(0, 3, 0))
    end)
end

local function getDungeonObject(name, path)
    local current = Workspace:FindFirstChild("Dungeons")

    if not current then return nil end

    current = current:FindFirstChild(name)

    if not current then return nil end

    for _, childName in ipairs(path) do
        current = current:FindFirstChild(childName)

        if not current then return nil end
    end

    return current
end

--============================================================
-- DUNGEON POINTER MOVEMENT
--============================================================

local DUNGEON_TP_STEP = 3
local DUNGEON_TP_DELAY = 0.12
local DUNGEON_PATH_RETRY = 3

local function moveDungeonPointer(object, isAlive, statusCallback, canMove)
    local function active()
        return isAlive()
            and not RebirthPaused
            and (not canMove or canMove())
    end

    if not object or not active() then return false end

    updateCharacter()

    if not Root or not Humanoid then return false end

    local targetCF = getObjectCFrame(object)
    if not targetCF then return false end

    if (Root.Position - targetCF.Position).Magnitude <= 4 then
        return true
    end

    local path = PathfindingService:CreatePath({
        AgentRadius = 2,
        AgentHeight = 5,
        AgentCanJump = true,
        AgentCanClimb = true,
        WaypointSpacing = 6
    })

    local success = false

    for attempt = 1, DUNGEON_PATH_RETRY do
        if not active() then return false end

        updateCharacter()
        if not Root then return false end

        local ok = pcall(function()
            path:ComputeAsync(Root.Position, targetCF.Position)
        end)

        if ok and path.Status == Enum.PathStatus.Success then
            success = true
            break
        end

        if statusCallback then
            statusCallback("Pathfinding retry " .. attempt .. "/" .. DUNGEON_PATH_RETRY)
        end

        task.wait(0.25)
    end

    if not success then return false end

    for _, waypoint in ipairs(path:GetWaypoints()) do
        if not active() then return false end

        updateCharacter()

        if not Root or not Root.Parent then return false end

        if waypoint.Action == Enum.PathWaypointAction.Jump then
            Humanoid.Jump = true
        end

        local destination = waypoint.Position + Vector3.new(0, 3, 0)

        while active() do
            updateCharacter()

            if not Root or not Root.Parent then return false end

            local difference = destination - Root.Position
            local distance = difference.Magnitude

            if distance <= 1.5 then break end

            local stepDistance = math.min(DUNGEON_TP_STEP, distance)
            local nextPosition = Root.Position + difference.Unit * stepDistance

            local moved = pcall(function()
                Root.CFrame = CFrame.new(nextPosition)
                Root.AssemblyLinearVelocity = Vector3.zero
                Root.AssemblyAngularVelocity = Vector3.zero
            end)

            if not moved then return false end

            task.wait(DUNGEON_TP_DELAY)
        end

        if not active() then return false end
    end

    return active()
end

