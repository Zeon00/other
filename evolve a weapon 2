        end

        local function waitDungeonExit()
            status("Menunggu keluar dungeon...")

            while alive() do
                if not Player:GetAttribute("Dungeon") then return true end
                task.wait(0.25)
            end

            return false
        end

        local function waitUmbra()
            status("Menunggu Umbra the Sun-Eater...")

            while alive() do
                if not Player:GetAttribute("Dungeon") then return nil end

                local mob = findUmbra()
                if mob then return mob end

                task.wait(0.2)
            end

            return nil
        end

        while alive() do
            local config, attribute = getCurrentEclipse()

            if Player:GetAttribute("Dungeon") then
                if config then
                    status("ECLIPSE TERSEDIA! Menghentikan dungeon...")

                    ResumeDungeonAfterEclipse = AutoDungeon
                    EclipsePriority = true

                    if AutoDungeon then stopDungeon() end

                    status("Memanggil LeaveDungeon...")

                    local leaveOK, leaveResult = pcall(function()
                        return RequestRemote:InvokeServer("LeaveDungeon")
                    end)

                    if not leaveOK then
                        status("Leave dungeon error: " .. tostring(leaveResult))
                        EclipsePriority = false

                        if ResumeDungeonAfterEclipse and alive() then
                            ResumeDungeonAfterEclipse = false
                            task.wait(1)
                            startDungeon()
                        end

                        task.wait(3)
                        continue
                    end

                    local leaveDeadline = os.clock() + 20

                    while alive()
                        and Player:GetAttribute("Dungeon")
                        and os.clock() < leaveDeadline do

                        task.wait(0.2)
                    end

                    if not alive() then break end

                    if Player:GetAttribute("Dungeon") then
                        status("Leave belum berhasil! Mencoba lagi...")
                        EclipsePriority = false

                        if ResumeDungeonAfterEclipse then
                            ResumeDungeonAfterEclipse = false
                            task.wait(1)
                            startDungeon()
                        end

                        task.wait(3)
                        continue
                    end

                    status("Berhasil keluar! OTW Eclipse...")
                else
                    status("Masih di dungeon, menunggu Eclipse...")
                    task.wait(0.5)
                    continue
                end
            end

            if not config then
                status("Menunggu EclipseDungeon...")
                task.wait(1)
                continue
            end

            status("Eclipse ditemukan: " .. tostring(attribute))
            task.wait(0.5)

            if not alive() then break end
            if Player:GetAttribute("Dungeon") then continue end

            status("Memanggil EclipseEnter...")

            local ok, result = pcall(function()
                return PlayerState.request("EclipseEnter", config.Id)
            end)

            if not alive() then break end

            if not ok then
                status("Enter error: " .. tostring(result))
                task.wait(3)
                continue
            end

            status("Request terkirim: " .. tostring(result))

            if not waitDungeonEntry() then break end
            if not alive() then break end

            status("Berhasil masuk! Mencari Umbra...")

            local umbra = waitUmbra()

            if not alive() then break end

            if not umbra then
                status("Umbra tidak ditemukan / dungeon berakhir.")
                waitDungeonExit()
                task.wait(1)
                continue
            end

            EclipseTarget = umbra
            CurrentDungeonTarget = umbra

            status("Umbra ditemukan! TP langsung...")

            if not teleportToUmbra(umbra) then
                status("TP Umbra gagal, mencoba ulang...")

                for _ = 1, 10 do
                    if not alive() or isDead(umbra) then break end
                    if teleportToUmbra(umbra) then break end
                    task.wait(0.3)
                end
            end

            if not alive() then break end

            status("Mengaktifkan TP Behind + Skill...")

            if not AutoTP then startTP() end
            if not AutoSkill then startSkill() end

            status("TP Behind + Skill sampai Umbra mati...")

            while alive() and umbra.Parent and not isDead(umbra) do
                task.wait(0.2)
            end

            if not alive() then break end

            status("Umbra hilang! Menghentikan worker...")

            EclipseTarget = nil
            CurrentDungeonTarget = nil

            if EclipseOwnsTP and not tpWasOn and AutoTP then
                stopTP()
            end

            if not skillWasOn and AutoSkill then
                stopSkill()
            end

            status("Memastikan Umbra sudah hilang...")

            while alive() do
                local enemies = Workspace:FindFirstChild("Enemies")
                local umbraStillExists = enemies
                    and enemies:FindFirstChild("Umbra the Sun-Eater")

                if not umbraStillExists then break end

                task.wait(0.2)
            end

            if not alive() then break end

            status("Umbra sudah hilang! Memanggil LeaveDungeon...")

            local success, leaveResult = leaveEclipseDungeon()

            if success then
                status("LeaveDungeon dipanggil: " .. tostring(leaveResult))
            else
                status("LeaveDungeon gagal: " .. tostring(leaveResult))
            end

            while alive() and Player:GetAttribute("Dungeon") do
                task.wait(0.25)
            end

            if not alive() then break end

            status("Berhasil keluar dari Eclipse!")
            EclipsePriority = false

            if ResumeDungeonAfterEclipse and alive() and not AutoDungeon then
                ResumeDungeonAfterEclipse = false
                status("Melanjutkan Auto Dungeon...")
                task.wait(1)
                startDungeon()
            else
                ResumeDungeonAfterEclipse = false
            end

            task.wait(2)
        end

        if EclipseRunId == id then
            EclipseTarget = nil
            CurrentDungeonTarget = nil

            if EclipseOwnsTP and not tpWasOn and AutoTP then
                stopTP()
            end

            if not skillWasOn and AutoSkill then
                stopSkill()
            end

            EclipseOwnsTP = false
            AutoEclipse = false
            EclipseStatus = "Eclipse: OFF"
        end
    end)
end

