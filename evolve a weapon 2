function Controller.Cleanup()
    if not Running then return end

    Running = false

    AutoCombat = false
    AutoSkill = false
    AutoTP = false
    AutoDungeon = false
    AutoEclipse = false
    AutoClaim = false
    AutoEnchant = false
    AutoRebirth = false
    AutoDodge = false

    TP_DODGE_PAUSED = false

    RebirthPaused = false
    RebirthBusy = false

    EclipseTarget = nil
    CurrentDungeonTarget = nil

    RebirthRunId += 1
    TPRunId += 1
    DungeonRunId += 1
    EclipseRunId += 1
    ClaimRunId += 1
    EnchantRunId += 1

    TP_ACTIVE = false

    stopAntiVoid()
    releaseAllKeys()
    tpStopMovement()

    local _, finalHumanoid = tpGetCharacter()

    if finalHumanoid and TP_ORIGINAL_WALKSPEED then
        finalHumanoid.WalkSpeed = TP_ORIGINAL_WALKSPEED
    end

    TP_ORIGINAL_WALKSPEED = nil

    DungeonOwnsTP = false
    EclipseOwnsTP = false

    for _, connection in ipairs(Connections) do
        pcall(function()
            connection:Disconnect()
        end)
    end

    table.clear(Connections)

    if Gui then
        pcall(function()
            Gui:Destroy()
        end)

        Gui = nil
    end

    if _G.AF_SwingSkillOrbitController == Controller then
        _G.AF_SwingSkillOrbitController = nil
    end
end

