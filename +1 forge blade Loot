--========================================================

-- CHARACTER

--========================================================



local function getCharacter()

    local character = LocalPlayer.Character

    if not character then return end



    local humanoid = character:FindFirstChildOfClass("Humanoid")

    local root = character:FindFirstChild("HumanoidRootPart")



    if not humanoid or not root or humanoid.Health <= 0 then

        return

    end



    return character, root, humanoid

end



--========================================================

-- AUTO HIT - RESPAWN FIX

--========================================================



local function enableAutoHit()

    if not alive() or not States.Hit then return end



    local controller = getCombatController()

    if not controller then

        warn("[AUTO HIT] CombatController not found")

        return

    end



    if not alive() or not States.Hit then return end



    pcall(function()

        controller:SetAutoClick(true)

    end)

end



local function reenableAutoHitAfterRespawn()

    task.spawn(function()

        -- Wait until the new character is ready
        local character = LocalPlayer.Character

        if not character then return end



        local humanoid = character:WaitForChild("Humanoid", 10)

        local root = character:WaitForChild("HumanoidRootPart", 10)



        if not humanoid or not root then return end

        if not alive() or not States.Hit then return end



        task.wait(0.5)



        if not alive() or not States.Hit then return end



        local controller = getCombatController()

        if not controller then return end



        if not alive() or not States.Hit then return end



        -- Force refresh AutoClick state after respawn
        pcall(function()

            controller:SetAutoClick(false)

        end)



        task.wait(0.15)



        if not alive() or not States.Hit then return end



        pcall(function()

            controller:SetAutoClick(true)

        end)



        print("[AUTO HIT] Re-enabled after respawn")

    end)

end



local CharacterAddedConnection =

    LocalPlayer.CharacterAdded:Connect(function()

        if States.Hit then

            reenableAutoHitAfterRespawn()

        end

    end)



--========================================================

-- MOB SCAN FOR ORBIT

--========================================================



local function getMobRoot(mob)

    if not mob or not mob.Parent then

        return nil

    end



    local root = mob:FindFirstChild("HumanoidRootPart")



    if root and root:IsA("BasePart") then

        return root

    end



    if mob:IsA("Model") then

        return mob.PrimaryPart

            or mob:FindFirstChildWhichIsA("BasePart", true)

    end



    return nil

end



local function isMobAlive(mob)

    if not mob or not mob.Parent then

        return false

    end



    local root = getMobRoot(mob)

    if not root then return false end



    local humanoid = mob:FindFirstChildOfClass("Humanoid")



    if humanoid and humanoid.Health <= 0 then

        return false

    end



    return true

end



local function getNearestMob()

    local _, playerRoot = getCharacter()

    if not playerRoot then return nil end



    local nearest

    local nearestDistance = math.huge



    for _, mob in ipairs(LiveFolder:GetChildren()) do

        if isMobAlive(mob) then

            local root = getMobRoot(mob)



            if root then

                local distance = (root.Position - playerRoot.Position).Magnitude



                if distance < nearestDistance then

                    nearestDistance = distance

                    nearest = mob

                end

            end

        end

    end



    return nearest

end



