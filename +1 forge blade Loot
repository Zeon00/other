-- AUTO SKILL KEY Q / R (0.5 SECOND INTERVAL)

local function tapSkillKey(keyCode)
    if not alive() or not States.SkillKeys then return false end

    local ok = pcall(function()
        VirtualInputManager:SendKeyEvent(true, keyCode, false, game)
    end)
    if not ok then
        warn("[AUTO SKILL] VirtualInputManager key press failed")
        return false
    end

    task.wait(0.05)
    pcall(function()
        VirtualInputManager:SendKeyEvent(false, keyCode, false, game)
    end)
    return true
end

SkillKeysButton.MouseButton1Click:Connect(function()
    if not alive() then return end
    States.SkillKeys = not States.SkillKeys
    refreshSkillKeys()

    if States.SkillKeys then
        task.spawn(function()
            while alive() and States.SkillKeys do
                if not tapSkillKey(Enum.KeyCode.Q) then
                    States.SkillKeys = false
                    refreshSkillKeys()
                    break
                end
                task.wait(0.5)
                if not alive() or not States.SkillKeys then break end

                if not tapSkillKey(Enum.KeyCode.R) then
                    States.SkillKeys = false
                    refreshSkillKeys()
                    break
                end
                task.wait(0.5)
            end

            pcall(function()
                VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.Q, false, game)
                VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.R, false, game)
            end)
        end)
    end
end)

