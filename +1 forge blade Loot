-- AUTO ORBIT

--========================================================



OrbitButton.MouseButton1Click:Connect(function()

    if not alive() then return end



    States.Orbit = not States.Orbit

    refreshOrbit()



    if States.Orbit then

        task.spawn(function()

            local angle = 0

            local currentTarget = nil



            while alive() and States.Orbit do

                local _, playerRoot = getCharacter()



                if not playerRoot then

                    task.wait(0.15)

                    continue

                end



                -- Keep the same target until dead or removed
                if not isMobAlive(currentTarget) then

                    currentTarget = nil

                end



                if not currentTarget then

                    currentTarget = getNearestMob()

                end



                local targetRoot = getMobRoot(currentTarget)



                if targetRoot then

                    local dt = RunService.Heartbeat:Wait()

                    angle = (angle + ORBIT_SPEED * dt) % (math.pi * 2)



                    -- Orbit around target at locked target Y + height
                    local targetPosition = targetRoot.Position



                    local orbitPosition = targetPosition + Vector3.new(

                        math.cos(angle) * ORBIT_RADIUS,

                        ORBIT_HEIGHT,

                        math.sin(angle) * ORBIT_RADIUS

                    )



                    if alive() and States.Orbit then

                        playerRoot.CFrame = CFrame.lookAt(

                            orbitPosition,

                            targetPosition

                        )

                    end

                else

                    task.wait(0.1)

                end

            end

        end)

    end

end)



