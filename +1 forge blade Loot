local SwingButton, refreshSwing = createToggle("SwingPower", "AUTO SWING POWER", 2)
local PickupButton, refreshPickup = createToggle("Pickup", "AUTO PICKUP", 3)
local RebirthButton, refreshRebirth = createToggle("Rebirth", "AUTO REBIRTH", 4)

--========================================================
-- AUTO HIT
--========================================================

HitButton.MouseButton1Click:Connect(function()
    if not alive() then return end

    States.Hit = not States.Hit

    if States.Hit then
        pcall(function()
            CombatController = CombatController or Knit.GetController("CombatController")
            CombatController:SetAutoClick(true)
        end)
    else
        pcall(function()
            if CombatController then
                CombatController:SetAutoClick(false)
            end
        end)
    end

    refreshHit()
end)

