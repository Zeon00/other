end)

--========================================================
-- TOGGLE STATES
--========================================================

local States = {
    Hit = false,
    SwingPower = false,
    Pickup = false,
    Rebirth = false
}

local function stopAll()
    for key in pairs(States) do
        States[key] = false
    end

    pcall(function()
        if CombatController then
            CombatController:SetAutoClick(false)
        end
    end)

    pcall(function()
        LocalPlayer:SetAttribute("AutoCollect", false)
    end)
end

