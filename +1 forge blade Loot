local function createToggle(key, label, order)
    local Button = Instance.new("TextButton")
    Button.Name = key
    Button.Size = UDim2.new(1, 0, 0, 43)
    Button.BackgroundColor3 = Color3.fromRGB(48, 39, 65)
    Button.BorderSizePixel = 0
    Button.Text = label .. " : OFF"
    Button.TextColor3 = Color3.fromRGB(245, 240, 255)
    Button.TextSize = 13
    Button.Font = Enum.Font.GothamBold
    Button.LayoutOrder = order
    Button.Parent = Container

    Instance.new("UICorner", Button).CornerRadius = UDim.new(0, 7)

    local function refresh()
        local enabled = States[key]
        Button.Text = label .. (enabled and " : ON" or " : OFF")
        Button.BackgroundColor3 = enabled
            and Color3.fromRGB(95, 55, 155)
            or Color3.fromRGB(48, 39, 65)
    end

    return Button, refresh
end

